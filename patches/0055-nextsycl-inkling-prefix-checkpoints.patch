index 0000000..4613f28
--- /dev/null
+++ b/llm/inkling2/src/engine/checkpoint.rs
@@ -0,0 +1,218 @@
+//! A KV checkpoint stores immutable intervals in host memory. Appending to a session
+//! can share the previous checkpoint's surviving intervals. Each interval holds all
+//! heads, packed by head. The on-disk representation remains one flat array per cache.
+use super::*;
+use std::io::{self, Write};
+use std::sync::Weak;
+
+#[derive(Clone)]
+struct Band {
+    from: usize,
+    end: usize,
+    data: Arc<Vec<u8>>,
+}
+
+pub(super) struct RingImage {
+    heads: usize,
+    row: usize,
+    from: usize,
+    end: usize,
+    bands: Vec<Band>,
+}
+
+pub(super) enum BufferImage {
+    Bytes(Vec<u8>),
+    Ring(RingImage),
+}
+
+impl BufferImage {
+    pub(super) fn len(&self) -> usize {
+        match self {
+            Self::Bytes(b) => b.len(),
+            Self::Ring(r) => r.heads * (r.end - r.from) * r.row,
+        }
+    }
+
+    // A sliding window can retain part of an interval. Charge the full allocation to
+    // this checkpoint. Shared intervals in two entries are charged to each entry.
+    pub(super) fn held(&self) -> usize {
+        match self {
+            Self::Bytes(b) => b.len(),
+            Self::Ring(r) => r.bands.iter().map(|b| b.data.len()).sum(),
+        }
+    }
+
+    pub(super) fn bytes(&self) -> Result<&[u8]> {
+        match self {
+            Self::Bytes(b) => Ok(b),
+            Self::Ring(_) => Err(e("expected a flat checkpoint buffer")),
+        }
+    }
+
+    fn head<E>(
+        &self,
+        h: usize,
+        heads: usize,
+        row: usize,
+        from: usize,
+        end: usize,
+        mut visit: impl FnMut(usize, &[u8]) -> std::result::Result<(), E>,
+    ) -> std::result::Result<(), E> {
+        match self {
+            Self::Bytes(b) => {
+                let n = (end - from) * row;
+                visit(from, &b[h * n..(h + 1) * n])
+            }
+            Self::Ring(r) => {
+                debug_assert_eq!((r.heads, r.row, r.from, r.end), (heads, row, from, end));
+                for band in &r.bands {
+                    let lo = from.max(band.from);
+                    let hi = end.min(band.end);
+                    if lo < hi {
+                        let at = (h * (band.end - band.from) + lo - band.from) * row;
+                        visit(lo, &band.data[at..at + (hi - lo) * row])?;
+                    }
+                }
+                Ok(())
+            }
+        }
+    }
+
+    pub(super) fn write_to(&self, w: &mut dyn Write) -> io::Result<()> {
+        match self {
+            Self::Bytes(b) => w.write_all(b),
+            Self::Ring(r) => {
+                for h in 0..r.heads {
+                    self.head(h, r.heads, r.row, r.from, r.end, |_, b| w.write_all(b))?;
+                }
+                Ok(())
+            }
+        }
+    }
+}
+
+pub(super) type Anchor = (usize, Weak<Vec<BufferImage>>);
+
+pub(super) fn save_ring(
+    buf: &DevBuf,
+    cap: usize,
+    heads: usize,
+    row: usize,
+    from: usize,
+    end: usize,
+    previous: Option<&BufferImage>,
+) -> Result<BufferImage> {
+    let mut bands = Vec::new();
+    let mut start = from;
+    if let Some(BufferImage::Ring(r)) = previous {
+        if r.heads == heads && r.row == row && r.from <= from && r.end >= from && r.end <= end {
+            bands.extend(r.bands.iter().filter(|b| b.end > from).cloned());
+            start = r.end;
+        }
+    }
+    if start < end {
+        let n = end - start;
+        let mut data = vec![0u8; heads * n * row];
+        for h in 0..heads {
+            let mut p = start;
+            while p < end {
+                let slot = p % cap;
+                let count = (end - p).min(cap - slot);
+                let off = (h * n + p - start) * row;
+                buf.read((h * cap + slot) * row, &mut data[off..off + count * row])?;
+                p += count;
+            }
+        }
+        bands.push(Band {
+            from: start,
+            end,
+            data: Arc::new(data),
+        });
+    }
+    Ok(BufferImage::Ring(RingImage {
+        heads,
+        row,
+        from,
+        end,
+        bands,
+    }))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn restore_ring(
+    buf: &DevBuf,
+    cap: usize,
+    heads: usize,
+    row: usize,
+    from: usize,
+    end: usize,
+    b: &BufferImage,
+    resident: bool,
+) -> Result<()> {
+    if b.len() != heads * (end - from) * row {
+        return Err(e("a checkpoint of another shape"));
+    }
+    if let BufferImage::Ring(r) = b {
+        if (r.heads, r.row, r.from, r.end) != (heads, row, from, end) {
+            return Err(e("a checkpoint of another shape"));
+        }
+    }
+    if !resident {
+        for h in 0..heads {
+            b.head(h, heads, row, from, end, |mut p, mut data| -> Result<()> {
+                while !data.is_empty() {
+                    let slot = p % cap;
+                    let n = (data.len() / row).min(cap - slot);
+                    buf.write((h * cap + slot) * row, &data[..n * row])?;
+                    data = &data[n * row..];
+                    p += n;
+                }
+                Ok(())
+            })?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn partially_shared_intervals_keep_the_flat_checkpoint_format() {
+        let band = |from: usize, end: usize| {
+            let bytes = (0..2)
+                .flat_map(|h| (from..end).map(move |p| (16 * h + p) as u8))
+                .collect();
+            Band {
+                from,
+                end,
+                data: Arc::new(bytes),
+            }
+        };
+        let image = BufferImage::Ring(RingImage {
+            heads: 2,
+            row: 1,
+            from: 3,
+            end: 8,
+            bands: vec![band(0, 6), band(6, 8)],
+        });
+        assert_eq!(image.len(), 10);
+        assert_eq!(image.held(), 16);
+        let ck = Checkpoint {
+            pos: 8,
+            bytes: image.held(),
+            bufs: Arc::new(vec![image]),
+        };
+        let mut file = Vec::new();
+        ck.write_to(&mut file).unwrap();
+        let loaded = Checkpoint::read_from(&mut file.as_slice()).unwrap();
+        assert_eq!(
+            loaded.bufs[0].bytes().unwrap(),
+            &[3, 4, 5, 6, 7, 19, 20, 21, 22, 23]
+        );
+        let mut again = Vec::new();
+        loaded.write_to(&mut again).unwrap();
+        assert_eq!(file, again);
+    }
+}
