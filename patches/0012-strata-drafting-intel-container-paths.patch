+def _host_path(value: str) -> Path:
+    """A path the engine's arguments name, as this computer sees it.  The Intel engine runs in a container whose /work is the data root
+    the launcher mounts there (sycl/serve/strata-sycl.sh: STRATA_SYCL_ROOT, else the folder above the repo), and setup_intel writes the
+    arguments with those paths; a /work/... argument that is not here is looked up under that root (local patch, see the lab notes)."""
+    p = Path(value)
+    if not p.exists() and (value == "/work" or value.startswith("/work/")):
+        root = os.environ.get("STRATA_SYCL_ROOT") or str(Path(__file__).resolve().parents[1].parent)
+        return Path(root + value[len("/work"):])
+    return p
