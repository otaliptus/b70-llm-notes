+        sycl::local_accessor<half, 1> ks(sycl::range<1>((size_t) KB * D), h);
+        sycl::local_accessor<half, 1> vs(sycl::range<1>((size_t) KB * D), h);
+        // each (row, head): its query (scaled), bias query, the split's logits then probabilities, the parts' maxima
+        sycl::local_accessor<float, 1> qs(sycl::range<1>((size_t) NRH * (D + SG + KB + P)), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (Hkv * (ns - prefix)) * NSG * SG), sycl::range<1>((size_t) NSG * SG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
