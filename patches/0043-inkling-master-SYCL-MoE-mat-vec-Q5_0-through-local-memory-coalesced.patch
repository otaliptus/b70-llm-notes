index 614b38b..7301e8e 100644
--- a/ggml/src/ggml-sycl/mmvq.cpp
+++ b/ggml/src/ggml-sycl/mmvq.cpp
@@ -2740,6 +2740,102 @@ static void launch_mul_mat_vec_q_moe(
