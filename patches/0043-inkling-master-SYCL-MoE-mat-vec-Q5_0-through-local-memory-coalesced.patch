     switch (src0_type) {
         case GGML_TYPE_Q4_0:
@@ -2812,7 +2908,11 @@ bool ggml_sycl_mul_mat_vec_q_id(
                 expert_weight_stride, dst_row_stride, src1_row_stride, stream);
             return true;
         case GGML_TYPE_Q5_0:
-            launch_mul_mat_vec_q_moe<QK5_0, QI5_0, block_q5_0, VDR_Q5_0_Q8_1_MMVQ, vec_dot_q5_0_q8_1>(
+            if (launch_mul_mat_vec_q5_0_q8_1_moe_slm(vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
+                    expert_weight_stride, dst_row_stride, src1_row_stride, stream)) {
+                return true;
+            }
+            launch_mul_mat_vec_q_moe<QK5_0, QI5_0, block_q5_0, VDR_Q5_0_Q8_1_MMVQ_MOE, vec_dot_q5_0_q8_1_moe>(
                 vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
                 expert_weight_stride, dst_row_stride, src1_row_stride, stream);
             return true;
