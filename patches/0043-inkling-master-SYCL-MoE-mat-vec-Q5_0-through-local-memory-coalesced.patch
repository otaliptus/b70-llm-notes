+// MoE mat-vec variant: one work-item takes a whole Q5_0 block (vdr 4, iqs 0). With vdr 2 two work-items
+// share a block and each re-reads d and qh; the expert down projections (k = 1152, 36 blocks a row) ran at
+// ~120 GB/s that way.
+#define VDR_Q5_0_Q8_1_MMVQ_MOE 4
+static __dpct_inline__ float
+vec_dot_q5_0_q8_1_moe(const void *__restrict__ vbq,
+                      const block_q8_1 *__restrict__ bq8_1, const int &iqs) {
+    const block_q5_0 * bq5_0 = (const block_q5_0 *) vbq;
+
+    int vl[VDR_Q5_0_Q8_1_MMVQ_MOE];
+    int vh[VDR_Q5_0_Q8_1_MMVQ_MOE];
+    int  u[2*VDR_Q5_0_Q8_1_MMVQ_MOE];
+
+    const int qh = get_int_from_uint8(bq5_0->qh, 0);
+#pragma unroll
+    for (int i = 0; i < VDR_Q5_0_Q8_1_MMVQ_MOE; ++i) {
+        vl[i]    = get_int_from_uint8(bq5_0->qs, iqs + i);
+        vh[i]    = qh >> (4 * (iqs + i));
+        u[2*i+0] = get_int_from_int8_aligned(bq8_1->qs, iqs + i);
+        u[2*i+1] = get_int_from_int8_aligned(bq8_1->qs, iqs + i + QI5_0);
+    }
+
+    return vec_dot_q5_0_q8_1_impl<VDR_Q5_0_Q8_1_MMVQ_MOE>(vl, vh, u, bq5_0->d, bq8_1->ds);
+}
+
