+// SLM split attention over symmetric INT8 target KV cache for short contexts (< 4K) and the
+// relative-bias / causal tail [prefix_kb * 64, p0 + T) at long contexts (launch_ns <= 64, T <= 8 per slice).
+template <int P>
+void attn_rows_i8(sycl::queue& queue, const float* qp, const void* kc_raw, const void* vc_raw,
+                  const float* r, const float* relb, int64_t E, int64_t R, float* part,
+                  int64_t T, int64_t Hq, int64_t Hkv, int64_t cap, int64_t p0, float scale,
+                  int64_t s0_kb, int64_t launch_ns, int64_t out_sp0, int64_t ns_stride,
+                  int64_t row0 = 0, int64_t total_T = 0) {
+    constexpr int PK = KB / SG, KU = PK / P, DU = D / P, DLU = DU / SG;
+    const int NRH = (int) T * G, NSG = NRH * P;
+    const int64_t full_T = total_T > 0 ? total_T : T;
+    const size_t sc_off = (size_t(Hkv) * size_t(cap) * D + 255) / 256 * 256;
+    const int64_t sc_stride = ((cap + 15) & ~int64_t(15)) + 16;
+    const int8_t* kc = static_cast<const int8_t*>(kc_raw);
+    const int8_t* vc = static_cast<const int8_t*>(vc_raw);
+    const float* kc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(kc_raw) + sc_off);
+    const float* vc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(vc_raw) + sc_off);
+    queue.submit([&](sycl::handler& h) {
+        sycl::local_accessor<half, 1> ks(sycl::range<1>((size_t) KB * D), h);
+        sycl::local_accessor<half, 1> vs(sycl::range<1>((size_t) KB * D), h);
+        sycl::local_accessor<float, 1> qs(sycl::range<1>((size_t) NRH * (D + SG + KB + P)), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (Hkv * launch_ns) * NSG * SG), sycl::range<1>((size_t) NSG * SG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            auto sg = it.get_sub_group();
+            const int lane = (int) sg.get_local_linear_id(), sgw = (int) sg.get_group_linear_id();
+            const int u = sgw % P, rh = sgw / P;
+            const int64_t gi = it.get_group(0);
+            const int64_t sp_loc = gi % launch_ns, hk = gi / launch_ns;
+            const int64_t sp_out = out_sp0 + sp_loc;
+            const int64_t rr = rh / G, hq = hk * G + rh % G;
+            const int64_t kb0 = (s0_kb + sp_loc) * KB, kb1 = kb0 + KB;
+            const int64_t tend = p0 + T;
+            const int64_t tlo = kb0, thi = sycl::min<int64_t>(tend, kb1);
+            const int nt = thi > tlo ? (int) (thi - tlo) : 0;
+            const int64_t pos = p0 + rr;
+            const int64_t lo = kb0, hi = sycl::min<int64_t>(pos + 1, kb1);
+            const int64_t nk = hi > lo ? hi - lo : 0;
+            const int64_t off = nk > 0 ? lo - tlo : 0;
+            float* qx = qs.get_multi_ptr<sycl::access::decorated::no>().get() + rh * (D + SG + KB + P);
+            float* rx = qx + D;
+            float* px = rx + SG;
+            float* mp = px + KB;
+            if (u == 0) {
+#pragma unroll
+                for (int i = 0; i < DL; ++i) qx[lane * DL + i] = qp[(rr * Hq + hq) * D + lane * DL + i] * scale;
+                rx[lane] = lane < R && r ? r[(rr * Hq + hq) * R + lane] : 0.0f;
+            }
+            if (nt > 0) {
+                const int64_t s0k = tlo % cap;
+                const float* ksp = kc_sc + hk * sc_stride;
+                const float* vsp = vc_sc + hk * sc_stride;
+                half* ks_slm = ks.get_multi_ptr<sycl::access::decorated::no>().get();
+                half* vs_slm = vs.get_multi_ptr<sycl::access::decorated::no>().get();
+                constexpr int FB = 2;
+                for (int j0 = sgw; j0 < nt; j0 += NSG * FB) {
+                    sycl::vec<int8_t, 8> kq8[FB], vq8[FB];
+                    float kf[FB], vf[FB];
+#pragma unroll
+                    for (int b = 0; b < FB; ++b) {
+                        int64_t slot = s0k + sycl::min(j0 + b * NSG, nt - 1);
+                        if (slot >= cap) slot -= cap;
+                        kf[b] = ksp[slot];
+                        vf[b] = vsp[slot];
+                        kq8[b] = *reinterpret_cast<const sycl::vec<int8_t, 8>*>(kc + (hk * cap + slot) * D + lane * 8);
+                        vq8[b] = *reinterpret_cast<const sycl::vec<int8_t, 8>*>(vc + (hk * cap + slot) * D + lane * 8);
+                    }
+#pragma unroll
+                    for (int b = 0; b < FB; ++b) {
+                        const int jj = j0 + b * NSG;
+                        if (jj < nt) {
+                            sycl::vec<half, 8> kh, vh;
+#pragma unroll
+                            for (int i = 0; i < 8; ++i) {
+                                kh[i] = (half) ((float) kq8[b][i] * kf[b]);
+                                vh[i] = (half) ((float) vq8[b][i] * vf[b]);
+                            }
+                            *reinterpret_cast<sycl::vec<half, 8>*>(ks_slm + jj * D + lane * 8) = kh;
+                            *reinterpret_cast<sycl::vec<half, 8>*>(vs_slm + jj * D + lane * 8) = vh;
+                        }
+                    }
+                }
+            }
+            sycl::group_barrier(it.get_group());
+            const half* kp = ks.get_multi_ptr<sycl::access::decorated::no>().get() + off * D;
+            const half* vp = vs.get_multi_ptr<sycl::access::decorated::no>().get() + off * D;
+            float mloc = -INFINITY;
+#pragma unroll
+            for (int kv = 0; kv < KU; ++kv) {
+                const int jj = lane + (u * KU + kv) * SG;
+                float v = -INFINITY;
+                if (jj < nk) {
+                    float dot = 0.0f;
+#pragma unroll
+                    for (int c = 0; c < SG; ++c) {
+                        const int ci = (c + lane) & (SG - 1);
+                        const sycl::vec<half, 8> kv8 = *(const sycl::vec<half, 8>*) (kp + jj * D + ci * DL);
+#pragma unroll
+                        for (int i = 0; i < DL; ++i) dot = sycl::fma(qx[ci * DL + i], (float) kv8[i], dot);
+                    }
+                    const int64_t d = pos - (lo + jj);
+                    if (d >= 0 && d < E) {
+                        for (int i = 0; i < R; ++i) dot = sycl::fma(rx[i], relb[d * R + i], dot);
+                    }
+                    v = dot;
+                }
+                px[jj] = v;
+                mloc = sycl::fmax(mloc, v);
+            }
+            mloc = sycl::reduce_over_group(sg, mloc, sycl::maximum<float>());
+            if (lane == 0) mp[u] = mloc;
+            sycl::group_barrier(it.get_group());
+            float m = mp[0];
+#pragma unroll
+            for (int k = 1; k < P; ++k) m = sycl::fmax(m, mp[k]);
+#pragma unroll
+            for (int kv = 0; kv < KU; ++kv) {
+                const int jj = lane + (u * KU + kv) * SG;
+                px[jj] = nk > 0 && jj < nk ? sycl::exp(px[jj] - m) : 0.0f;
+            }
+            sycl::group_barrier(it.get_group());
+            float s = 0.0f;
+            if (u == 0) {
+#pragma unroll
+                for (int k = 0; k < PK; ++k) s += px[lane + k * SG];
+                s = sycl::reduce_over_group(sg, s, sycl::plus<float>());
+            }
+            float acc[DLU];
+#pragma unroll
+            for (int i = 0; i < DLU; ++i) acc[i] = 0.0f;
+            const int dbase = u * DU + lane * DLU;
+            for (int64_t jj = 0; jj < nk; ++jj) {
+                const float p = px[jj];
+                const sycl::vec<half, DLU> vr = *reinterpret_cast<const sycl::vec<half, DLU>*>(vp + jj * D + dbase);
+#pragma unroll
+                for (int i = 0; i < DLU; ++i) acc[i] = sycl::fma(p, (float) vr[i], acc[i]);
+            }
+            const int64_t rh_out = (row0 + rr) * Hq + hq;
+            float* pp = part + (rh_out * ns_stride + sp_out) * D;
+            if constexpr (DLU == 8) {
+                ((sycl::float4*)(pp + dbase))[0] = sycl::float4(acc[0], acc[1], acc[2], acc[3]);
+                ((sycl::float4*)(pp + dbase))[1] = sycl::float4(acc[4], acc[5], acc[6], acc[7]);
+            } else if constexpr (DLU == 4) {
+                ((sycl::float4*)(pp + dbase))[0] = sycl::float4(acc[0], acc[1], acc[2], acc[3]);
+            } else {
+#pragma unroll
+                for (int i = 0; i < DLU; ++i) pp[dbase + i] = acc[i];
+            }
+            if (u == 0 && lane == 0) {
+                float* ms = part + (full_T * Hq) * ns_stride * D + (rh_out * ns_stride + sp_out) * 2;
+                ms[0] = m;
+                ms[1] = s;
+            }
+        });
+    });
+}
+
+void launch_attn_rows_i8(sycl::queue& queue, const float* qp, const void* kcv, const void* vcv,
+                         const float* r, const float* relb, int64_t E, int64_t R, float* part,
+                         int64_t T, int64_t Hq, int64_t Hkv, int64_t cap, int64_t p0, float scale,
+                         int64_t s0_kb, int64_t launch_ns, int64_t out_sp0, int64_t ns_stride) {
+    if (T <= 2) {
+        attn_rows_i8<4>(queue, qp, kcv, vcv, r, relb, E, R, part, T, Hq, Hkv, cap, p0, scale, s0_kb, launch_ns, out_sp0, ns_stride, 0, T);
+    } else if (T <= 4) {
+        attn_rows_i8<2>(queue, qp, kcv, vcv, r, relb, E, R, part, T, Hq, Hkv, cap, p0, scale, s0_kb, launch_ns, out_sp0, ns_stride, 0, T);
+    } else if (T <= 8) {
+        attn_rows_i8<1>(queue, qp, kcv, vcv, r, relb, E, R, part, T, Hq, Hkv, cap, p0, scale, s0_kb, launch_ns, out_sp0, ns_stride, 0, T);
+    } else {
+        attn_rows_i8<1>(queue, qp, kcv, vcv, r, relb, E, R, part, 8, Hq, Hkv, cap, p0, scale, s0_kb, launch_ns, out_sp0, ns_stride, 0, T);
+        attn_rows_i8<1>(queue, qp + 8 * Hq * D, kcv, vcv, r ? r + 8 * Hq * R : nullptr, relb, E, R, part, T - 8, Hq, Hkv, cap, p0 + 8, scale, s0_kb, launch_ns, out_sp0, ns_stride, 8, T);
+    }
+}
