+int ns_ink2s_attn_full_i8(ns_gpu* g, const float* qp, const void* kcv, const void* vcv, const float* r, const float* relb, int64_t E, int64_t R, float* part,
+                          int64_t T, int64_t Hq, int64_t Hkv, int64_t cap, int64_t p0, int64_t ns_out, float scale) {
+    NS_TRY
+    if (Hq != G * Hkv || R > SG || T < 1 || T > 16 || ns_out < 1 || ns_out > 64 || p0 + T > cap || !ink_b70::supported(g->dev))
+        return ns_fail("ns_ink2s_attn_full_i8: invalid shape");
+    const int64_t total_kb = (p0 + T - 1) / KB + 1;
+    if (p0 + T <= 4096) {
+        if (ns_out != total_kb) return ns_fail("ns_ink2s_attn_full_i8: short ns_out mismatch");
+        launch_attn_rows_i8(g->q, qp, kcv, vcv, r, relb, E, R, part, T, Hq, Hkv, cap, p0, scale, 0, total_kb, 0, ns_out);
+        return 0;
+    }
+    constexpr int64_t NP = 46;
+    const int64_t ext = sycl::min<int64_t>(p0 + 1, E > 0 ? E : 0);
+    const int64_t prefix_kb = (p0 + 1 - ext) / KB;
+    const int64_t tail_splits = total_kb - prefix_kb;
+    if (prefix_kb < 1 || NP + tail_splits != ns_out)
+        return ns_fail("ns_ink2s_attn_full_i8: long ns_out mismatch");
+    ink_target_attn_i8::run_prefix(g->q, qp, kcv, vcv, part, (int)T, (int)Hq, (int)Hkv, (int)cap,
+                                   (int)(prefix_kb * KB), (int)NP, (int)ns_out, scale);
+    if (tail_splits > 0) {
+        launch_attn_rows_i8(g->q, qp, kcv, vcv, r, relb, E, R, part, T, Hq, Hkv, cap, p0, scale, prefix_kb, tail_splits, NP, ns_out);
+    }
+    return 0;
+    NS_CATCH
+}
