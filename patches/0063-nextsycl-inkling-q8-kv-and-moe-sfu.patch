index 9f60ad0bd5f7e82079a2028617066ae989f1094b..cdaa32dbe041c0612e26d4495c67c380a9d1a1a9 100644
--- a/kernels/llm/inkling2/silo/pattn_esimd.hpp
+++ b/kernels/llm/inkling2/silo/pattn_esimd.hpp
@@ -104,4 +104,157 @@ void run(sycl::queue& queue, const float* q, const half* kc, const half* vc, con
         }
     });
 }
+
+void run_i8(sycl::queue& queue, const float* q, const void* kc_raw, const void* vc_raw, const float* relq, const float* rb, int64_t E, int64_t R,
+            const float* sink, int64_t T, int64_t Hq, int64_t Hkv, int64_t cap, int64_t p0, float* out) {
+    int rows = T, heads = Hq, pos0 = p0, extent = E, rel = R, per = Hq / Hkv, blocks = (rows + M - 1) / M, jobs = blocks * heads;
+    int end = pos0 + rows;
+    const float qscale = 1.f / sycl::sqrt(float(D)) * log2e;
+    const size_t sc_off = (size_t(Hkv) * size_t(cap) * D + 255) / 256 * 256;
+    const size_t sc_stride = ((size_t(cap) + 15) & ~size_t(15)) + 16;
+    const int8_t* kc = static_cast<const int8_t*>(kc_raw);
+    const int8_t* vc = static_cast<const int8_t*>(vc_raw);
+    const float* kc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(kc_raw) + sc_off);
+    const float* vc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(vc_raw) + sc_off);
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t((jobs + WG - 1) / WG) * WG, WG), props, [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        int id = it.get_global_linear_id();
+        if (id >= jobs)
+            return;
+        int hk = id / (per * blocks), h = hk * per + id % per, row0 = ((id / per) % blocks) * M;
+        const int8_t* kb = kc + size_t(hk) * size_t(cap) * D;
+        const int8_t* vb = vc + size_t(hk) * size_t(cap) * D;
+        const float* ks = kc_sc + size_t(hk) * sc_stride;
+        const float* vs = vc_sc + size_t(hk) * sc_stride;
+        es::simd<int, M * 8> qa_i8[D / 32];
+        es::simd<float, M * N> accum[D / N];
+#pragma unroll
+        for (int d = 0; d < D / 32; ++d) qa_i8[d] = 0;
+#pragma unroll
+        for (int d = 0; d < D / N; ++d) accum[d] = 0.f;
+
+        float maxrow[M], sumrow[M], qrow_sc[M];
+        for (int r = 0; r < M; ++r) {
+            int at = (row0 + r < rows ? row0 + r : rows - 1);
+            maxrow[r] = sink[at * heads + h] * log2e;
+            sumrow[r] = 1.f;
+            const float* qp = q + (size_t(at) * heads + h) * D;
+            es::simd<float, 32> qf[4];
+            float amax = 0.f;
+#pragma unroll
+            for (int d = 0; d < 4; ++d) {
+                qf[d] = es::block_load<float, 32>(qp + d * 32);
+                float m = es::hmax<float>(es::abs(qf[d]));
+                if (m > amax) amax = m;
+            }
+            const float sc_q = amax / 127.f;
+            const float inv_q = sc_q != 0.f ? 1.f / sc_q : 0.f;
+            qrow_sc[r] = sc_q * qscale;
+#pragma unroll
+            for (int d = 0; d < 4; ++d) {
+                es::simd<int, 32> qi = es::rnde<int>(qf[d] * inv_q);
+                qi = es::max<int>(es::min<int>(qi, 127), -127);
+                es::simd<int8_t, 32> qb = qi;
+                qa_i8[d].template select<8, 1>(r * 8) = qb.template bit_cast_view<int>();
+            }
+        }
+
+        const int job_end = (end < pos0 + row0 + M ? end : pos0 + row0 + M);
+        const int fast_limit = pos0 + row0 - extent;
+
+        for (int j = 0; j < job_end; j += N) {
+            es::simd<int, M * N> sc_i32(0);
+#pragma unroll
+            for (int d = 0; d < D; d += 32) {
+                es::simd<int, 8 * N> rhs = es::load_2d<uint32_t, 8, 16, 1, true>(
+                    reinterpret_cast<const uint32_t*>(kb), D - 1, end - 1, D - 1, d / 4, j);
+                sc_i32 = xmx::dpas<8, 8, int, int, int, int,
+                    xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(sc_i32, rhs, qa_i8[d / 32]);
+            }
+            es::simd<float, N> k_sc = es::block_load<float, N>(ks + j);
+            es::simd<float, N> v_sc = es::block_load<float, N>(vs + j);
+            es::simd<half, M * N> p;
+            float factor[M];
+            const bool is_tail = (j + N > job_end);
+            if (is_tail) {
+                es::simd<int, N> idx(0, 1);
+                v_sc.merge(0.f, idx >= (job_end - j));
+            }
+            if (!is_tail && j + N <= fast_limit) {
+#pragma unroll
+                for (int r = 0; r < M; ++r) {
+                    es::simd<float, N> z = es::simd<float, N>(sc_i32.template select<N, 1>(r * N)) * (k_sc * qrow_sc[r]);
+                    float tile_max = es::hmax<float>(z);
+                    float mn = maxrow[r] > tile_max ? maxrow[r] : tile_max;
+                    factor[r] = es::exp2(maxrow[r] - mn);
+                    auto y = es::exp2(z - mn);
+                    es::simd<float, 4> ls(0.f);
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) ls += y.template select<4, 4>(i);
+                    sumrow[r] = sumrow[r] * factor[r] + ((ls[0] + ls[1]) + (ls[2] + ls[3]));
+                    maxrow[r] = mn;
+                    p.template select<N, 1>(r * N) = es::simd<half, N>(y * v_sc);
+                }
+            } else {
+                for (int r = 0; r < M; ++r) {
+                    int row = (row0 + r < rows ? row0 + r : rows - 1), pos = pos0 + row;
+                    es::simd<float, N> z = es::simd<float, N>(sc_i32.template select<N, 1>(r * N)) * (k_sc * qrow_sc[r]);
+                    es::simd<int, N> dist(pos - j, -1);
+                    if (extent > 0 && rel > 0) {
+                        es::simd_mask<N> valid = (dist >= 0) & (dist < extent);
+                        es::simd<float, N> bsum(0.f);
+                        for (int i = 0; i < rel; ++i) {
+                            auto b = es::gather<float, N>(rb, es::simd<uint32_t, N>((dist * rel + i) * 4), valid);
+                            b.merge(0.f, !valid);
+                            bsum += b * (relq[(row * heads + h) * rel + i] * log2e);
+                        }
+                        z += bsum;
+                    }
+                    z.merge(-INFINITY, dist < 0);
+                    if (is_tail) {
+                        es::simd<int, N> idx(0, 1);
+                        z.merge(-INFINITY, idx >= (job_end - j));
+                    }
+                    float tile_max = es::hmax<float>(z);
+                    float mn = maxrow[r] > tile_max ? maxrow[r] : tile_max;
+                    factor[r] = es::exp2(maxrow[r] - mn);
+                    auto y = es::exp2(z - mn);
+                    es::simd<float, 4> ls(0.f);
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) ls += y.template select<4, 4>(i);
+                    sumrow[r] = sumrow[r] * factor[r] + ((ls[0] + ls[1]) + (ls[2] + ls[3]));
+                    maxrow[r] = mn;
+                    p.template select<N, 1>(r * N) = es::simd<half, N>(y * v_sc);
+                }
+            }
+#pragma unroll
+            for (int d = 0; d < D; d += N) {
+#pragma unroll
+                for (int r = 0; r < M; ++r)
+                    accum[d / N].template select<N, 1>(r * N) *= factor[r];
+                auto vw = es::load_2d<uint32_t, 4, 16, 1, false, false>(
+                    reinterpret_cast<const uint32_t*>(vb), D - 1, end - 1, D - 1, d / 4, j);
+                auto raw = vw.template bit_cast_view<int8_t>();
+                es::simd<half, N * N> v;
+#pragma unroll
+                for (int pr = 0; pr < 8; ++pr) {
+                    es::simd<int8_t, 16> r0 = raw.template select<16, 1>((2 * pr) * 16);
+                    es::simd<int8_t, 16> r1 = raw.template select<16, 1>((2 * pr + 1) * 16);
+                    v.template select<16, 2>(pr * 32 + 0) = es::simd<half, 16>(r0);
+                    v.template select<16, 2>(pr * 32 + 1) = es::simd<half, 16>(r1);
+                }
+                accum[d / N] = xmx::dpas<8, 8, float, float, half, half>(accum[d / N], v, p);
+            }
+        }
+#pragma unroll
+        for (int d = 0; d < D; d += N) {
+#pragma unroll
+            for (int r = 0; r < M; ++r)
+                if (row0 + r < rows) {
+                    es::simd<float, N> z = accum[d / N].template select<N, 1>(r * N);
+                    es::block_store<float, N>(out + ((row0 + r) * heads + h) * D + d, es::div_ieee(z, es::simd<float, N>(sumrow[r])));
+                }
+        }
+    });
+}
 } // namespace ink_prompt
