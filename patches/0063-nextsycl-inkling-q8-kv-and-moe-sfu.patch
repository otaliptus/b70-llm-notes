diff --git a/kernels/llm/inkling2/silo/target_attn_i8.hpp b/kernels/llm/inkling2/silo/target_attn_i8.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..b9f93295b5c5699ff6355039b9c9b78618aee832
--- /dev/null
+++ b/kernels/llm/inkling2/silo/target_attn_i8.hpp
@@ -0,0 +1,163 @@
+// ESIMD XMX DPAS online flash-decoding for Inkling-2's full-attention prefix [0, prefix_keys)
+// where prefix_keys = prefix_kb * 64 (exact multiple of 64, strictly before the relative-bias window
+// and causal boundary: zero gathers, zero causal/tail masks, 100% balanced across Hkv * np_splits WGs).
+// Writes splits [0, np_splits) into AoS part [T * Hq, ns_stride, 128] + natural-log ms[2].
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+namespace ink_target_attn_i8 {
+namespace es = sycl::ext::intel::esimd;
+namespace xmx = es::xmx;
+using half = sycl::half;
+
+constexpr int D = 128, M = 8, N_TILE = 16, G = 3;
+constexpr float LOG2E = 1.4426950408889634f;
+constexpr float LN2 = 0.6931471805599453f;
+
+inline void run_prefix(sycl::queue& queue, const float* q, const void* kc_raw, const void* vc_raw,
+                       float* part, int T, int Hq, int Hkv, int cap, int prefix_keys,
+                       int np_splits, int ns_stride, float scale) {
+    const int nq = T * G;
+    const int q_tiles = (nq + M - 1) / M;
+    const float qscale = scale * LOG2E;
+    const int groups = T * Hq;
+    const size_t sc_off = (size_t(Hkv) * size_t(cap) * D + 255) / 256 * 256;
+    const size_t sc_stride = ((size_t(cap) + 15) & ~size_t(15)) + 16;
+    const int8_t* kc = static_cast<const int8_t*>(kc_raw);
+    const int8_t* vc = static_cast<const int8_t*>(vc_raw);
+    const float* kc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(kc_raw) + sc_off);
+    const float* vc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(vc_raw) + sc_off);
+    const int n_k_tiles = prefix_keys / N_TILE;
+    const int tiles_per_sp = (n_k_tiles + np_splits - 1) / np_splits;
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(
+        sycl::nd_range<1>(size_t(Hkv * np_splits) * size_t(q_tiles), size_t(q_tiles)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg = (int)it.get_group_linear_id();
+            const int qt = (int)it.get_local_linear_id();
+            const int hk = wg / np_splits;
+            const int sp = wg % np_splits;
+            const int q0 = qt * M;
+            const int8_t* kb = kc + size_t(hk) * size_t(cap) * D;
+            const int8_t* vb = vc + size_t(hk) * size_t(cap) * D;
+            const float* ks = kc_sc + size_t(hk) * sc_stride;
+            const float* vs = vc_sc + size_t(hk) * sc_stride;
+
+            es::simd<int, M * 8> qa_i8[D / 32];
+            es::simd<float, M * N_TILE> accum[D / N_TILE];
+#pragma unroll
+            for (int d = 0; d < D / 32; ++d) qa_i8[d] = 0;
+#pragma unroll
+            for (int d = 0; d < D / N_TILE; ++d) accum[d] = 0.0f;
+
+            float maxrow[M], sumrow[M], qrow_sc[M];
+#pragma unroll
+            for (int r = 0; r < M; ++r) {
+                maxrow[r] = -INFINITY;
+                sumrow[r] = 0.0f;
+                qrow_sc[r] = 0.0f;
+            }
+
+            const int j_beg = sp * tiles_per_sp * N_TILE;
+            const int j_end_raw = (sp + 1) * tiles_per_sp * N_TILE;
+            const int j_end = j_end_raw < prefix_keys ? j_end_raw : prefix_keys;
+
+            if (j_beg < j_end) {
+                for (int r = 0; r < M; ++r) {
+                    const int qr = q0 + r;
+                    if (qr < nq) {
+                        const int head = (qr / G) * Hq + hk * G + (qr % G);
+                        const float* qp = q + size_t(head) * D;
+                        es::simd<float, 32> qf[4];
+                        float amax = 0.0f;
+#pragma unroll
+                        for (int d = 0; d < 4; ++d) {
+                            qf[d] = es::block_load<float, 32>(qp + d * 32);
+                            float m = es::hmax<float>(es::abs(qf[d]));
+                            if (m > amax) amax = m;
+                        }
+                        const float sc_q = amax / 127.0f;
+                        const float inv_q = sc_q != 0.0f ? 1.0f / sc_q : 0.0f;
+                        qrow_sc[r] = sc_q * qscale;
+#pragma unroll
+                        for (int d = 0; d < 4; ++d) {
+                            es::simd<int, 32> qi = es::rnde<int>(qf[d] * inv_q);
+                            qi = es::max<int>(es::min<int>(qi, 127), -127);
+                            es::simd<int8_t, 32> qb = qi;
+                            qa_i8[d].template select<8, 1>(r * 8) = qb.template bit_cast_view<int>();
+                        }
+                    }
+                }
+            }
+
+            for (int j = j_beg; j < j_end; j += N_TILE) {
+                es::simd<int, M * N_TILE> sc_i32(0);
+#pragma unroll
+                for (int d = 0; d < D; d += 32) {
+                    es::simd<int, 8 * N_TILE> rhs = es::load_2d<uint32_t, 8, 16, 1, true>(
+                        reinterpret_cast<const uint32_t*>(kb), D - 1, prefix_keys - 1, D - 1, d / 4, j);
+                    sc_i32 = xmx::dpas<8, 8, int, int, int, int,
+                        xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(sc_i32, rhs, qa_i8[d / 32]);
+                }
+
+                es::simd<float, N_TILE> k_sc = es::block_load<float, N_TILE>(ks + j);
