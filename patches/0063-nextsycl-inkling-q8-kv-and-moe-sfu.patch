+int ns_ink2s_target_kv_store_i8(ns_gpu* g, const float* k, const float* v, int64_t T, int64_t Hkv, int64_t D, int64_t cap, int64_t p0, void* kc, void* vc) {
+    NS_TRY
+    if (T <= 0) return 0;
+    if (D != 128) return ns_fail("ns_ink2s_target_kv_store_i8: D must be 128");
+    const int64_t rows = T * Hkv;
+    const size_t sc_off = align256((size_t)(Hkv * cap * D));
+    const int64_t sc_stride = ((cap + 15) & ~int64_t(15)) + 16;
+    int8_t* kq = (int8_t*)kc;
+    int8_t* vq = (int8_t*)vc;
+    float* ks = (float*)((uint8_t*)kc + sc_off);
+    float* vs = (float*)((uint8_t*)vc + sc_off);
+    constexpr int NSG = 4;
+    const size_t wgs = (size_t)((rows + NSG - 1) / NSG);
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>(wgs * NSG * SG), sycl::range<1>(NSG * SG)),
+                      [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+        auto sg = it.get_sub_group();
+        const int lane = (int)sg.get_local_linear_id();
+        const int64_t rh = (int64_t)it.get_group(0) * NSG + (int64_t)sg.get_group_linear_id();
+        if (rh >= rows) return;
+        const int64_t h = rh % Hkv;
+        const int64_t t = rh / Hkv;
+        const int64_t slot = (p0 + t) % cap;
+        const float* kr = gptr(k) + rh * 128;
+        const float* vr = gptr(v) + rh * 128;
+        float kv[8], vv[8];
+        float kamax = 0.0f, vamax = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            kv[i] = kr[lane * 8 + i];
+            vv[i] = vr[lane * 8 + i];
+            kamax = sycl::fmax(kamax, sycl::fabs(kv[i]));
+            vamax = sycl::fmax(vamax, sycl::fabs(vv[i]));
+        }
+        kamax = sycl::reduce_over_group(sg, kamax, sycl::maximum<float>());
+        vamax = sycl::reduce_over_group(sg, vamax, sycl::maximum<float>());
+        const float ksc = kamax * (1.0f / 127.0f);
+        const float vsc = vamax * (1.0f / 127.0f);
+        const float kin = ksc != 0.0f ? (1.0f / ksc) : 0.0f;
+        const float vin = vsc != 0.0f ? (1.0f / vsc) : 0.0f;
+        int8_t* kdst = gptr(kq) + (h * cap + slot) * 128 + lane * 8;
+        int8_t* vdst = gptr(vq) + (h * cap + slot) * 128 + lane * 8;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            int kqi = (int)sycl::round(kv[i] * kin);
+            int vqi = (int)sycl::round(vv[i] * vin);
+            kdst[i] = (int8_t)(kqi > 127 ? 127 : (kqi < -127 ? -127 : kqi));
+            vdst[i] = (int8_t)(vqi > 127 ? 127 : (vqi < -127 ? -127 : vqi));
+        }
+        if (lane == 0) {
+            gptr(ks)[h * sc_stride + slot] = ksc;
+            gptr(vs)[h * sc_stride + slot] = vsc;
+        }
+    });
