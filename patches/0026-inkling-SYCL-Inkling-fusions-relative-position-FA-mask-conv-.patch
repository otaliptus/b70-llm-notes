 // 2. MoE router: SIGMOID ADD(bias) ARGSORT(desc) GET_ROWS(probs, topk) SUM_ROWS SCALE(1, eps) DIV SCALE(w)
 //    one work-group per token, n_expert <= 256; writes the full argsort and the scaled weights
+// the router logits mat-vec before it: W F32 [K, n_exp], x F32 [K, n_tok]; 4 sub-groups per (expert, token)
+bool router_logits(ggml_backend_sycl_context & ctx, const ggml_tensor * mm) {
+    const ggml_tensor * W = mm->src[0], * x = mm->src[1];
+    if (W->type != GGML_TYPE_F32 || !ggml_is_contiguous(W) || W->ne[2] != 1 || x->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(x) || x->ne[0] != W->ne[0] || x->ne[2] != 1 || !ggml_is_contiguous(mm) ||
+        mm->type != GGML_TYPE_F32 || overlaps(mm, x) || overlaps(mm, W) || x->ne[1] > 8) {
+        return false;
+    }
+    const int64_t K = W->ne[0], n_exp = W->ne[1], n_tok = x->ne[1];
+    const float * wd = (const float *) W->data;
+    const float * xd = (const float *) x->data;
+    float * od = (float *) mm->data;
+    constexpr int WGL = 4 * SG;
+    ctx.stream()->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> part(WGL / SG, cgh);
+        cgh.parallel_for(sycl::nd_range<2>(sycl::range<2>(n_tok, n_exp * WGL), sycl::range<2>(1, WGL)),
+                         [=](sycl::nd_item<2> it) [[sycl::reqd_sub_group_size(SG)]] {
+            const int64_t tk = it.get_group(0), r = it.get_group(1);
+            const int l = it.get_local_id(1);
+            float acc = 0.0f;
+            const sycl::float4 * w4 = (const sycl::float4 *) (wd + r * K);
+            const sycl::float4 * x4 = (const sycl::float4 *) (xd + tk * K);
+            for (int64_t k = l; k < K / 4; k += WGL) {
+                const sycl::float4 a = w4[k], b = x4[k];
+                acc += a.x() * b.x() + a.y() * b.y() + a.z() * b.z() + a.w() * b.w();
+            }
+            auto sg = it.get_sub_group();
+            acc = sycl::reduce_over_group(sg, acc, sycl::plus<float>());
+            if (sg.leader()) {
+                part[l / SG] = acc;
+            }
+            sycl::group_barrier(it.get_group());
+            if (l == 0) {
+                od[tk * n_exp + r] = part[0] + part[1] + part[2] + part[3];
+            }
+        });
+    });
+    return true;
+}
