     # refused before anything is written: the previous pack stays as it was
     if problems:
         for m in problems[:8]:
@@ -436,7 +464,7 @@ def expert_layout(model: Model, src: pathlib.Path):
     exps = [n for n in T if n.startswith("blk.") and n.endswith("_exps.weight")]
