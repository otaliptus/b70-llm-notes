@@ -220,6 +220,26 @@ def tensor_bytes(mm, g, t) -> np.ndarray:
     return mm[g.data_start + t.offset: g.data_start + t.offset + n]
 
 
+def model_layers(model: Model) -> int:
+    """The transformer layers the engine runs.  A GGUF that kept the MTP head (bottlecapai's ThinkingCap:
+    `block_count` 49 with `nextn_predict_layers` 1, where llama.cpp's own converter drops the head) stores it as
+    the block after the last layer, routed experts and all.  It is not a layer of the model: the engine refuses
+    an expert table with a row for it ("a malformed line"), its dense tensors are never read from the pack, and
+    the draft layer comes from --mtp.  Older files have no such key and keep every block."""
+    md = model.files[0].metadata
+    arch = md.get("general.architecture")
+    n = md.get("%s.block_count" % arch) if isinstance(arch, str) else None
+    if not isinstance(n, int) or isinstance(n, bool):
+        return 1 << 30
+    mtp = md.get("%s.nextn_predict_layers" % arch, 0)
+    return n - (mtp if isinstance(mtp, int) and not isinstance(mtp, bool) else 0)
+
+
+def block_of(name: str):
+    m = re.match(r"blk\.(\d+)\.", name)
+    return int(m.group(1)) if m else None
+
+
 def is_expert(name: str) -> bool:
     return name.startswith("blk.") and name.endswith(("_exps.weight",))
 
@@ -276,9 +296,14 @@ def index_standalone(src, out, model: Model, compat_bf16: bool = False) -> int:
     """Every non-expert tensor of the model: the floats the engine reads from the pack into dense.bin in the form it
     reads them (FORM; converted when stored otherwise, see above), quantized ones served natively from the GGUF."""
     todo, problems = [], []
+    n_layers, dropped = model_layers(model), 0
     for name, (g, t, mm, p) in model.where.items():
         if is_expert(t.name) or t.name in NOT_IN_PACK:
             continue
+        b = block_of(name)
+        if b is not None and b >= n_layers:   # the MTP head's block, see model_layers
+            dropped += 1
+            continue
         if len(t.shape) > 2:
             print("tensor %s has %d dimensions; the index holds two" % (t.name, len(t.shape)))
             return 1
@@ -290,6 +315,9 @@ def index_standalone(src, out, model: Model, compat_bf16: bool = False) -> int:
         if t.type_name not in FLOAT and not native and not compat_bf16:
             problems.append(f"{name} is {t.type_name}, but the engine requires {form}; use --compat-bf16")
         todo.append((name, g, t, mm, p, native))
+    if dropped:
+        print("MTP head kept in the GGUF (block %d, nextn_predict_layers): %d dense tensors left out of the pack; "
