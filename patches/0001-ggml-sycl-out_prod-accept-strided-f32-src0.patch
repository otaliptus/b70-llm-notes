diff --git a/ggml/src/ggml-sycl/outprod.cpp b/ggml/src/ggml-sycl/outprod.cpp
index 8d10dad..8baeb70 100644
--- a/ggml/src/ggml-sycl/outprod.cpp
+++ b/ggml/src/ggml-sycl/outprod.cpp
@@ -9,7 +9,9 @@ void ggml_sycl_op_out_prod(ggml_backend_sycl_context& ctx, ggml_tensor* dst) {
     GGML_ASSERT(src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_Q1_0);
     GGML_ASSERT(src1->type == GGML_TYPE_F32);
     GGML_ASSERT(dst->type == GGML_TYPE_F32);
-    GGML_ASSERT(ggml_is_contiguous(src0));
+    // src0 may be a transposed or row-padded f32 view (DFlash drafters hand one in); only the
+    // Q1_0 path dequantizes into a packed buffer and therefore needs a contiguous source.
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 || ggml_is_contiguous(src0));
     GGML_ASSERT(ggml_is_contiguous(dst));
 
     GGML_TENSOR_BINARY_OP_LOCALS
@@ -51,6 +53,20 @@ void ggml_sycl_op_out_prod(ggml_backend_sycl_context& ctx, ggml_tensor* dst) {
     const float alpha = 1.0f;
     const float beta = 0.0f;
 
+    // src0 as column-major A (ne00 x ne01): unit stride along i0 means plain rows with leading
+    // dimension nb01; unit stride along i1 means a transposed view with leading dimension nb00.
+    oneapi::mkl::transpose src0_op = oneapi::mkl::transpose::nontrans;
+    int64_t lda = ne00;
+    if (src0->type == GGML_TYPE_F32) {
+        if (nb00 == sizeof(float)) {
+            lda = nb01 / sizeof(float);
+        } else {
+            GGML_ASSERT(nb01 == sizeof(float));
+            src0_op = oneapi::mkl::transpose::trans;
+            lda = nb00 / sizeof(float);
+        }
+    }
+
     // Handle transposition of src1
     const bool src1_T = ggml_is_transposed(src1);
     const oneapi::mkl::transpose src1_op = src1_T ? oneapi::mkl::transpose::nontrans : oneapi::mkl::transpose::trans;
@@ -71,8 +87,8 @@ void ggml_sycl_op_out_prod(ggml_backend_sycl_context& ctx, ggml_tensor* dst) {
                 float * dst_plane = (float *) ((char *) dst_d + i2 * nb2 + i3 * nb3);
 
                 // Perform matrix multiplication using oneMKL GEMM
-                oneapi::mkl::blas::column_major::gemm(*stream, oneapi::mkl::transpose::nontrans, src1_op,
-                                                      ne0, ne1, ne01, alpha, src0_plane, ne00,
+                oneapi::mkl::blas::column_major::gemm(*stream, src0_op, src1_op,
+                                                      ne0, ne1, ne01, alpha, src0_plane, lda,
                                                       src1_plane, ldb, beta, dst_plane, ne0);
             }
         }
