index 0000000..9d77873
--- /dev/null
+++ b/kernels/llm/inkling2/silo/merge_long.hpp
@@ -0,0 +1,83 @@
+// Compute each split coefficient once. Preserve the coefficient and split order in
+// both the denominator and the weighted values, then apply the original gate and Q8 rounding.
+#pragma once
+#include <sycl/ext/intel/esimd.hpp>
+#include <cstdint>
+#include <cmath>
+namespace es = sycl::ext::intel::esimd;
+extern "C" int ns_ink2s_merge_exact(ns_gpu* g, const float* part, const float* sink, const float* gate, float* out, void* xq, int64_t rows,
+                                    int64_t heads, int64_t nsplit, float* scratch) {
+    NS_TRY
+    if (!ink_b70::supported(g->dev) || nsplit < 128 || nsplit > 4096)
+        return ns_ink2s_merge_gate_xq(g, part, sink, gate, out, xq, rows, heads, nsplit);
+    constexpr int D = 128, SG = 16, W = 128;
+    const int ns = (int)nsplit, groups = (int)(rows * heads);
+    float* denom = scratch + size_t(groups) * ns;
+    g->q.submit([&](sycl::handler& h) {
+        sycl::local_accessor<float, 1> l(sycl::range<1>(2 * ns), h);
+        h.parallel_for(sycl::nd_range<1>(size_t(groups) * W, W), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            int rh = it.get_group_linear_id(), tid = it.get_local_linear_id();
+            auto group = it.get_group();
+            const float* pp = part + size_t(rh) * ns * (D + 2);
+            const float sk = sink ? sink[rh] : -INFINITY;
+            float m = sk;
+            for (int i = tid; i < ns; i += W)
+                m = sycl::fmax(m, pp[i * (D + 2) + D]);
+            m = sycl::reduce_over_group(group, m, sycl::maximum<float>());
+            float* c = l.get_multi_ptr<sycl::access::decorated::no>().get();
+            float* mass = c + ns;
+            for (int i = tid; i < ns; i += W) {
+                c[i] = sycl::exp(pp[i * (D + 2) + D] - m);
+                mass[i] = pp[i * (D + 2) + D + 1];
+                scratch[size_t(rh) * ns + i] = c[i];
+            }
+            sycl::group_barrier(group);
+            if (!tid) {
+                float z = sink ? sycl::exp(sk - m) : 0.f;
+                for (int i = 0; i < ns; ++i)
+                    z += mass[i] * c[i];
+                denom[rh] = z;
+            }
+        });
+    });
+    constexpr int B = 16, P = 16;
+    g->q.parallel_for(sycl::range<1>(size_t(groups) * (D / B)), [=](sycl::id<1> id) SYCL_ESIMD_KERNEL {
+        int rh = id[0] / (D / B), off = id[0] % (D / B) * B;
+        const float* start = part + size_t(rh) * ns * (D + 2) + off;
+        const float* cp = scratch + size_t(rh) * ns;
+        es::simd<float, B> accum(0.f);
+        int i = 0;
+        for (; i + P <= ns; i += P) {
+            auto coeff = es::block_load<float, P>(cp + i);
+#pragma unroll
+            for (int j = 0; j < P; ++j) {
+                auto v = es::block_load<float, B>(start + (i + j) * (D + 2));
+                accum += v * float(coeff[j]);
+            }
+        }
+        for (; i < ns; ++i)
+            accum += es::block_load<float, B>(start + i * (D + 2)) * cp[i];
+        es::block_store<float, B>(out + rh * D + off, accum);
+    });
+    g->q.parallel_for(sycl::nd_range<1>(size_t(groups) * D / 2, SG), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+        int at = it.get_global_linear_id() * 2, rh = at / D;
+        float a = out[at] / denom[rh], b = out[at + 1] / denom[rh];
+        if (gate) {
+            a *= 1.f / (1.f + sycl::exp(-gate[at]));
+            b *= 1.f / (1.f + sycl::exp(-gate[at + 1]));
+        }
+        out[at] = a;
+        out[at + 1] = b;
+        auto sg = it.get_sub_group();
+        const float peak = sycl::reduce_over_group(sg, sycl::fmax(sycl::fabs(a), sycl::fabs(b)), sycl::maximum<float>());
+        const float d = peak / 127.f, inv = d != 0.f ? 1.f / d : 0.f;
+        auto* q = (int8_t*)xq;
+        q[at] = (int8_t)sycl::round(a * inv);
+        q[at + 1] = (int8_t)sycl::round(b * inv);
+        const size_t qlen = (size_t(groups) * D + 255) / 256 * 256;
+        if (sg.get_local_linear_id() == 0)
+            reinterpret_cast<float*>(q + qlen)[at / 32] = (float)sycl::half(d);
+    });
+    return 0;
+    NS_CATCH
+}
