diff --git a/kernels/llm/inkling2/silo/pattn_esimd.hpp b/kernels/llm/inkling2/silo/pattn_esimd.hpp
new file mode 100644
index 0000000..9f60ad0
--- /dev/null
+++ b/kernels/llm/inkling2/silo/pattn_esimd.hpp
@@ -0,0 +1,107 @@
+// Streaming prompt attention, eight query rows per Xe2 matrix tile. K is read as
+// transposed pairs and V with the 2D VNNI transform. Both come directly from the
+// FP16 cache. The relative bias, causal mask, sink and running sums use FP32.
+#pragma once
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+namespace ink_prompt {
+namespace es = sycl::ext::intel::esimd;
+namespace xmx = es::xmx;
+using half = sycl::half;
+constexpr int D = 128, M = 8, N = 16, WG = 8;
+constexpr float log2e = 1.4426950408889634f;
+void run(sycl::queue& queue, const float* q, const half* kc, const half* vc, const float* relq, const float* rb, int64_t E, int64_t R,
+         const float* sink, int64_t T, int64_t Hq, int64_t Hkv, int64_t cap, int64_t p0, float* out) {
+    int rows = T, heads = Hq, pos0 = p0, extent = E, rel = R, per = Hq / Hkv, blocks = (rows + M - 1) / M, jobs = blocks * heads;
+    int pitch = heads * D * sizeof(float), end = pos0 + rows;
+    const float qscale = 1.f / sycl::sqrt(float(D)) * log2e;
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t((jobs + WG - 1) / WG) * WG, WG), props, [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        int id = it.get_global_linear_id();
+        if (id >= jobs)
+            return;
+        int hk = id / (per * blocks), h = hk * per + id % per, row0 = ((id / per) % blocks) * M;
+        const half* kb = kc + size_t(hk) * cap * D;
+        const half* vb = vc + size_t(hk) * cap * D;
+        es::simd<half, M * N> qa[D / N];
+        es::simd<float, M * N> accum[D / N];
+#pragma unroll
+        for (int d = 0; d < D; d += N) {
+            auto f = es::load_2d<float, N, M>(q + h * D, D * 4 - 1, rows - 1, pitch - 1, d, row0);
+            qa[d / N] = f * qscale;
+            accum[d / N] = 0.f;
+        }
+        float maxrow[M], sumrow[M];
+#pragma unroll
+        for (int r = 0; r < M; ++r) {
+            int at = (row0 + r < rows ? row0 + r : rows - 1);
+            maxrow[r] = sink[at * heads + h] * log2e;
+            sumrow[r] = 1.f;
+        }
+        const int job_end = (end < pos0 + row0 + M ? end : pos0 + row0 + M);
+        for (int j = 0; j < job_end; j += N) {
+            es::simd<float, M * N> sc0(0.f), sc1(0.f);
+#pragma unroll
+            for (int d = 0; d < D; d += N) {
+                auto words =
+                    es::load_2d<uint32_t, 8, 16, 1, true>(reinterpret_cast<const uint32_t*>(kb), D * 2 - 1, end - 1, D * 2 - 1, d / 2, j);
+                es::simd<half, N * N> k = words.template bit_cast_view<half>();
+                if (d < D / 2)
+                    sc0 = xmx::dpas<8, 8, float, float, half, half>(sc0, k, qa[d / N]);
+                else
+                    sc1 = xmx::dpas<8, 8, float, float, half, half>(sc1, k, qa[d / N]);
+            }
+            auto score = sc0 + sc1;
+            es::simd<half, M * N> p;
+            float factor[M];
+#pragma unroll
+            for (int r = 0; r < M; ++r) {
+                int row = (row0 + r < rows ? row0 + r : rows - 1), pos = pos0 + row;
+                es::simd<float, N> z = score.template select<N, 1>(r * N);
+                if (j + N > pos0 + row0 - extent) {
+                    es::simd<int, N> dist(pos - j, -1);
+                    es::simd_mask<N> valid = (dist >= 0) & (dist < extent);
+                    es::simd<float, N> bsum(0.f);
+                    for (int i = 0; i < rel; ++i) {
+                        auto b = es::gather<float, N>(rb, es::simd<uint32_t, N>((dist * rel + i) * 4), valid);
+                        b.merge(0.f, !valid);
+                        bsum += b * (relq[(row * heads + h) * rel + i] * log2e);
+                    }
+                    z += bsum;
+                    z.merge(-INFINITY, dist < 0);
+                }
+                float tile_max = es::hmax<float>(z);
+                float mn = maxrow[r] > tile_max ? maxrow[r] : tile_max;
+                factor[r] = es::exp2(maxrow[r] - mn);
+                auto y = es::exp2(z - mn);
+                es::simd<float, 4> lane_sums(0.f);
+#pragma unroll
+                for (int i = 0; i < 4; ++i)
+                    lane_sums += y.template select<4, 4>(i);
+                const float left = lane_sums[0] + lane_sums[1], right = lane_sums[2] + lane_sums[3];
+                sumrow[r] = sumrow[r] * factor[r] + (left + right);
+                maxrow[r] = mn;
+                p.template select<N, 1>(r * N) = es::simd<half, N>(y);
+            }
+#pragma unroll
+            for (int d = 0; d < D; d += N) {
+#pragma unroll
+                for (int r = 0; r < M; ++r)
