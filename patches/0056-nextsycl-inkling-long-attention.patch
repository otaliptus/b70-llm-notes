diff --git a/kernels/llm/inkling2/silo/attn_long.hpp b/kernels/llm/inkling2/silo/attn_long.hpp
new file mode 100644
index 0000000..99b7684
--- /dev/null
+++ b/kernels/llm/inkling2/silo/attn_long.hpp
@@ -0,0 +1,113 @@
+// Full 64-key splits preceding the relative-bias window. The dot product follows the
+// original lane rotation. The same FP32 softmax reductions and value order are used.
+#pragma once
+#include <cmath>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+namespace ink_decode {
+namespace es = sycl::ext::intel::esimd;
+using half = sycl::half;
+constexpr int SG = 16, D = 128, G = 3, KB = 64;
+
+template <int QP>
+void dot(sycl::queue& queue, const float* q, const half* keys, float* part, int T, int Hq, int Hkv, int cap, int ns, int prefix,
+         float scale) {
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t(Hkv * prefix) * SG, SG), props, [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<D * QP * 4>();
+        int gi = it.get_group_linear_id(), hk = gi / prefix, sp = gi % prefix, lane = it.get_local_id(0);
+        es::simd<uint32_t, 8> qoff(lane * 8 * QP * 4, QP * 4);
+        for (int qr = 0; qr < QP; ++qr) {
+            int head = (qr / G) * Hq + hk * G + qr % G;
+            es::simd<float, 8> f(0.f);
+            if (qr < T * G)
+                f = es::block_load<float, 8>(q + head * D + lane * 8) * scale;
+            es::slm_scatter<float, 8>(qoff + qr * 4, f);
+        }
+        es::barrier();
+        const half* ks = keys + (size_t(hk) * cap + sp * KB + lane) * D;
+        es::simd<half, D> k[4];
+        es::simd<float, QP> acc[4];
+#pragma unroll
+        for (int u = 0; u < 4; ++u) {
+            k[u] = es::block_load<half, D>(ks + u * SG * D);
+            acc[u] = 0.f;
+        }
+        for (int c = 0; c < SG; ++c) {
+            const int d = ((c + lane) & 15) * 8;
+            es::simd<float, 8> v[4];
+#pragma unroll
+            for (int u = 0; u < 4; ++u)
+                v[u] = es::simd<half, 8>(k[u].template select<8, 1>(d));
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                auto a = es::slm_block_load<float, QP>((d + i) * QP * 4);
+#pragma unroll
+                for (int u = 0; u < 4; ++u) {
+                    es::simd<float, QP> b = float(v[u][i]);
+                    acc[u] = __builtin_elementwise_fma(a.data(), b.data(), acc[u].data());
+                }
+            }
+        }
+        for (int qr = 0; qr < T * G; ++qr) {
+            int head = (qr / G) * Hq + hk * G + qr % G;
+            float* pp = part + (size_t(head) * ns + sp) * (D + 2);
+#pragma unroll
+            for (int u = 0; u < 4; ++u)
+                pp[lane + u * SG] = acc[u][qr];
+        }
+    });
+}
+
+inline void value(sycl::queue& queue, const half* values, float* part, int T, int Hq, int Hkv, int cap, int ns, int prefix) {
+    int nq = T * G, W = nq * SG;
+    queue.submit([&](sycl::handler& h) {
+        sycl::local_accessor<half, 1> cache(sycl::range<1>(KB * D), h);
+        sycl::local_accessor<float, 1> probs(sycl::range<1>(nq * KB), h);
+        h.parallel_for(sycl::nd_range<1>(size_t(Hkv * prefix) * W, W), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            auto sg = it.get_sub_group();
+            int gi = it.get_group_linear_id(), hk = gi / prefix, sp = gi % prefix, lane = sg.get_local_linear_id(),
+                qr = sg.get_group_linear_id();
+            int head = (qr / G) * Hq + hk * G + qr % G;
+            auto* vp = cache.get_multi_ptr<sycl::access::decorated::no>().get();
+            for (int i = qr; i < KB; i += nq)
+                reinterpret_cast<sycl::uint4*>(vp + i * D)[lane] =
+                    reinterpret_cast<const sycl::uint4*>(values + (size_t(hk) * cap + sp * KB + i) * D)[lane];
+            float* pp = part + (size_t(head) * ns + sp) * (D + 2);
+            auto* p = probs.get_multi_ptr<sycl::access::decorated::no>().get() + qr * KB;
+            float lg[4], m = -INFINITY;
+#pragma unroll
+            for (int u = 0; u < 4; ++u) {
+                lg[u] = pp[lane + u * SG];
+                m = sycl::fmax(m, lg[u]);
+            }
+            m = sycl::reduce_over_group(sg, m, sycl::maximum<float>());
+            float sum = 0;
+#pragma unroll
+            for (int u = 0; u < 4; ++u) {
+                float y = sycl::exp(lg[u] - m);
+                p[lane + u * SG] = y;
+                sum += y;
+            }
+            sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+            sycl::group_barrier(it.get_group());
+            float acc[8] = {};
+            for (int j = 0; j < KB; ++j) {
+                float pr = p[j];
+                auto v = *reinterpret_cast<const sycl::vec<half, 8>*>(vp + j * D + lane * 8);
+#pragma unroll
+                for (int d = 0; d < 8; ++d)
+                    acc[d] = sycl::fma(pr, float(v[d]), acc[d]);
+            }
+#pragma unroll
+            for (int d = 0; d < 8; ++d)
+                pp[lane * 8 + d] = acc[d];
+            if (!lane) {
+                pp[D] = m;
+                pp[D + 1] = sum;
+            }
+        });
+    });
+}
+} // namespace ink_decode
diff --git a/kernels/llm/inkling2/silo/b70.hpp b/kernels/llm/inkling2/silo/b70.hpp
new file mode 100644
index 0000000..9d9ac32
--- /dev/null
+++ b/kernels/llm/inkling2/silo/b70.hpp
@@ -0,0 +1,17 @@
+#pragma once
+#include <optional>
+#include <sycl/sycl.hpp>
+
+namespace ink_b70 {
+// The selection follows the queue's device, including when a thread changes devices.
+inline bool supported(const sycl::device& device) {
+    namespace ex = sycl::ext::oneapi::experimental;
+    static thread_local std::optional<sycl::device> last;
+    static thread_local bool enabled = false;
+    if (!last || *last != device) {
+        enabled = device.is_gpu() && device.get_info<ex::info::device::architecture>() == ex::architecture::intel_gpu_bmg_g31;
+        last = device;
+    }
+    return enabled;
+}
+} // namespace ink_b70
