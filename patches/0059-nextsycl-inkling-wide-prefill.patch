+// The reference prompt path chooses oneMKL problems from batches of this many
+// source tokens. Wider staging reuses expanded weights across those same problems.
+pub(super) const PROMPT_GEMM_ROWS: usize = 2048;
+
+fn prompt_pass_rows(remaining: usize, capacity: usize) -> usize {
+    let group = if capacity >= PROMPT_GEMM_ROWS { capacity / PROMPT_GEMM_ROWS * PROMPT_GEMM_ROWS } else { capacity };
+    let count = remaining.min(group);
+    let tail = count % PROMPT_GEMM_ROWS;
+    if count > PROMPT_GEMM_ROWS && (1..=MAXV).contains(&tail) {
+        // The reference computes this tail with the small-batch decode kernels.
+        count - tail
+    } else {
+        count
+    }
+}
