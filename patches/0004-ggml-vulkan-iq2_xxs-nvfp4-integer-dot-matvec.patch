+#if defined(DATA_A_NVFP4)
+// One 16-element sub-block per call (K_PER_ITER 16): 2 x uint32 of e2m1 nibbles + a UE4M3 scale byte. Byte j of
+// the sub-block holds elements j (low nibble) and j+8 (high nibble). Integer dot against the q8_1 activations.
+// 4 e2m1 codes (low nibbles of the 4 bytes of x) -> 4 signed int8 (2*e2m1), SIMD-within-a-register, no table loads
+// (shared-memory lookups compile to slow "send" messages on Intel).
+int32_t nvfp4_swar_i8x4(uint x) {
+    const uint k  = x & 0x07070707u;                       // magnitude code 0..7
+    const uint hi = (x >> 2) & 0x01010101u;                // k >= 4
+    const uint b1 = (x >> 1) & 0x01010101u;                // bit 1 of k
+    const uint m  = x & 0x01010101u;                       // mantissa bit
+    uint t = 0x04040404u + (m << 1);                       // k >= 4: (4 + 2m) << b1 = 4, 6, 8, 12
+    t += t & (b1 * 0xFFu);
+    uint v = k ^ ((k ^ t) & (hi * 0xFFu));                 // k < 4: value = k
+    const uint s  = (x >> 3) & 0x01010101u;                // sign, but never negate a zero
+    const uint nz = ((k + 0x7F7F7F7Fu) >> 7) & 0x01010101u;
+    const uint sm = s & nz;
+    return int32_t((v ^ (sm * 0xFFu)) + sm);
+}
+i32vec2 nvfp4_repack(uint w) {
+    return i32vec2(nvfp4_swar_i8x4(w & 0x0F0F0F0Fu), nvfp4_swar_i8x4((w >> 4) & 0x0F0F0F0Fu));
+}
+float nvfp4_scale_q(uint ib, uint sub) {
+    const uint u = (data_a_packed32[ib].d[0] >> (8u * sub)) & 0x7Fu;
+    const uint e = u >> 3;
+    const uint m = u & 7u;
+    const float r = (e == 0u) ? float(m) * (1.0 / 512.0) : uintBitsToFloat(((e + 120u) << 23) | (m << 20));
+    return (u == 0x7Fu) ? 0.0 : r;
+}
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib  = ib_a / 2;                 // 64-element block
+    const uint sub = (ib_a % 2) * 2 + iqs;     // 16-element sub-block 0..3
+    const i32vec2 q0 = nvfp4_repack(data_a_packed32[ib].qs[2 * sub    ]);   // elements 0..3 (lo), 8..11 (hi)
+    const i32vec2 q1 = nvfp4_repack(data_a_packed32[ib].qs[2 * sub + 1]);   // elements 4..7 (lo), 12..15 (hi)
+    int32_t q_sum = dotPacked4x8EXT(q0.x, cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(q1.x, cache_b_qs[1]);
