diff --git a/src/models/dspark.cpp b/src/models/dspark.cpp
index ca92a01..4fb8e65 100644
--- a/src/models/dspark.cpp
+++ b/src/models/dspark.cpp
@@ -920,6 +920,18 @@ void llama_model_dflash::load_tensors_inkling2() {
     dspark_joint_proj_b = create_tensor(tn(LLM_TENSOR_DSPARK_JOINT_PROJ, "bias"), {3*rank}, 0);
     dspark_hidden_out = create_tensor(tn(LLM_TENSOR_DSPARK_HIDDEN_OUT, "weight"), {rank, n_embd}, 0);
     dspark_hidden_out_b = create_tensor(tn(LLM_TENSOR_DSPARK_HIDDEN_OUT, "bias"), {n_embd}, 0);
+    // optional reduced-vocabulary head (scripts/make-dspark-subvocab.py): the chained positions run their lm-head
+    // pass over these rows only, and the draft ids come back in the chain state rows instead of full logits
+    if (const auto * sub_meta = ml->get_tensor_meta("dspark_out_sub.weight")) {
+        const int64_t n_sub = sub_meta->ne[1];
+        dspark_out_sub       = create_tensor(tn(LLM_TENSOR_DSPARK_OUT_SUB, "weight"), {n_embd, n_sub}, 0);
+        dspark_markov_w1_sub = create_tensor(tn(LLM_TENSOR_DSPARK_MARKOV_W1_SUB, "weight"), {rank, n_sub}, 0);
+        dspark_out_sub_ids   = create_tensor(tn(LLM_TENSOR_DSPARK_OUT_SUB_IDS, "weight"), {n_sub}, 0);
+        if (rank + 1 > n_embd) {
+            throw std::runtime_error("Inkling2 DSpark: no room for the draft id in the chain state row");
+        }
+        LLAMA_LOG_INFO("%s: DSpark reduced draft vocabulary: %lld tokens\n", __func__, (long long) n_sub);
+    }
     for (int i = 0; i < n_layer; ++i) {
         auto & l = layers[i];
         const int64_t hd = hparams.n_embd_head_k(i);
@@ -1075,6 +1087,56 @@ llama_model_dflash::graph_inkling2::graph_inkling2(const llm_graph_params & para
         res->t_logits = ggml_cont(ctx0, ggml_view_2d(ctx0, base, hparams.n_vocab_unpadded, n_tokens, base->nb[1], 0));
         return;
     }
+    const auto block_cols = [&](ggml_tensor * t, int64_t i) {
+        return ggml_cont(ctx0, ggml_view_2d(ctx0, t, t->ne[0], nb, block*t->nb[1], i*t->nb[1]));
+    };
+    const auto to_block_order = [&](ggml_tensor * t) {
+        t = ggml_reshape_3d(ctx0, t, t->ne[0], nb, block);
+        return ggml_reshape_2d(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, t, 0, 2, 1, 3)), t->ne[0], n_tokens);
+    };
+    static const bool use_sub = [] { const char * e = getenv("LLAMA_DSPARK_SUB"); return !e || atoi(e) != 0; }();
+    if (model.dspark_out_sub && use_sub) {
+        // reduced-vocabulary head: per chained position one lm-head pass over the subset rows of
+        // (backbone row + correction), argmax in the subset; the full id of the drafted token goes into element
+        // `rank` of that position's chain-state row (read by the speculative driver), no full-vocabulary logits
+        const int64_t n_sub = model.dspark_out_sub->ne[1];
+        const char * nc_str = getenv("LLAMA_DSPARK_NCHAIN");
+        const int64_t nc_env = nc_str ? (int64_t) atoi(nc_str) : 0;
+        const int64_t n_chain = nc_env > 0 ? std::min<int64_t>(nc_env, block - 1) : block - 1;
+        auto * zrow  = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, nb), 0.0f);
+        auto * st    = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, rank, nb), 0.0f);
+        auto * ctxv  = block_cols(f_rnn, 0);
+        auto * idtab = ggml_reshape_2d(ctx0, model.dspark_out_sub_ids, 1, n_sub);
+        auto * rows  = zrow;
+        ggml_tensor * prev = ids;
+        for (int64_t i = 1; i <= n_chain; ++i) {
+            auto * hid = block_cols(cur, i);
+            auto * w1  = ggml_get_rows(ctx0, i == 1 ? model.dspark_markov_w1 : model.dspark_markov_w1_sub, prev);
+            auto * joint = ggml_concat(ctx0, ggml_concat(ctx0, st, w1, 0), ggml_concat(ctx0, hid, ctxv, 0), 0);
+            joint = ggml_add(ctx0, build_lora_mm(model.dspark_joint_proj, joint), model.dspark_joint_proj_b);
+            const auto chunk = [&](int64_t j) {
+                return ggml_cont(ctx0, ggml_view_2d(ctx0, joint, rank, joint->ne[1], joint->nb[1], j*rank*joint->nb[0]));
+            };
+            auto * gate = ggml_sigmoid(ctx0, chunk(0));
+            auto * cand = ggml_tanh(ctx0, chunk(1));
+            st = ggml_add(ctx0, cand, ggml_mul(ctx0, gate, ggml_sub(ctx0, st, cand)));
+            auto * corr = ggml_add(ctx0, build_lora_mm(model.dspark_hidden_out, ggml_tanh(ctx0, chunk(2))), model.dspark_hidden_out_b);
+            auto * lg = build_lora_mm(model.dspark_out_sub, ggml_add(ctx0, hid, corr));   // softcap is monotone: skipped
+            ggml_prec_set_acc(lg, GGML_PREC_F32);
+            prev = ggml_argmax(ctx0, lg);                                                  // subset index
+            auto * idf = ggml_get_rows(ctx0, idtab, prev);                                 // [1, nb] full id as f32
+            auto * row = ggml_pad(ctx0, ggml_concat(ctx0, st, idf, 0), n_embd - rank - 1, 0, 0, 0);
+            rows = ggml_concat(ctx0, rows, row, 1);
+        }
+        for (int64_t i = n_chain + 1; i < block; ++i) {
+            rows = ggml_concat(ctx0, rows, zrow, 1);
+        }
+        res->t_h_nextn = to_block_order(rows);
+        cb(res->t_h_nextn, "dspark_chain_state", -1);
+        ggml_build_forward_expand(gf, res->t_h_nextn);
+        res->t_logits = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.n_vocab_unpadded, n_tokens), 0.0f);
+        return;
+    }
     auto * state = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, rank, nb), 0.0f);
     auto * states = ggml_pad(ctx0, state, n_embd - rank, 0, 0, 0);
     const auto column = [&](ggml_tensor * t, int64_t i) {
