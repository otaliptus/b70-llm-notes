--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1380,6 +1380,9 @@ struct common_speculative_impl_draft_dspark final : public common_speculative_im
     // which come back from the injection and are kept per sequence, indexed by position
     bool    has_rnn_context = false;
     int32_t markov_rank     = 0;
+    // reduced-vocabulary drafter (dspark_out_sub): the graph returns the draft ids in element markov_rank of each
+    // position's chain-state row instead of full logits
+    bool    sub_ids         = false;
 
     size_t context_rows = 0;
     std::vector<float>     context_embd;
@@ -1412,6 +1415,8 @@ struct common_speculative_impl_draft_dspark final : public common_speculative_im
             char buf[32] = {};
             has_rnn_context = llama_model_meta_val_str(model_dft, "dflash.dspark.markov_rank", buf, sizeof(buf)) >= 0;
             markov_rank = has_rnn_context ? std::atoi(buf) : 0;
+            const char * e = getenv("LLAMA_DSPARK_SUB");
+            sub_ids = has_rnn_context && llama_model_meta_val_str(model_dft, "dflash.dspark.sub_vocab", buf, sizeof(buf)) >= 0 && (!e || std::atoi(e) != 0);
         }
 
         if (has_rnn_context) {
@@ -1511,7 +1516,8 @@ public:
             i_block_beg[seq_id] = batch.size();
             n_block    [seq_id] = n_block_tokens;
             for (int32_t i = 0; i < n_block_tokens; ++i) {
-                const int32_t idx = batch.add(i == 0 ? dp.id_last : mask_token_id, n + i, seq_id, true);
+                // with draft ids in the state rows only position 0 needs a logits row (no full-vocabulary copies)
+                const int32_t idx = batch.add(i == 0 ? dp.id_last : mask_token_id, n + i, seq_id, !sub_ids || i == 0);
                 if (has_rnn_context) {
                     // the context features of the committed anchor condition the recurrent head
                     const llama_pos pos = dp.pos0 - 1;
@@ -1548,6 +1554,18 @@ public:
 
             auto & result = *dp.result;
 
+            if (sub_ids) {
+                const float * rows = llama_get_embeddings_nextn(ctx_dft);
+                if (!rows) {
+                    LOG_ERR("%s: DSpark draft ids missing (no h_nextn rows)\n", __func__);
+                    continue;
+                }
+                for (int32_t i = 1; i < std::min(n_block_tokens, 1 + params.n_max); ++i) {
+                    result.push_back((llama_token) std::lrintf(rows[(size_t) (beg + i) * n_embd_dec + markov_rank]));
+                }
+                continue;
+            }
+
             // DSpark: read from the first draft slot, truncate below the confidence threshold
             const float * conf = params.p_min > 0.0f ? llama_get_embeddings_nextn(ctx_dft) : nullptr;
             // bonus-anchor drafts read the mask positions only, like DFlash
