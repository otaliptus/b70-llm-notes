From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: b70-notes <b70-notes@users.noreply.github.com>
Date: Fri, 20 Nov 2026 23:40:22 +0000
Subject: [PATCH 3/3] SYCL get_rows (float): row-sized work-groups and an
 ne10-split launch (Inkling rel-pos bias gather overflowed the int range at
 n_kv >= 32k); perf shapes: no K-quant down

---
 ggml/src/ggml-sycl/getrows.cpp | 39 ++++++++++++++++++++++------------
 tests/test-backend-ops.cpp     | 11 +++++++++-
 2 files changed, 36 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-sycl/getrows.cpp b/ggml/src/ggml-sycl/getrows.cpp
index 7b53e3d..b14ed4f 100644
--- a/ggml/src/ggml-sycl/getrows.cpp
+++ b/ggml/src/ggml-sycl/getrows.cpp
@@ -1,3 +1,4 @@
+#include <algorithm>
 //
 // MIT license
 // Copyright (C) 2024 Intel Corporation
@@ -112,12 +113,12 @@ static void k_get_rows_float(
             /*size_t s0,*/ size_t s1, size_t s2, size_t s3,
             /*size_t nb00,*/ size_t nb01, size_t nb02, size_t nb03,
             size_t s10, size_t s11, size_t s12,
-            const sycl::nd_item<3> &item_ct1/*, size_t s13*/) {
+            const sycl::nd_item<3> &item_ct1/*, size_t s13*/, int64_t i10_off = 0) {
 
     const int i00 = item_ct1.get_group(2) * item_ct1.get_local_range(2) +
                     item_ct1.get_local_id(2);
-    const int i10 = item_ct1.get_local_range(1) * item_ct1.get_group(1) +
-                    item_ct1.get_local_id(1);
+    const int64_t i10 = (int64_t) item_ct1.get_local_range(1) * item_ct1.get_group(1) +
+                    item_ct1.get_local_id(1) + i10_off;
     const int i11 = (item_ct1.get_group(0) * item_ct1.get_local_range(0) +
                      item_ct1.get_local_id(0)) /
                     ne12;
@@ -129,7 +130,7 @@ static void k_get_rows_float(
         return;
     }
 
-    const int i01 = src1[i10*s10 + i11*s11 + i12*s12];
+    const int64_t i01 = src1[i10*s10 + i11*s11 + i12*s12];
 
     dst_t * dst_row = dst + i10*s1 + i11*s2 + i12*s3;
     const src0_t * src0_row = (const src0_t *)((const char *)src0 + i01*nb01 + i11*nb02 + i12*nb03);
@@ -388,9 +389,14 @@ static void get_rows_sycl_float(ggml_backend_sycl_context & ctx, const ggml_tens
 
     GGML_TENSOR_BINARY_OP_LOCALS
 
-    const sycl::range<3> block_dims(1, 1, SYCL_GET_ROWS_BLOCK_SIZE);
-    const int block_num_x = (ne00 + SYCL_GET_ROWS_BLOCK_SIZE - 1) / SYCL_GET_ROWS_BLOCK_SIZE;
-    const sycl::range<3> block_nums(ne11 * ne12, ne10, block_num_x);
+    // short rows (e.g. a per-head bias gathered once per (kv, token) pair) get a work-group as wide as the row,
+    // not SYCL_GET_ROWS_BLOCK_SIZE, and the launch is split along ne10 so the global range stays below 2^31
+    int block = SYCL_GET_ROWS_BLOCK_SIZE;
+    while (block > 32 && block / 2 >= ne00) {
+        block /= 2;
+    }
+    const sycl::range<3> block_dims(1, 1, block);
+    const int block_num_x = (ne00 + block - 1) / block;
 
     // strides in elements
     //const size_t s0 = nb0 / ggml_element_size(dst);
@@ -403,16 +409,23 @@ static void get_rows_sycl_float(ggml_backend_sycl_context & ctx, const ggml_tens
     const size_t s12 = nb12 / ggml_element_size(src1);
     //const size_t s13 = nb13 / ggml_element_size(src1);
 
+    const int64_t per_i10   = (int64_t) ne11 * ne12 * block_num_x * block;
+    const int64_t max_i10   = std::max<int64_t>(1, (int64_t) INT32_MAX / std::max<int64_t>(1, per_i10));
+
     {
         dpct::has_capability_or_fail(stream->get_device(),
                                      {sycl::aspect::fp16});
 
-        stream->parallel_for(
-            sycl::nd_range<3>(block_nums * block_dims, block_dims),
-            [=](sycl::nd_item<3> item_ct1) {
-                k_get_rows_float(src0_dd, src1_dd, dst_dd, ne00, ne12, s1, s2,
-                                 s3, nb01, nb02, nb03, s10, s11, s12, item_ct1);
-            });
+        for (int64_t i10_off = 0; i10_off < ne10; i10_off += max_i10) {
+            const int64_t n10 = std::min<int64_t>(max_i10, ne10 - i10_off);
+            const sycl::range<3> block_nums(ne11 * ne12, n10, block_num_x);
+            stream->parallel_for(
+                sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) {
+                    k_get_rows_float(src0_dd, src1_dd, dst_dd, ne00, ne12, s1, s2,
+                                     s3, nb01, nb02, nb03, s10, s11, s12, item_ct1, i10_off);
+                });
+        }
     }
 
     GGML_UNUSED(dst);
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 0b2c09f..1c22ffa 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -14037,14 +14037,23 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         for (ggml_type t : {GGML_TYPE_NVFP4, GGML_TYPE_Q8_0, GGML_TYPE_Q6_K, GGML_TYPE_Q5_K, GGML_TYPE_Q4_K}) {
             for (int n : {1, 8}) {
                 test_cases.emplace_back(new test_mul_mat_id(t, GGML_TYPE_F32, 128, 8, false, 2304, n, 2304)); // gate_up
-                test_cases.emplace_back(new test_mul_mat_id(t, GGML_TYPE_F32, 128, 8, false, 2304, n, 1152)); // down
+                if (ggml_blck_size(t) <= 64) { // K-quants need k % 256 == 0, and k = 1152 is not
+                    test_cases.emplace_back(new test_mul_mat_id(t, GGML_TYPE_F32, 128, 8, false, 2304, n, 1152)); // down
+                }
             }
         }
         for (ggml_type t : {GGML_TYPE_Q8_0, GGML_TYPE_BF16}) {
+            test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, 1024, 1, 2304, {1, 1}, {1, 1})); // k / v
+            test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, 384, 1, 2304, {1, 1}, {1, 1}));  // rel
             test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, 3072, 1, 2304, {1, 1}, {1, 1})); // q / gate
             test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, 2304, 1, 3072, {1, 1}, {1, 1})); // o
             test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, 201024, 1, 2304, {1, 1}, {1, 1})); // lm head
         }
+        // small per-layer ops at decode size (one token, n_embd 2304)
+        test_cases.emplace_back(new test_bin_bcast(ggml_add, GGML_TYPE_F32, {2304, 1, 1, 1}, {1, 1, 1, 1}));
+        test_cases.emplace_back(new test_bin_bcast(ggml_mul, GGML_TYPE_F32, {2304, 1, 1, 1}, {1, 1, 1, 1}));
+        test_cases.emplace_back(new test_rms_norm(GGML_TYPE_F32, {2304, 1, 1, 1}, false, 1e-6f));
+        test_cases.emplace_back(new test_unary(GGML_UNARY_OP_TANH, GGML_TYPE_F32, {1152, 8, 1, 1}, 0));
         return test_cases;
     }
 
-- 
