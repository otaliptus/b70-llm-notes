+            }
+            if (lane == 0) {
+                oov_fold_scale[(int64_t)b * max_oov + dst] = sc;
+                if (b == 0) oov_fold_b[dst] = yr[rank];
+            }
+        });
+    });
+    return 0;
+    NS_CATCH
+}
+
+static int fold_pick_i8_impl(ns_gpu* g, const int32_t* fold_i8, const float* fold_scale, const float* fold_b, const float* base,
+                             const int32_t* oov_fold_i8, const float* oov_fold_scale, const float* oov_fold_b, const float* base_oov,
+                             int64_t n_oov_host, int64_t oov_stride, const Ink2sDraftParams* params,
+                             const float* latent, int64_t vocab, int64_t vp_pad, int64_t rank, float cap, void* scratch, int32_t* out,
+                             float* prob, int32_t* stop, float pmin, const int32_t* full_ids) {
+    NS_TRY
+    constexpr int NWG = 64, W = 256, NSG = W / SG;
+    if (rank <= 0 || rank > 1024 || (rank & 31) != 0) return ns_fail("ns_ink2s_fold_pick_i8: unsupported rank");
+    const int nb = (int)(rank / 32);
+    float* sm_out = (float*) scratch;
+    float* ss_out = sm_out + NWG;
+    int32_t* si_out = (int32_t*) (ss_out + NWG);
+    g->q.submit([&](sycl::handler& h) {
+        sycl::local_accessor<int32_t, 1> lq(sycl::range<1>(256), h);
+        sycl::local_accessor<float, 1> lsc(sycl::range<1>(32), h);
+        sycl::local_accessor<float, 1> bv(sycl::range<1>(NSG), h);
+        sycl::local_accessor<float, 1> bs(sycl::range<1>(NSG), h);
+        sycl::local_accessor<int, 1> bi(sycl::range<1>(NSG), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) NWG * W), sycl::range<1>(W)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            if (stop && stop[0]) return;
+            const int wg = (int) it.get_group(0);
+            const int tid = (int) it.get_local_id(0);
+            const int64_t gid = (int64_t) wg * W + tid;
+            auto sg = it.get_sub_group();
+            const int lane = (int) sg.get_local_linear_id(), sgi = (int) sg.get_group_linear_id();
+            int32_t* lqp = lq.get_multi_ptr<sycl::access::decorated::no>().get();
+            int8_t* lqb = (int8_t*) lqp;
+            float* lscp = lsc.get_multi_ptr<sycl::access::decorated::no>().get();
+            for (int b = sgi; b < nb; b += NSG) {
+                const float a = latent[b * 32 + lane * 2], c = latent[b * 32 + lane * 2 + 1];
+                const float amax = sycl::reduce_over_group(sg, sycl::fmax(sycl::fabs(a), sycl::fabs(c)), sycl::maximum<float>());
+                const float sc = amax / 127.0f;
+                const float isc = sc != 0.0f ? 1.0f / sc : 0.0f;
+                int qa = (int) sycl::round(a * isc), qc = (int) sycl::round(c * isc);
+                lqb[b * 32 + lane * 2] = (int8_t) (qa > 127 ? 127 : (qa < -127 ? -127 : qa));
+                lqb[b * 32 + lane * 2 + 1] = (int8_t) (qc > 127 ? 127 : (qc < -127 ? -127 : qc));
+                if (lane == 0) lscp[b] = sc;
+            }
+            sycl::group_barrier(it.get_group());
+            float best = -INFINITY, se = 0.0f;
+            int at = 0x7FFFFFFF;
+            for (int64_t v = gid; v < vocab; v += (int64_t) NWG * W) {
+                float bias_v = 0.0f;
+                const int32_t* wp = fold_i8 + v;
+                for (int b = 0; b < nb; ++b) {
+                    int dot = 0;
+                    const int64_t k0 = (int64_t) b * 8;
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        dot = dpct::dp4a(wp[(k0 + j) * vp_pad], lqp[k0 + j], dot);
+                    }
+                    bias_v = sycl::fma((float) dot, fold_scale[(int64_t) b * vp_pad + v] * lscp[b], bias_v);
+                }
+                float val = base[v] + rbf(fold_b[v] + bias_v);
+                if (cap > 0.0f) val = cap * sycl::tanh(val / cap);
+                if (val > best) {
+                    se = se * sycl::exp(best - val) + 1.0f;
+                    best = val;
+                    at = (int) v;
+                } else {
+                    se += sycl::exp(val - best);
+                }
+            }
+            const int64_t n_oov = (oov_fold_i8 && base_oov) ? (params ? (int64_t) params->n_oov : n_oov_host) : 0;
+            for (int64_t r = gid; r < n_oov; r += (int64_t) NWG * W) {
+                float bias_v = 0.0f;
+                const int32_t* wp = oov_fold_i8 + r;
+                for (int b = 0; b < nb; ++b) {
+                    int dot = 0;
+                    const int64_t k0 = (int64_t) b * 8;
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        dot = dpct::dp4a(wp[(k0 + j) * oov_stride], lqp[k0 + j], dot);
+                    }
+                    bias_v = sycl::fma((float) dot, oov_fold_scale[(int64_t) b * oov_stride + r] * lscp[b], bias_v);
+                }
+                float val = base_oov[r] + rbf(oov_fold_b[r] + bias_v);
+                if (cap > 0.0f) val = cap * sycl::tanh(val / cap);
+                if (val > best) {
+                    se = se * sycl::exp(best - val) + 1.0f;
+                    best = val;
+                    at = (int) (vocab + r);
+                } else {
+                    se += sycl::exp(val - best);
+                }
+            }
+            const float m = sycl::reduce_over_group(sg, best, sycl::maximum<float>());
+            const int a = sycl::reduce_over_group(sg, best == m ? at : 0x7FFFFFFF, sycl::minimum<int>());
+            const float sm = sycl::reduce_over_group(sg, best > -INFINITY ? se * sycl::exp(best - m) : 0.0f, sycl::plus<float>());
+            if (sg.get_local_linear_id() == 0) {
+                bv[sg.get_group_linear_id()] = m;
+                bs[sg.get_group_linear_id()] = sm;
+                bi[sg.get_group_linear_id()] = a;
+            }
+            sycl::group_barrier(it.get_group());
+            if (tid == 0) {
+                float m2 = -INFINITY;
+                int a2 = 0x7FFFFFFF;
+                for (int s = 0; s < NSG; ++s)
+                    if (bv[s] > m2 || (bv[s] == m2 && bi[s] < a2)) {
+                        m2 = bv[s];
+                        a2 = bi[s];
+                    }
+                float st = 0.0f;
+                for (int s = 0; s < NSG; ++s)
+                    if (bv[s] > -INFINITY) st += bs[s] * sycl::exp(bv[s] - m2);
+                sm_out[wg] = m2;
+                ss_out[wg] = st;
+                si_out[wg] = a2;
+            }
+        });
+    });
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>(NWG), sycl::range<1>(NWG)),
+                      [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+        const int tid = (int) it.get_local_id(0);
+        if (stop && stop[0]) {
+            if (tid == 0) {
+                out[0] = 0;
+                if (prob) prob[0] = 0.0f;
+            }
+            return;
+        }
+        const float mv = sm_out[tid];
+        const float sv = ss_out[tid];
+        const int iv = si_out[tid];
+        const float m2 = sycl::reduce_over_group(it.get_group(), mv, sycl::maximum<float>());
+        const int a2 = sycl::reduce_over_group(it.get_group(), mv == m2 ? iv : 0x7FFFFFFF, sycl::minimum<int>());
+        const float st = sycl::reduce_over_group(it.get_group(), mv > -INFINITY ? sv * sycl::exp(mv - m2) : 0.0f, sycl::plus<float>());
+        if (tid == 0) {
+            const float p = st > 0.0f ? 1.0f / st : 0.0f;
+            out[0] = full_ids ? full_ids[a2] : a2;
+            if (prob) prob[0] = p;
+            if (stop && p < pmin) stop[0] = 1;
+        }
+    });
+    return 0;
+    NS_CATCH
+}
+
+int ns_ink2s_fold_pick_i8(ns_gpu* g, const int32_t* fold_i8, const float* fold_scale, const float* fold_b, const float* base,
+                          const float* latent, int64_t vocab, int64_t vp_pad, int64_t rank, float cap, void* scratch, int32_t* out,
+                          float* prob, int32_t* stop, float pmin, const int32_t* full_ids) {
+    return fold_pick_i8_impl(g, fold_i8, fold_scale, fold_b, base, nullptr, nullptr, nullptr, nullptr, 0, 0, nullptr,
+                             latent, vocab, vp_pad, rank, cap, scratch, out, prob, stop, pmin, full_ids);
+}
+
+int ns_ink2s_fold_pick_i8_oov(ns_gpu* g, const int32_t* fold_i8, const float* fold_scale, const float* fold_b, const float* base,
+                              const int32_t* oov_fold_i8, const float* oov_fold_scale, const float* oov_fold_b, const float* base_oov,
+                              int64_t n_oov_host, int64_t oov_stride, const Ink2sDraftParams* params,
+                              const float* latent, int64_t vocab, int64_t vp_pad, int64_t rank, float cap, void* scratch, int32_t* out,
+                              float* prob, int32_t* stop, float pmin, const int32_t* full_ids) {
+    return fold_pick_i8_impl(g, fold_i8, fold_scale, fold_b, base, oov_fold_i8, oov_fold_scale, oov_fold_b, base_oov,
+                             n_oov_host, oov_stride, params, latent, vocab, vp_pad, rank, cap, scratch, out, prob, stop, pmin, full_ids);
+}
+
+static int fold_sample_i8_impl(ns_gpu* g, const int32_t* fold_i8, const float* fold_scale, const float* fold_b, const float* base,
+                               const int32_t* oov_fold_i8, const float* oov_fold_scale, const float* oov_fold_b, const float* base_oov,
+                               int64_t n_oov_host, int64_t oov_stride,
+                               const float* latent, int64_t vocab, int64_t full_vocab, int64_t vp_pad, int64_t rank, float cap,
+                               float temperature_host, uint64_t seed_host, int64_t pos_host, const Ink2sDraftParams* params, int64_t j_off,
+                               float* logits_buf, float* scratch, const int32_t* tile_off, const int32_t* tile_idx, int32_t* out,
+                               float* prob, int32_t* stop, float pmin, const int32_t* full_ids) {
+    NS_TRY
+    constexpr int NWG = 64, W = 256, NSG = W / SG, TILE = 1024, SPAN = TILE / W;
+    const int64_t tiles = (full_vocab + TILE - 1) / TILE;
+    if (rank <= 0 || rank > 1024 || (rank & 31) != 0 || tiles < 1 || tiles > W || (!params && !(temperature_host > 0.0f)))
+        return ns_fail("ns_ink2s_fold_sample_i8: unsupported shape");
+    const int nb = (int)(rank / 32);
+    // Pass 1: compute all draft logits into logits_buf [vocab + n_oov] and per-WG maxima into scratch [NWG].
+    g->q.submit([&](sycl::handler& h) {
+        sycl::local_accessor<int32_t, 1> lq(sycl::range<1>(256), h);
+        sycl::local_accessor<float, 1> lsc(sycl::range<1>(32), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) NWG * W), sycl::range<1>(W)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            if (stop && stop[0]) return;
+            const int wg = (int) it.get_group(0);
+            const int tid = (int) it.get_local_id(0);
+            const int64_t gid = (int64_t) wg * W + tid;
+            auto sg = it.get_sub_group();
+            const int lane = (int) sg.get_local_linear_id(), sgi = (int) sg.get_group_linear_id();
+            int32_t* lqp = lq.get_multi_ptr<sycl::access::decorated::no>().get();
+            int8_t* lqb = (int8_t*) lqp;
+            float* lscp = lsc.get_multi_ptr<sycl::access::decorated::no>().get();
+            for (int b = sgi; b < nb; b += NSG) {
+                const float a = latent[b * 32 + lane * 2], c = latent[b * 32 + lane * 2 + 1];
+                const float amax = sycl::reduce_over_group(sg, sycl::fmax(sycl::fabs(a), sycl::fabs(c)), sycl::maximum<float>());
+                const float sc = amax / 127.0f;
+                const float isc = sc != 0.0f ? 1.0f / sc : 0.0f;
+                int qa = (int) sycl::round(a * isc), qc = (int) sycl::round(c * isc);
+                lqb[b * 32 + lane * 2] = (int8_t) (qa > 127 ? 127 : (qa < -127 ? -127 : qa));
+                lqb[b * 32 + lane * 2 + 1] = (int8_t) (qc > 127 ? 127 : (qc < -127 ? -127 : qc));
+                if (lane == 0) lscp[b] = sc;
+            }
+            sycl::group_barrier(it.get_group());
+            float best = -INFINITY;
+            for (int64_t v = gid; v < vocab; v += (int64_t) NWG * W) {
+                float bias_v = 0.0f;
+                const int32_t* wp = fold_i8 + v;
+                for (int b = 0; b < nb; ++b) {
+                    int dot = 0;
+                    const int64_t k0 = (int64_t) b * 8;
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        dot = dpct::dp4a(wp[(k0 + j) * vp_pad], lqp[k0 + j], dot);
+                    }
+                    bias_v = sycl::fma((float) dot, fold_scale[(int64_t) b * vp_pad + v] * lscp[b], bias_v);
+                }
+                float val = base[v] + rbf(fold_b[v] + bias_v);
+                if (cap > 0.0f) val = cap * sycl::tanh(val / cap);
+                logits_buf[v] = val;
+                best = sycl::fmax(best, val);
+            }
+            const int64_t n_oov = (oov_fold_i8 && base_oov) ? (params ? (int64_t) params->n_oov : n_oov_host) : 0;
+            for (int64_t r = gid; r < n_oov; r += (int64_t) NWG * W) {
+                float bias_v = 0.0f;
+                const int32_t* wp = oov_fold_i8 + r;
+                for (int b = 0; b < nb; ++b) {
+                    int dot = 0;
+                    const int64_t k0 = (int64_t) b * 8;
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        dot = dpct::dp4a(wp[(k0 + j) * oov_stride], lqp[k0 + j], dot);
+                    }
+                    bias_v = sycl::fma((float) dot, oov_fold_scale[(int64_t) b * oov_stride + r] * lscp[b], bias_v);
+                }
+                float val = base_oov[r] + rbf(oov_fold_b[r] + bias_v);
+                if (cap > 0.0f) val = cap * sycl::tanh(val / cap);
+                logits_buf[vocab + r] = val;
+                best = sycl::fmax(best, val);
+            }
+            const float m = sycl::reduce_over_group(it.get_group(), best, sycl::maximum<float>());
+            if (tid == 0) scratch[wg] = m;
+        });
+    });
+    // Pass 2: `tiles` WGs of 64 threads compute each tile's probability mass in parallel (all Xe-cores busy, zero atomics).
+    float* tile_mass_buf = scratch + NWG;
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) tiles * NWG), sycl::range<1>(NWG)),
+                      [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+        if (stop && stop[0]) return;
+        const auto grp = it.get_group();
+        const int tid = (int) it.get_local_id(0);
+        const int t = (int) it.get_group(0);
+        const float m = sycl::reduce_over_group(grp, scratch[tid], sycl::maximum<float>());
+        const float temp = params ? params->temperature : temperature_host;
+        const float inv_t = 1.0f / temp;
+        const int beg = tile_off[t], end = tile_off[t + 1];
+        float s = 0.0f;
+        for (int idx = beg + tid; idx < end; idx += NWG) {
+            s += sycl::exp((logits_buf[tile_idx[idx]] - m) * inv_t);
+        }
+        s = sycl::reduce_over_group(grp, s, sycl::plus<float>());
+        if (tid == 0) tile_mass_buf[t] = s;
+    });
+    // Pass 3: 1 WG of 256 threads performs exact hierarchical inverse-CDF draw matching ns_ink2_sample_full.
+    g->q.submit([&](sycl::handler& h) {
+        sycl::local_accessor<float, 1> span_w(sycl::range<1>(TILE), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>(W), sycl::range<1>(W)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            const auto grp = it.get_group();
+            const int lane = (int) it.get_local_id(0);
+            if (stop && stop[0]) {
+                if (lane == 0) {
+                    out[0] = 0;
+                    if (prob) prob[0] = 0.0f;
+                }
+                return;
+            }
+            float* sw = span_w.get_multi_ptr<sycl::access::decorated::no>().get();
+            const float temp = params ? params->temperature : temperature_host;
+            const uint64_t seed = params ? params->seed : seed_host;
+            const int64_t pos = params ? (params->p0 + j_off) : pos_host;
+            const float inv_t = 1.0f / temp;
+            const float my_mass = lane < tiles ? tile_mass_buf[lane] : 0.0f;
+            auto uniform = [&](uint64_t draw) {
+                uint64_t z = seed + 0x9e3779b97f4a7c15ULL * (2 * (uint64_t) pos + draw + 1);
+                z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+                z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+                return (float) ((z ^ (z >> 31)) >> 40) * 0x1p-24f;
+            };
+            auto choose_lane = [&](float s, float u, float& total_out, float& hi_out) {
+                const float end = sycl::inclusive_scan_over_group(grp, s, sycl::plus<float>());
+                const float total = sycl::group_broadcast(grp, end, W - 1);
+                total_out = total;
+                const float cut = sycl::fmin(u * total, sycl::nextafter(total, 0.0f));
+                const int pick = sycl::reduce_over_group(grp, s > 0.0f && end > cut ? lane : W, sycl::minimum<int>());
+                const int p = sycl::min(pick, W - 1);
+                hi_out = sycl::group_broadcast(grp, end, p);
+                return p;
+            };
+            const float u0 = uniform(0);
+            float total_mass = 0.0f, chosen_end = 0.0f;
+            const int chosen_tile = choose_lane(my_mass, u0, total_mass, chosen_end);
+            const float chosen_mass = sycl::group_broadcast(grp, my_mass, chosen_tile);
+#pragma unroll
+            for (int j = 0; j < SPAN; ++j) sw[lane + j * W] = -INFINITY;
+            sycl::group_barrier(grp);
+            const int cbeg = tile_off[chosen_tile], cend = tile_off[chosen_tile + 1];
+            for (int idx = cbeg + lane; idx < cend; idx += W) {
+                const int v = tile_idx[idx];
+                const int fid = full_ids ? full_ids[v] : v;
+                sw[fid & (TILE - 1)] = logits_buf[v];
+            }
+            sycl::group_barrier(grp);
+            float tmx_l = -INFINITY;
+#pragma unroll
+            for (int j = 0; j < SPAN; ++j) tmx_l = sycl::fmax(tmx_l, sw[lane * SPAN + j]);
+            const float tile_max = sycl::reduce_over_group(grp, tmx_l, sycl::maximum<float>());
+            float weights[SPAN], subtotal = 0.0f;
+#pragma unroll
+            for (int j = 0; j < SPAN; ++j) {
+                const float lv = sw[lane * SPAN + j];
+                weights[j] = sycl::isfinite(lv) ? sycl::exp((lv - tile_max) * inv_t) : 0.0f;
+                subtotal += weights[j];
+            }
+            const float u1 = uniform(0x4000000000000000ULL);
+            float tile_sub_total = 0.0f, winner_end = 0.0f;
+            const int winner = choose_lane(subtotal, u1, tile_sub_total, winner_end);
+            if (lane == winner) {
+                const float u2 = uniform(0x6000000000000000ULL);
+                float cut = u2 * subtotal;
+                int selected = 0;
+                float prefix_w = 0.0f;
+                for (int j = 0; j < SPAN; ++j) {
+                    if (weights[j] > 0.0f) selected = j;
+                    if (cut < weights[j]) break;
+                    cut -= weights[j];
+                    prefix_w += weights[j];
+                }
+                const int32_t tok_id = (int32_t) (chosen_tile * TILE + winner * SPAN + selected);
+                out[0] = tok_id;
+                auto level_match = [](float u, float lo, float hi, float alpha) {
+                    const float w = hi - lo;
+                    if (w >= 0.9999f) return 1.0f;
+                    if (w <= 0.0f) return 0.0f;
+                    const float mid = 0.5f * (lo + hi);
+                    const float sig = alpha * sycl::sqrt(sycl::fmax(0.0f, mid * (1.0f - mid))) + 0.012f;
+                    const float inv_s = 1.0f / (1.41421356f * sig);
+                    const float cdf_hi = (hi >= 1.0f - 1e-6f) ? 1.0f : (0.5f + 0.5f * sycl::erf((hi - u) * inv_s));
+                    const float cdf_lo = (lo <= 1e-6f) ? 0.0f : (0.5f + 0.5f * sycl::erf((lo - u) * inv_s));
+                    return sycl::fmax(0.0f, cdf_hi - cdf_lo);
+                };
+                const float tile_p = total_mass > 0.0f ? chosen_mass / total_mass : 0.0f;
+                const float tile_hi = total_mass > 0.0f ? chosen_end / total_mass : 1.0f;
+                const float tile_lo = sycl::fmax(0.0f, tile_hi - tile_p);
+                const float span_p = tile_sub_total > 0.0f ? subtotal / tile_sub_total : 0.0f;
+                const float span_hi = tile_sub_total > 0.0f ? winner_end / tile_sub_total : 1.0f;
+                const float span_lo = sycl::fmax(0.0f, span_hi - span_p);
+                const float tok_p = subtotal > 0.0f ? weights[selected] / subtotal : 0.0f;
+                const float tok_lo = subtotal > 0.0f ? prefix_w / subtotal : 0.0f;
+                const float tok_hi = sycl::fmin(1.0f, tok_lo + tok_p);
+                const float p_tok = tile_sub_total > 0.0f ? tile_p * (weights[selected] / tile_sub_total) : 0.0f;
+                const float p_cdf = level_match(u0, tile_lo, tile_hi, 0.20f)
+                                  * level_match(u1, span_lo, span_hi, 0.20f)
+                                  * level_match(u2, tok_lo, tok_hi, 0.20f);
+                const float p_match = sycl::sqrt(sycl::fmax(0.0f, p_cdf * p_tok));
+                if (prob) prob[0] = p_match;
+                if (stop && p_match < pmin) stop[0] = 1;
+            }
+        });
+    });
+    return 0;
+    NS_CATCH
+}
