+
+inline void run(sycl::queue& queue, const float* q, const half* keys, const half* values, float* part,
+                int T, int Hq, int Hkv, int cap, int ns, int prefix, float scale) {
+    if (T == 1) {
+        if (prefix >= 256) {
+            fused_esimd_t1<4>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+        } else {
+            dot<4, 2>(queue, q, keys, part, T, Hq, Hkv, cap, ns, prefix, scale);
+            value<false>(queue, values, part, T, Hq, Hkv, cap, ns, prefix);
+        }
+    } else if (T == 2) {
+        fused_esimd<8, 2, 3>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    } else if (T == 3) {
+        fused_esimd<16, 4, 5>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    } else if (T == 4) {
+        fused_esimd<16, 4, 6>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    } else if (T == 5) {
+        fused_esimd<16, 4, 8>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    } else if (T == 6) {
+        fused_esimd_24<4, 4, 9>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    } else if (T == 7) {
+        fused_esimd_24<4, 8, 11>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    } else {
+        fused_esimd_24<4, 8, 12>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns, prefix, scale);
+    }
+}
+
+inline void run_p0(sycl::queue& queue, const float* q, const half* keys, const half* values, float* part,
+                   int T, int Hq, int Hkv, int cap, int ns_stride, int E_arg, const int64_t* p0_dev, float scale) {
+    if (T == 1) {
+        if (ns_stride >= 256) {
+            fused_esimd_t1<4, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+        } else {
+            dot<4, 2, true>(queue, q, keys, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+            value<false, true>(queue, values, part, T, Hq, Hkv, cap, ns_stride, 0, p0_dev, E_arg);
+        }
+    } else if (T == 2) {
+        fused_esimd<8, 2, 3, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    } else if (T == 3) {
+        fused_esimd<16, 4, 5, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    } else if (T == 4) {
+        fused_esimd<16, 4, 6, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    } else if (T == 5) {
+        fused_esimd<16, 4, 8, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    } else if (T == 6) {
+        fused_esimd_24<4, 4, 9, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    } else if (T == 7) {
+        fused_esimd_24<4, 8, 11, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    } else {
+        fused_esimd_24<4, 8, 12, true>(queue, q, keys, values, part, T, Hq, Hkv, cap, ns_stride, 0, scale, p0_dev, E_arg);
+    }
+}
