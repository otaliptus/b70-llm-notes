+        for (int64_t i = lane; i < tiles; i += W) mass += parts[2 * i + 1] * sycl::exp((parts[2 * i] - m) / temperature);
+        auto choose_lane = [&](float s, float u) {
+            const float end = sycl::inclusive_scan_over_group(group, s, sycl::plus<float>());
+            const float total = sycl::group_broadcast(group, end, W - 1);
+            const float cut = sycl::fmin(u * total, sycl::nextafter(total, 0.0f));
+            const int pick = sycl::reduce_over_group(group, s > 0.0f && end > cut ? lane : W, sycl::minimum<int>());
+            return sycl::min(pick, W - 1);
+        };
+        const int owner = choose_lane(mass, uniform(0));
+        int tile = owner;
+        if (tiles > W && lane == owner) {
+            float cut = uniform(1) * mass;
+            for (int64_t i = owner; i < tiles; i += W) {
+                float p = parts[2 * i + 1] * sycl::exp((parts[2 * i] - m) / temperature);
+                if (p > 0.0f) tile = (int)i;
+                if (cut < p) break;
+                cut -= p;
+            }
+        }
+        tile = sycl::group_broadcast(group, tile, owner);
+        const float tile_max = parts[2 * tile];
+        const float* x = gptr(raw) + row * ld;
+        constexpr int SPAN = TILE / W;
+        const int64_t start = (int64_t)tile * TILE + lane * SPAN;
+        float weights[SPAN], subtotal = 0.0f;
+#pragma unroll
+        for (int j = 0; j < SPAN; ++j) {
+            if (start + j < vocab) {
+                const float r = x[start + j];
+                const float v = cap > 0.0f ? cap * sycl::tanh(r * inv_cap) : r;
+                weights[j] = sycl::exp((v - tile_max) / temperature);
+            } else {
+                weights[j] = 0.0f;
+            }
+            subtotal += weights[j];
+        }
+        const int winner = choose_lane(subtotal, uniform(0x4000000000000000ULL));
+        if (lane == winner) {
+            float cut = uniform(0x6000000000000000ULL) * subtotal;
+            int selected = 0;
+            for (int j = 0; j < SPAN; ++j) {
+                if (weights[j] > 0.0f) selected = j;
+                if (cut < weights[j]) break;
+                cut -= weights[j];
+            }
+            gptr(out)[row] = (int32_t)(start + selected);
+        }
+    });
+    return 0;
+    NS_CATCH
+}
