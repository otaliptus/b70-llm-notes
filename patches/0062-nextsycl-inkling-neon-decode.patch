diff --git a/kernels/llm/inkling2/silo/q8_head.hpp b/kernels/llm/inkling2/silo/q8_head.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..e48295ec5492637b141ad878a791aa02f4f133bd
--- /dev/null
+++ b/kernels/llm/inkling2/silo/q8_head.hpp
@@ -0,0 +1,225 @@
+// Dense Q8_0 large output heads (rows >= 16384) on Xe2 using XMX DPAS (T = 1..8).
+// Each 8-lane work-group computes 16 output rows (handling partial tail tiles cleanly).
+// DPAS evaluates two 16-value dot products per activation block, using a zero half in each
+// operand row, and reduces 16 half-lane sums in the exact binary-tree order of mv_t.
+// For T = 5..8, two DPAS passes share the loaded weight tile and scales in registers (1.0x weight reads).
+#pragma once
+
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+#include <cstdint>
+
+namespace q8_head {
+namespace es = sycl::ext::intel::esimd;
+namespace xmx = es::xmx;
+
+template <int T>
+inline void submit_small(sycl::queue& queue, const void* weight, const void* input, float* output,
+                         int rows, int columns) {
+    static_assert(T >= 1 && T <= 4);
+    constexpr int N = 16, workers = 8, halves = 2 * T;
+    const int blocks = columns / 32;
+    const int total_tiles = (rows + N - 1) / N;
+    const auto* quants = static_cast<const uint32_t*>(weight);
+    const auto* scales = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(weight) +
+                                                            ns_ink2s_scales_at(8, rows, columns));
+    const auto* acts = static_cast<const int*>(input);
+    const auto* act_scales = reinterpret_cast<const float*>(static_cast<const uint8_t*>(input) +
+                                                            ns_ink2s_xq_scales_at(T, columns));
+    auto props = sycl::ext::oneapi::experimental::properties{
+        sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t(total_tiles) * workers, workers), props,
+                       [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<workers * halves * N * sizeof(float)>();
+        const int tile = it.get_group_linear_id();
+        const int lane = it.get_local_id(0);
+        const int r0 = tile * N;
+        const int nr = (r0 + N <= rows) ? N : (rows - r0);
+        const uint32_t* q_tile = quants + size_t(r0) * columns / 4;
+        const uint16_t* s_tile = scales + size_t(r0) * blocks;
+
+        es::simd<uint32_t, N> ridx(0, 1);
+        ridx = es::min<uint32_t>(ridx, es::simd<uint32_t, N>(uint32_t(nr - 1)));
+        const es::simd<uint32_t, N> row_scale_off = ridx * uint32_t(blocks * 2);
+
+        es::simd<float, halves * N> accum(0.0f);
+        for (int block = lane; block < blocks; block += workers) {
+            es::simd<int, 8 * N> rhs = es::load_2d<uint32_t, 8, N, 1, true>(
+                q_tile, columns - 1, nr - 1, columns - 1, 8 * block, 0);
+            auto bits = es::gather<uint16_t, N>(s_tile, row_scale_off + uint32_t(block * 2));
+            es::simd<float, N> w_scale = es::simd<sycl::half, N>(bits.template bit_cast_view<sycl::half>());
+            es::simd<int, halves * 8> lhs(0);
+            float x_scale[T];
+#pragma unroll
+            for (int t = 0; t < T; ++t) {
+                const size_t index = size_t(t) * blocks + block;
+                auto bytes = es::block_load<int, 8>(acts + index * 8);
+                lhs.template select<4, 1>(t * 16) = bytes.template select<4, 1>(0);
+                lhs.template select<4, 1>(t * 16 + 12) = bytes.template select<4, 1>(4);
+                x_scale[t] = act_scales[index];
+            }
+            auto products = xmx::dpas<8, halves, int, int, int, int,
+                xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                    es::simd<int, halves * N>(0), rhs, lhs);
+#pragma unroll
+            for (int h = 0; h < halves; ++h) {
+                es::simd<float, N> dot = es::simd<int, N>(products.template select<N, 1>(h * N));
+                es::simd<float, N> scale = w_scale * x_scale[h / 2];
+                es::simd<float, N> old = accum.template select<N, 1>(h * N);
+                accum.template select<N, 1>(h * N) =
+                    es::simd<float, N>(__builtin_elementwise_fma(dot.data(), scale.data(), old.data()));
+            }
+        }
+#pragma unroll
+        for (int h = 0; h < halves; ++h)
+            es::slm_block_store<float, N>(uint32_t((lane * halves + h) * N * sizeof(float)),
+                                          accum.template select<N, 1>(h * N));
+        es::barrier();
+        if (lane < T) {
+            es::simd<float, N> partial[16];
+#pragma unroll
+            for (int i = 0; i < 16; ++i)
+                partial[i] = es::slm_block_load<float, N>(
+                    ((i / 2 * halves + lane * 2 + i % 2) * N) * sizeof(float));
+#pragma unroll
+            for (int stride = 8; stride; stride >>= 1)
+#pragma unroll
+                for (int i = 0; i < stride; ++i) partial[i] += partial[i + stride];
+            float* dst = output + size_t(lane) * rows + r0;
+            if (nr == N) {
+                es::block_store<float, N>(dst, partial[0]);
+            } else {
+                for (int r = 0; r < nr; ++r) dst[r] = partial[0][r];
+            }
+        }
+    });
+}
+
+template <int T>
+inline void submit_wide(sycl::queue& queue, const void* weight, const void* input, float* output,
+                        int rows, int columns) {
+    static_assert(T >= 5 && T <= 8);
+    constexpr int N = 16, workers = 8, T0 = 4, T1 = T - 4;
+    constexpr int H0 = 2 * T0, H1 = 2 * T1, H = 2 * T;
+    const int blocks = columns / 32;
+    const int total_tiles = (rows + N - 1) / N;
+    const auto* quants = static_cast<const uint32_t*>(weight);
+    const auto* scales = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(weight) +
+                                                            ns_ink2s_scales_at(8, rows, columns));
+    const auto* acts = static_cast<const int*>(input);
+    const auto* act_scales = reinterpret_cast<const float*>(static_cast<const uint8_t*>(input) +
+                                                            ns_ink2s_xq_scales_at(T, columns));
+    auto props = sycl::ext::oneapi::experimental::properties{
+        sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t(total_tiles) * workers, workers), props,
+                       [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<workers * H * N * sizeof(float)>();
+        const int tile = it.get_group_linear_id();
+        const int lane = it.get_local_id(0);
+        const int r0 = tile * N;
+        const int nr = (r0 + N <= rows) ? N : (rows - r0);
+        const uint32_t* q_tile = quants + size_t(r0) * columns / 4;
+        const uint16_t* s_tile = scales + size_t(r0) * blocks;
+
+        es::simd<uint32_t, N> ridx(0, 1);
+        ridx = es::min<uint32_t>(ridx, es::simd<uint32_t, N>(uint32_t(nr - 1)));
+        const es::simd<uint32_t, N> row_scale_off = ridx * uint32_t(blocks * 2);
+
+        es::simd<float, H0 * N> acc0(0.0f);
+        es::simd<float, H1 * N> acc1(0.0f);
+        for (int block = lane; block < blocks; block += workers) {
+            es::simd<int, 8 * N> rhs = es::load_2d<uint32_t, 8, N, 1, true>(
+                q_tile, columns - 1, nr - 1, columns - 1, 8 * block, 0);
+            auto bits = es::gather<uint16_t, N>(s_tile, row_scale_off + uint32_t(block * 2));
+            es::simd<float, N> w_scale = es::simd<sycl::half, N>(bits.template bit_cast_view<sycl::half>());
+            {
+                es::simd<int, H0 * 8> lhs0(0);
+                float xs0[T0];
+#pragma unroll
+                for (int t = 0; t < T0; ++t) {
+                    const size_t index = size_t(t) * blocks + block;
+                    auto bytes = es::block_load<int, 8>(acts + index * 8);
+                    lhs0.template select<4, 1>(t * 16) = bytes.template select<4, 1>(0);
+                    lhs0.template select<4, 1>(t * 16 + 12) = bytes.template select<4, 1>(4);
+                    xs0[t] = act_scales[index];
+                }
+                auto p0 = xmx::dpas<8, H0, int, int, int, int,
+                    xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                        es::simd<int, H0 * N>(0), rhs, lhs0);
+#pragma unroll
+                for (int h = 0; h < H0; ++h) {
+                    es::simd<float, N> dot = es::simd<int, N>(p0.template select<N, 1>(h * N));
+                    es::simd<float, N> scale = w_scale * xs0[h / 2];
+                    es::simd<float, N> old = acc0.template select<N, 1>(h * N);
+                    acc0.template select<N, 1>(h * N) =
+                        es::simd<float, N>(__builtin_elementwise_fma(dot.data(), scale.data(), old.data()));
+                }
+            }
+            {
+                es::simd<int, H1 * 8> lhs1(0);
+                float xs1[T1];
+#pragma unroll
+                for (int t = 0; t < T1; ++t) {
+                    const size_t index = size_t(T0 + t) * blocks + block;
+                    auto bytes = es::block_load<int, 8>(acts + index * 8);
+                    lhs1.template select<4, 1>(t * 16) = bytes.template select<4, 1>(0);
+                    lhs1.template select<4, 1>(t * 16 + 12) = bytes.template select<4, 1>(4);
+                    xs1[t] = act_scales[index];
+                }
+                auto p1 = xmx::dpas<8, H1, int, int, int, int,
+                    xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                        es::simd<int, H1 * N>(0), rhs, lhs1);
+#pragma unroll
+                for (int h = 0; h < H1; ++h) {
+                    es::simd<float, N> dot = es::simd<int, N>(p1.template select<N, 1>(h * N));
+                    es::simd<float, N> scale = w_scale * xs1[h / 2];
+                    es::simd<float, N> old = acc1.template select<N, 1>(h * N);
+                    acc1.template select<N, 1>(h * N) =
+                        es::simd<float, N>(__builtin_elementwise_fma(dot.data(), scale.data(), old.data()));
+                }
+            }
+        }
+#pragma unroll
+        for (int h = 0; h < H0; ++h)
+            es::slm_block_store<float, N>(uint32_t((lane * H + h) * N * sizeof(float)),
+                                          acc0.template select<N, 1>(h * N));
+#pragma unroll
+        for (int h = 0; h < H1; ++h)
+            es::slm_block_store<float, N>(uint32_t((lane * H + H0 + h) * N * sizeof(float)),
+                                          acc1.template select<N, 1>(h * N));
+        es::barrier();
+        if (lane < T) {
+            es::simd<float, N> partial[16];
+#pragma unroll
+            for (int i = 0; i < 16; ++i)
+                partial[i] = es::slm_block_load<float, N>(
+                    ((i / 2 * H + lane * 2 + i % 2) * N) * sizeof(float));
+#pragma unroll
+            for (int stride = 8; stride; stride >>= 1)
+#pragma unroll
+                for (int i = 0; i < stride; ++i) partial[i] += partial[i + stride];
+            float* dst = output + size_t(lane) * rows + r0;
+            if (nr == N) {
+                es::block_store<float, N>(dst, partial[0]);
+            } else {
+                for (int r = 0; r < nr; ++r) dst[r] = partial[0][r];
+            }
+        }
+    });
+}
+
+inline void submit(sycl::queue& queue, const void* weight, const void* input, float* output,
+                   int T, int rows, int columns) {
+    switch (T) {
+        case 1: submit_small<1>(queue, weight, input, output, rows, columns); break;
+        case 2: submit_small<2>(queue, weight, input, output, rows, columns); break;
+        case 3: submit_small<3>(queue, weight, input, output, rows, columns); break;
+        case 4: submit_small<4>(queue, weight, input, output, rows, columns); break;
+        case 5: submit_wide<5>(queue, weight, input, output, rows, columns); break;
+        case 6: submit_wide<6>(queue, weight, input, output, rows, columns); break;
+        case 7: submit_wide<7>(queue, weight, input, output, rows, columns); break;
+        default: submit_wide<8>(queue, weight, input, output, rows, columns); break;
+    }
+}
+
+} // namespace q8_head
