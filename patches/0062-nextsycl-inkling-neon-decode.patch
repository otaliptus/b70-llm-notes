+// Single-launch ESIMD FP32 fused dot + exact softmax + value over M consecutive 64-key splits.
+// Overlaps K and V global loads in registers (32 GRFs), keeps Q/P/V in <= 28 KB SLM, eliminates
+// the 38-134 MB/layer logits global memory roundtrip, and preserves exact m6 FP32 FMA order.
+// QH is the compile-time half-query count (branch-free P*V inner loop: 3 for T=2, 5 for T=3, 6 for T=4, 8 for T=5).
+template <int QP, int M, int QH, bool P0_DEV = false>
+inline void fused_esimd(sycl::queue& queue, const float* q, const half* keys, const half* values, float* part,
+                        int T, int Hq, int Hkv, int cap, int ns_stride, int prefix_arg, float scale,
+                        const int64_t* p0_dev = nullptr, int E_arg = 0) {
+    static_assert(QP == 8 || QP == 16);
+    constexpr int QSTRIDE = 16;
+    const int nq = T * G;
+    const int ngrp = ((P0_DEV ? ns_stride : prefix_arg) + M - 1) / M;
+    const int64_t groups = (int64_t)T * Hq;
+    constexpr uint32_t Q_SLM_OFF = 0;
+    constexpr uint32_t P_SLM_OFF = D * QSTRIDE * sizeof(float);
+    constexpr uint32_t V_SLM_OFF = P_SLM_OFF + KB * QP * sizeof(float);
+    constexpr uint32_t SLM_BYTES = V_SLM_OFF + KB * D * sizeof(half);
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t(Hkv * ngrp) * SG, SG), props,
+                       [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<SLM_BYTES>();
+        const int gi = it.get_group_linear_id();
+        const int hk = gi / ngrp;
+        const int sp0 = (gi % ngrp) * M;
+        int prefix = prefix_arg;
+        if constexpr (P0_DEV) {
+            const int64_t p0 = *p0_dev;
+            const int64_t ext = (p0 + 1 < E_arg) ? (p0 + 1) : E_arg;
+            prefix = int((p0 + 1 - ext) / KB);
+            if (sp0 >= prefix) return;
+        }
+        const int sp_cnt = (sp0 + M <= prefix) ? M : (prefix - sp0);
+        const int lane = it.get_local_id(0);
+
+        // Load scaled Q into SLM as [D][16] once for all M splits.
+        es::simd<uint32_t, 8> qoff(Q_SLM_OFF + lane * 8 * QSTRIDE * 4, QSTRIDE * 4);
+        for (int qr = 0; qr < QP; ++qr) {
+            es::simd<float, 8> f(0.0f);
+            if (qr < nq) {
+                const int head = (qr / G) * Hq + hk * G + (qr % G);
+                f = es::block_load<float, 8>(q + size_t(head) * D + lane * 8) * scale;
+            }
+            es::slm_scatter<float, 8>(qoff + qr * 4, f);
+            if constexpr (QP == 8) {
+                es::slm_scatter<float, 8>(qoff + (qr + 8) * 4, f);
+            }
+        }
+        es::barrier();
+
+        if (sp_cnt <= 0) return;
+        if constexpr (QP == 8) {
+            es::simd<half, D> k[M * 4], v[4];
+#pragma unroll
+            for (int m = 0; m < M; ++m) {
+                const int sp = (m < sp_cnt) ? (sp0 + m) : sp0;
+                const half* ks = keys + (size_t(hk) * cap + size_t(sp) * KB + lane) * D;
+#pragma unroll
+                for (int u = 0; u < 4; ++u) k[m * 4 + u] = es::block_load<half, D>(ks + u * SG * D);
+            }
+            {
+                const half* vs0 = values + (size_t(hk) * cap + size_t(sp0) * KB + lane) * D;
+#pragma unroll
+                for (int u = 0; u < 4; ++u) v[u] = es::block_load<half, D>(vs0 + u * SG * D);
