+namespace {
+namespace X = sycl::ext::oneapi::experimental;
+struct Ink2Graph {
+    std::unique_ptr<X::command_graph<X::graph_state::modifiable>> rec;
+    std::unique_ptr<X::command_graph<X::graph_state::executable>> exec;
+};
+}  // namespace
