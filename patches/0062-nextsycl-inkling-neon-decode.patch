+// Single-launch ESIMD FP32 fused dot + exact softmax + value for T=1 (nq=3, QP=4):
+// packs all 4 queries x 4 keys into 1 single 16-wide SIMD FMA per dim, keeps <= 25 KB SLM (4 WGs/Xe-core),
+// and eliminates the global logits roundtrip + separate value launch.
+template <int M, bool P0_DEV = false>
+inline void fused_esimd_t1(sycl::queue& queue, const float* q, const half* keys, const half* values, float* part,
+                           int T, int Hq, int Hkv, int cap, int ns_stride, int prefix_arg, float scale,
+                           const int64_t* p0_dev = nullptr, int E_arg = 0) {
+    constexpr int QP = 4, QSTRIDE = 16, QH = 2;
+    const int nq = T * G;
+    const int ngrp = ((P0_DEV ? ns_stride : prefix_arg) + M - 1) / M;
+    const int64_t groups = (int64_t)T * Hq;
+    constexpr uint32_t Q_SLM_OFF = 0;
+    constexpr uint32_t P_SLM_OFF = D * QSTRIDE * sizeof(float);
+    constexpr uint32_t V_SLM_OFF = P_SLM_OFF + KB * QP * sizeof(float);
+    constexpr uint32_t SLM_BYTES = V_SLM_OFF + KB * D * sizeof(half); // 25 KB <= 32 KB
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t(Hkv * ngrp) * SG, SG), props,
+                       [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<SLM_BYTES>();
+        const int gi = it.get_group_linear_id();
+        const int hk = gi / ngrp;
+        const int sp0 = (gi % ngrp) * M;
+        int prefix = prefix_arg;
+        if constexpr (P0_DEV) {
+            const int64_t p0 = *p0_dev;
+            const int64_t ext = (p0 + 1 < E_arg) ? (p0 + 1) : E_arg;
+            prefix = int((p0 + 1 - ext) / KB);
+            if (sp0 >= prefix) return;
+        }
+        const int sp_cnt = (sp0 + M <= prefix) ? M : (prefix - sp0);
+        const int lane = it.get_local_id(0);
+
+        es::simd<uint32_t, 8> qoff(Q_SLM_OFF + lane * 8 * QSTRIDE * 4, QSTRIDE * 4);
+        for (int qr = 0; qr < QP; ++qr) {
+            es::simd<float, 8> f(0.0f);
+            if (qr < nq) {
+                const int head = (qr / G) * Hq + hk * G + (qr % G);
+                f = es::block_load<float, 8>(q + size_t(head) * D + lane * 8) * scale;
+            }
+            es::slm_scatter<float, 8>(qoff + qr * 4, f);
+            es::slm_scatter<float, 8>(qoff + (qr + 4) * 4, f);
+            es::slm_scatter<float, 8>(qoff + (qr + 8) * 4, f);
+            es::slm_scatter<float, 8>(qoff + (qr + 12) * 4, f);
+        }
+        es::simd<uint32_t, 16> loff16;
+#pragma unroll
+        for (int u = 0; u < 4; ++u)
+#pragma unroll
+            for (int qr = 0; qr < 4; ++qr)
+                loff16[u * 4 + qr] = P_SLM_OFF + (uint32_t)((qr * KB + lane + u * SG) * 4);
+        es::barrier();
+
+        if (sp_cnt <= 0) return;
+        es::simd<half, D> k[M * 4], v[4];
+#pragma unroll
+        for (int m = 0; m < M; ++m) {
+            const int sp = (m < sp_cnt) ? (sp0 + m) : sp0;
+            const half* ks = keys + (size_t(hk) * cap + size_t(sp) * KB + lane) * D;
+#pragma unroll
+            for (int u = 0; u < 4; ++u) k[m * 4 + u] = es::block_load<half, D>(ks + u * SG * D);
+        }
+        {
+            const half* vs0 = values + (size_t(hk) * cap + size_t(sp0) * KB + lane) * D;
+#pragma unroll
+            for (int u = 0; u < 4; ++u) v[u] = es::block_load<half, D>(vs0 + u * SG * D);
+        }
+
+        es::simd<float, 16> acc[M];
+#pragma unroll
+        for (int m = 0; m < M; ++m) acc[m] = 0.0f;
+        for (int c = 0; c < SG; ++c) {
+            const int d = ((c + lane) & 15) * 8;
+            es::simd<float, 32> kf0123[M];
+#pragma unroll
+            for (int m = 0; m < M; ++m) {
+                kf0123[m].template select<8, 1>(0) = es::simd<half, 8>(k[m * 4 + 0].template select<8, 1>(d));
+                kf0123[m].template select<8, 1>(8) = es::simd<half, 8>(k[m * 4 + 1].template select<8, 1>(d));
+                kf0123[m].template select<8, 1>(16) = es::simd<half, 8>(k[m * 4 + 2].template select<8, 1>(d));
+                kf0123[m].template select<8, 1>(24) = es::simd<half, 8>(k[m * 4 + 3].template select<8, 1>(d));
+            }
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                auto a = es::slm_block_load<float, 16>(Q_SLM_OFF + (uint32_t)((d + i) * QSTRIDE * 4));
+#pragma unroll
+                for (int m = 0; m < M; ++m) {
+                    es::simd<float, 16> b = kf0123[m].template replicate_vs_w_hs<4, 8, 4, 0>(i);
