+        const auto group = it.get_group();
+        const int64_t row = (int64_t)it.get_group(0);
+        const int lane = (int)it.get_local_id(0);
+        const Ink2sPassParams* prm = gptr(params_dev);
+        const int64_t pos0 = prm->p0 + (int64_t)prm->pos_off;
+        const uint64_t seed = prm->seed;
+        const float temperature = prm->temperature;
+        const float* parts = gptr(workspace) + 2 * row * tiles;
+        auto uniform = [&](uint64_t draw) {
+            uint64_t z = seed + 0x9e3779b97f4a7c15ULL * (2 * (uint64_t)(pos0 + row) + draw + 1);
+            z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+            z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+            return (float)((z ^ (z >> 31)) >> 40) * 0x1p-24f;
