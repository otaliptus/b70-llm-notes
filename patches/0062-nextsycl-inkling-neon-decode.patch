@@ -964,4 +1269,84 @@ int ns_ink2s_moe_down_union(ns_gpu* g, int type, const void* w, int64_t E, const
     NS_CATCH
 }
 
+int ns_ink2s_moe_down_union(ns_gpu* g, int type, const void* w, int64_t E, const float* scale, const int32_t* uni, const float* wts, const void* act_q,
+                            float* part, float* y, int64_t T, int64_t K, int64_t F, int64_t n_out) {
+    NS_TRY
+    int rc = moe_down_union_part(g, type, w, E, scale, uni, wts, act_q, part, T, K, F, n_out);
+    if (rc) return rc;
+    constexpr int CW = 128;
+    const int64_t total = T * n_out;
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t)((total + CW - 1) / CW) * CW), sycl::range<1>(CW)),
+                      [=](sycl::nd_item<1> it) {
+        const int64_t idx = it.get_global_linear_id();
+        if (idx >= total) return;
+        const int64_t t = idx / n_out, r = idx % n_out;
+        float v = 0.0f;
+        if (K == 8) {
+            float p[8];
+#pragma unroll
+            for (int k = 0; k < 8; ++k) p[k] = part[(t * 8 + k) * n_out + r];
+#pragma unroll
+            for (int k = 0; k < 8; ++k) v += p[k];
+        } else {
+            for (int64_t k = 0; k < K; ++k) v += part[(t * K + k) * n_out + r];
+        }
+        y[t * n_out + r] = v;
+    });
+    return 0;
+    NS_CATCH
