+int ns_ink2s_softcap_argmax(ns_gpu* g, const float* raw, int32_t* out, float* ws_val, int32_t* ws_idx,
+                            int64_t rows, int64_t vocab, int64_t ld, float cap) {
+    NS_TRY
+    constexpr int W = 256, TILE = 1024;
+    if (rows <= 0) return 0;
+    if (vocab < 1 || ld < vocab) return ns_fail("ns_ink2s_softcap_argmax: invalid dimensions");
+    const int64_t tiles = (vocab + TILE - 1) / TILE;
+    const float inv_cap = cap > 0.0f ? (1.0f / cap) : 0.0f;
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t)(rows * tiles) * W), sycl::range<1>(W)), [=](sycl::nd_item<1> it) {
+        const auto group = it.get_group();
+        const int64_t index = (int64_t)it.get_group(0), row = index / tiles, tile = index % tiles;
+        const int lane = (int)it.get_local_id(0);
+        const float* x = gptr(raw) + row * ld;
+        float best = -INFINITY;
+        int32_t at = (int32_t)vocab;
+#pragma unroll
+        for (int j = 0; j < TILE / W; ++j) {
+            const int64_t i = tile * TILE + lane + j * W;
+            if (i < vocab) {
+                const float r = x[i];
+                const float v = cap > 0.0f ? cap * sycl::tanh(r * inv_cap) : r;
+                if (v > best) {
+                    best = v;
+                    at = (int32_t)i;
+                }
+            }
+        }
+        const float m = sycl::reduce_over_group(group, best, sycl::maximum<float>());
+        const int32_t first = sycl::reduce_over_group(group, best == m ? at : (int32_t)vocab, sycl::minimum<int32_t>());
+        if (lane == 0) {
+            gptr(ws_val)[index] = m;
+            gptr(ws_idx)[index] = first;
+        }
+    });
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t)rows * W), sycl::range<1>(W)), [=](sycl::nd_item<1> it) {
+        const auto group = it.get_group();
+        const int64_t row = (int64_t)it.get_group(0);
+        const int lane = (int)it.get_local_id(0);
+        const float* tv = gptr(ws_val) + row * tiles;
+        const int32_t* ti = gptr(ws_idx) + row * tiles;
+        float best = -INFINITY;
+        int32_t at = (int32_t)vocab;
+        for (int64_t t = lane; t < tiles; t += W) {
+            const float v = tv[t];
+            const int32_t idx = ti[t];
+            if (v > best || (v == best && idx < at)) {
+                best = v;
+                at = idx;
+            }
+        }
+        const float m = sycl::reduce_over_group(group, best, sycl::maximum<float>());
+        const int32_t first = sycl::reduce_over_group(group, best == m ? at : (int32_t)vocab, sycl::minimum<int32_t>());
+        if (lane == 0) gptr(out)[row] = first < (int32_t)vocab ? first : 0;
+    });
+    return 0;
+    NS_CATCH
+}
