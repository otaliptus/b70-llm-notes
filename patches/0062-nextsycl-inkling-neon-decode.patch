+// ESIMD XMX DPAS online flash-decoding for DSpark's full-attention layer (win == 0, p0 >= 4096, T <= 8).
+// Uses hardware 2D block loads (transpose K, VNNI V) and xmx::dpas<8,8> with NS<=64 splits -> AoS part layout.
+#pragma once
+#include <cmath>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+namespace ink_draft_attn {
+namespace es = sycl::ext::intel::esimd;
+namespace xmx = es::xmx;
+using half = sycl::half;
+
+constexpr int D = 128, M = 8, N_TILE = 16, G = 3;
+constexpr float LOG2E = 1.4426950408889634f;
+constexpr float LN2 = 0.6931471805599453f;
+
+inline void run(sycl::queue& queue, const float* q, const half* kc, const half* vc, float* part,
+                int T, int Hq, int Hkv, int cap, int p0_host, int ns_out, float scale, const int64_t* p0_dev = nullptr) {
+    const int nq = T * G;
+    const int q_tiles = (nq + M - 1) / M;
+    const float qscale = scale * LOG2E;
+    const int groups = T * Hq;
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(
+        sycl::nd_range<1>(size_t(Hkv * ns_out) * size_t(q_tiles), size_t(q_tiles)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg = (int)it.get_group_linear_id();
+            const int qt = (int)it.get_local_linear_id();
+            const int hk = wg / ns_out;
+            const int sp = wg % ns_out;
+            const int q0 = qt * M;
+            const int p0 = p0_dev ? (int)(*p0_dev) : p0_host;
+            const int n_keys = p0 + T;
+            const int n_k_tiles = (n_keys + N_TILE - 1) / N_TILE;
+            const int tiles_per_sp = (n_k_tiles + ns_out - 1) / ns_out;
+            const half* kb = kc + size_t(hk) * size_t(cap) * D;
+            const half* vb = vc + size_t(hk) * size_t(cap) * D;
+
+            es::simd<half, M * N_TILE> qa[D / N_TILE];
+            es::simd<float, M * N_TILE> accum[D / N_TILE];
+#pragma unroll
+            for (int d = 0; d < D / N_TILE; ++d) {
+                accum[d] = 0.0f;
+                qa[d] = half(0.0f);
+            }
+
+            float maxrow[M], sumrow[M];
+#pragma unroll
+            for (int r = 0; r < M; ++r) {
+                maxrow[r] = -INFINITY;
+                sumrow[r] = 0.0f;
+            }
+
+            const int j_beg = sp * tiles_per_sp * N_TILE;
+            const int j_end_raw = (sp + 1) * tiles_per_sp * N_TILE;
+            const int j_end = j_end_raw < n_keys ? j_end_raw : n_keys;
+
+            if (j_beg < j_end) {
+                for (int r = 0; r < M; ++r) {
+                    const int qr = q0 + r;
+                    if (qr < nq) {
+                        const int head = (qr / G) * Hq + hk * G + (qr % G);
+                        const float* qp = q + size_t(head) * D;
+#pragma unroll
+                        for (int d = 0; d < D / N_TILE; ++d) {
+                            auto fq = es::block_load<float, N_TILE>(qp + d * N_TILE) * qscale;
+                            qa[d].template select<N_TILE, 1>(r * N_TILE) = es::simd<half, N_TILE>(fq);
+                        }
+                    }
+                }
+            }
+
+            for (int j = j_beg; j < j_end; j += N_TILE) {
+                es::simd<float, M * N_TILE> sc(0.0f);
+#pragma unroll
+                for (int d = 0; d < D; d += N_TILE) {
+                    auto words = es::load_2d<uint32_t, 8, 16, 1, true>(
+                        reinterpret_cast<const uint32_t*>(kb), D * 2 - 1, n_keys - 1, D * 2 - 1, d / 2, j);
+                    es::simd<half, N_TILE * N_TILE> k = words.template bit_cast_view<half>();
+                    sc = xmx::dpas<8, 8, float, float, half, half>(sc, k, qa[d / N_TILE]);
+                }
+
+                es::simd<half, M * N_TILE> p;
+                float factor[M];
+                const bool is_tail = (j + N_TILE > n_keys);
+                const int valid_k = is_tail ? (n_keys - j) : N_TILE;
+#pragma unroll
+                for (int r = 0; r < M; ++r) {
+                    es::simd<float, N_TILE> z = sc.template select<N_TILE, 1>(r * N_TILE);
+                    if (is_tail) {
+                        es::simd<int, N_TILE> idx(0, 1);
+                        z.merge(-INFINITY, idx >= valid_k);
+                    }
+                    const float tile_max = es::hmax<float>(z);
+                    const float mn = maxrow[r] > tile_max ? maxrow[r] : tile_max;
+                    factor[r] = (maxrow[r] > -INFINITY) ? es::exp2(maxrow[r] - mn) : 0.0f;
+                    auto y = es::exp2(z - mn);
+                    if (is_tail) {
+                        es::simd<int, N_TILE> idx(0, 1);
+                        y.merge(0.0f, idx >= valid_k);
+                    }
+                    es::simd<float, 4> ls(0.0f);
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) ls += y.template select<4, 4>(i);
+                    sumrow[r] = sumrow[r] * factor[r] + ((ls[0] + ls[1]) + (ls[2] + ls[3]));
+                    maxrow[r] = mn;
+                    p.template select<N_TILE, 1>(r * N_TILE) = es::simd<half, N_TILE>(y);
+                }
+
+#pragma unroll
+                for (int d = 0; d < D; d += N_TILE) {
+                    const int di = d / N_TILE;
+#pragma unroll
+                    for (int r = 0; r < M; ++r)
+                        accum[di].template select<N_TILE, 1>(r * N_TILE) *= factor[r];
+                    auto v = es::load_2d<half, N_TILE, N_TILE, 1, false, true>(
+                        vb, D * 2 - 1, n_keys - 1, D * 2 - 1, d, j);
+                    accum[di] = xmx::dpas<8, 8, float, float, half, half>(accum[di], v, p);
+                }
+            }
+
+            // Write AoS part layout (ns_out <= 64) and natural-log ms[2] for merge_gate_xq.
+            for (int r = 0; r < M; ++r) {
+                const int qr = q0 + r;
+                if (qr >= nq) break;
+                const int rh = (qr / G) * Hq + hk * G + (qr % G);
+                float* dst = part + (size_t(rh) * size_t(ns_out) + size_t(sp)) * D;
+#pragma unroll
+                for (int d = 0; d < D / N_TILE; ++d) {
+                    es::simd<float, N_TILE> outv = accum[d].template select<N_TILE, 1>(r * N_TILE);
+                    es::block_store<float, N_TILE>(dst + d * N_TILE, outv);
+                }
+                float* ms = part + size_t(groups) * size_t(ns_out) * D + (size_t(rh) * size_t(ns_out) + size_t(sp)) * 2;
+                ms[0] = (maxrow[r] > -INFINITY) ? (maxrow[r] * LN2) : -INFINITY;
+                ms[1] = sumrow[r];
+            }
+        });
+}
+
+// Per-head-row symmetric INT8 KV cache variant of run(): halves 100K DRAM traffic (410 -> 211 MB).
+// Layout: kc_raw holds int8_t[Hkv, cap, D], followed at align256(Hkv*cap*D) by float[Hkv, cap+16] scales.
+inline void run_i8(sycl::queue& queue, const float* q, const void* kc_raw, const void* vc_raw, float* part,
+                   int T, int Hq, int Hkv, int cap, int p0_host, int ns_out, float scale, const int64_t* p0_dev = nullptr) {
+    const int nq = T * G;
+    const int q_tiles = (nq + M - 1) / M;
+    const float qscale = scale * LOG2E;
+    const int groups = T * Hq;
+    const size_t sc_off = (size_t(Hkv) * size_t(cap) * D + 255) / 256 * 256;
+    const int8_t* kc = static_cast<const int8_t*>(kc_raw);
+    const int8_t* vc = static_cast<const int8_t*>(vc_raw);
+    const float* kc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(kc_raw) + sc_off);
+    const float* vc_sc = reinterpret_cast<const float*>(static_cast<const uint8_t*>(vc_raw) + sc_off);
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(
+        sycl::nd_range<1>(size_t(Hkv * ns_out) * size_t(q_tiles), size_t(q_tiles)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg = (int)it.get_group_linear_id();
+            const int qt = (int)it.get_local_linear_id();
+            const int hk = wg / ns_out;
+            const int sp = wg % ns_out;
+            const int q0 = qt * M;
+            const int p0 = p0_dev ? (int)(*p0_dev) : p0_host;
+            const int n_keys = p0 + T;
+            const int n_k_tiles = (n_keys + N_TILE - 1) / N_TILE;
+            const int tiles_per_sp = (n_k_tiles + ns_out - 1) / ns_out;
+            const int8_t* kb = kc + size_t(hk) * size_t(cap) * D;
+            const int8_t* vb = vc + size_t(hk) * size_t(cap) * D;
+            const float* ks = kc_sc + size_t(hk) * size_t(cap + 16);
+            const float* vs = vc_sc + size_t(hk) * size_t(cap + 16);
+
+            es::simd<int, M * 8> qa_i8[D / 32];
+            es::simd<float, M * N_TILE> accum[D / N_TILE];
+#pragma unroll
+            for (int d = 0; d < D / 32; ++d) qa_i8[d] = 0;
+#pragma unroll
+            for (int d = 0; d < D / N_TILE; ++d) accum[d] = 0.0f;
+
+            float maxrow[M], sumrow[M], qrow_sc[M];
+#pragma unroll
+            for (int r = 0; r < M; ++r) {
+                maxrow[r] = -INFINITY;
+                sumrow[r] = 0.0f;
+                qrow_sc[r] = 0.0f;
+            }
+
+            const int j_beg = sp * tiles_per_sp * N_TILE;
+            const int j_end_raw = (sp + 1) * tiles_per_sp * N_TILE;
+            const int j_end = j_end_raw < n_keys ? j_end_raw : n_keys;
+
+            if (j_beg < j_end) {
+                for (int r = 0; r < M; ++r) {
+                    const int qr = q0 + r;
+                    if (qr < nq) {
+                        const int head = (qr / G) * Hq + hk * G + (qr % G);
+                        const float* qp = q + size_t(head) * D;
+                        es::simd<float, 32> qf[4];
+                        float amax = 0.0f;
+#pragma unroll
+                        for (int d = 0; d < 4; ++d) {
+                            qf[d] = es::block_load<float, 32>(qp + d * 32);
+                            float m = es::hmax<float>(es::abs(qf[d]));
+                            if (m > amax) amax = m;
+                        }
+                        const float sc_q = amax / 127.0f;
+                        const float inv_q = sc_q != 0.0f ? 1.0f / sc_q : 0.0f;
+                        qrow_sc[r] = sc_q * qscale;
+#pragma unroll
+                        for (int d = 0; d < 4; ++d) {
+                            es::simd<int, 32> qi = es::rnde<int>(qf[d] * inv_q);
+                            qi = es::max<int>(es::min<int>(qi, 127), -127);
+                            es::simd<int8_t, 32> qb = qi;
+                            qa_i8[d].template select<8, 1>(r * 8) = qb.template bit_cast_view<int>();
+                        }
+                    }
+                }
+            }
+
+            for (int j = j_beg; j < j_end; j += N_TILE) {
+                es::simd<int, M * N_TILE> sc_i32(0);
+#pragma unroll
+                for (int d = 0; d < D; d += 32) {
+                    es::simd<int, 8 * N_TILE> rhs = es::load_2d<uint32_t, 8, 16, 1, true>(
+                        reinterpret_cast<const uint32_t*>(kb), D - 1, n_keys - 1, D - 1, d / 4, j);
+                    sc_i32 = xmx::dpas<8, 8, int, int, int, int,
+                        xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(sc_i32, rhs, qa_i8[d / 32]);
+                }
+
+                es::simd<float, N_TILE> k_sc = es::block_load<float, N_TILE>(ks + j);
+                es::simd<float, N_TILE> v_sc = es::block_load<float, N_TILE>(vs + j);
+                es::simd<half, M * N_TILE> p;
+                float factor[M];
+                const bool is_tail = (j + N_TILE > n_keys);
+                const int valid_k = is_tail ? (n_keys - j) : N_TILE;
+                if (is_tail) {
+                    es::simd<int, N_TILE> idx(0, 1);
+                    v_sc.merge(0.0f, idx >= valid_k);
+                }
+#pragma unroll
+                for (int r = 0; r < M; ++r) {
+                    es::simd<float, N_TILE> z = es::simd<float, N_TILE>(sc_i32.template select<N_TILE, 1>(r * N_TILE)) * (k_sc * qrow_sc[r]);
+                    if (is_tail) {
+                        es::simd<int, N_TILE> idx(0, 1);
+                        z.merge(-INFINITY, idx >= valid_k);
+                    }
+                    const float tile_max = es::hmax<float>(z);
+                    const float mn = maxrow[r] > tile_max ? maxrow[r] : tile_max;
+                    factor[r] = (maxrow[r] > -INFINITY) ? es::exp2(maxrow[r] - mn) : 0.0f;
+                    auto y = es::exp2(z - mn);
+                    if (is_tail) {
+                        es::simd<int, N_TILE> idx(0, 1);
+                        y.merge(0.0f, idx >= valid_k);
+                    }
+                    es::simd<float, 4> ls(0.0f);
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) ls += y.template select<4, 4>(i);
+                    sumrow[r] = sumrow[r] * factor[r] + ((ls[0] + ls[1]) + (ls[2] + ls[3]));
+                    maxrow[r] = mn;
+                    p.template select<N_TILE, 1>(r * N_TILE) = es::simd<half, N_TILE>(y * v_sc);
+                }
+
+#pragma unroll
+                for (int d = 0; d < D; d += N_TILE) {
+                    const int di = d / N_TILE;
+#pragma unroll
+                    for (int r = 0; r < M; ++r)
+                        accum[di].template select<N_TILE, 1>(r * N_TILE) *= factor[r];
+                    auto vwords = es::load_2d<uint32_t, 4, 16, 1, false, false>(
+                        reinterpret_cast<const uint32_t*>(vb), D - 1, n_keys - 1, D - 1, d / 4, j);
+                    auto raw = vwords.template bit_cast_view<int8_t>();
+                    es::simd<half, N_TILE * N_TILE> v;
+#pragma unroll
+                    for (int pr = 0; pr < 8; ++pr) {
+                        es::simd<int8_t, 16> r0 = raw.template select<16, 1>((2 * pr) * 16);
+                        es::simd<int8_t, 16> r1 = raw.template select<16, 1>((2 * pr + 1) * 16);
+                        v.template select<16, 2>(pr * 32 + 0) = es::simd<half, 16>(r0);
+                        v.template select<16, 2>(pr * 32 + 1) = es::simd<half, 16>(r1);
+                    }
+                    accum[di] = xmx::dpas<8, 8, float, float, half, half>(accum[di], v, p);
+                }
+            }
+
+            for (int r = 0; r < M; ++r) {
+                const int qr = q0 + r;
+                if (qr >= nq) break;
+                const int rh = (qr / G) * Hq + hk * G + (qr % G);
+                float* dst = part + (size_t(rh) * size_t(ns_out) + size_t(sp)) * D;
+#pragma unroll
+                for (int d = 0; d < D / N_TILE; ++d) {
+                    es::simd<float, N_TILE> outv = accum[d].template select<N_TILE, 1>(r * N_TILE);
+                    es::block_store<float, N_TILE>(dst + d * N_TILE, outv);
+                }
+                float* ms = part + size_t(groups) * size_t(ns_out) * D + (size_t(rh) * size_t(ns_out) + size_t(sp)) * 2;
+                ms[0] = (maxrow[r] > -INFINITY) ? (maxrow[r] * LN2) : -INFINITY;
+                ms[1] = sumrow[r];
+            }
+        });
+}
+
+}  // namespace ink_draft_attn
