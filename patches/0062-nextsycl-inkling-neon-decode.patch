+extern "C" {
+
+int ns_ink2s_graph_begin(ns_gpu* g, void** out) {
+    NS_TRY
+    auto* gr = new Ink2Graph();
+    gr->rec = std::make_unique<X::command_graph<X::graph_state::modifiable>>(g->q.get_context(), g->q.get_device());
+    gr->rec->begin_recording(g->q);
+    *out = gr;
+    return 0;
+    NS_CATCH
+}
+
+int ns_ink2s_graph_end(ns_gpu* g, void* h) {
+    NS_TRY
+    auto* gr = static_cast<Ink2Graph*>(h);
+    gr->rec->end_recording(g->q);
+    gr->exec = std::make_unique<X::command_graph<X::graph_state::executable>>(gr->rec->finalize());
+    gr->rec.reset();
+    return 0;
+    NS_CATCH
+}
+
+int ns_ink2s_graph_launch(ns_gpu* g, void* h) {
+    NS_TRY
+    auto* gr = static_cast<Ink2Graph*>(h);
+    if (!gr->exec) return ns_fail("ns_ink2s_graph_launch: a graph not finished");
+    g->q.ext_oneapi_graph(*gr->exec);
+    return 0;
+    NS_CATCH
+}
+
+void ns_ink2s_graph_free(void* h) {
+    delete static_cast<Ink2Graph*>(h);
+}
