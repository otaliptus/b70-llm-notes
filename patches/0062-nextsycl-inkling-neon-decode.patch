+int ns_ink2s_softcap_sample_full_p0(ns_gpu* g, const float* raw, int32_t* out, float* workspace,
+                                    int64_t rows, int64_t vocab, int64_t ld, float cap,
+                                    const Ink2sPassParams* params_dev) {
