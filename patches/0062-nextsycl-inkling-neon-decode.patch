+#pragma unroll
+            for (int m = 0; m < M; ++m) { acc01[m] = 0.0f; acc23[m] = 0.0f; }
+            for (int c = 0; c < SG; ++c) {
+                const int d = ((c + lane) & 15) * 8;
+                es::simd<float, 16> kf01[M], kf23[M];
+#pragma unroll
+                for (int m = 0; m < M; ++m) {
+                    kf01[m].template select<8, 1>(0) = es::simd<half, 8>(k[m * 4 + 0].template select<8, 1>(d));
+                    kf01[m].template select<8, 1>(8) = es::simd<half, 8>(k[m * 4 + 1].template select<8, 1>(d));
+                    kf23[m].template select<8, 1>(0) = es::simd<half, 8>(k[m * 4 + 2].template select<8, 1>(d));
+                    kf23[m].template select<8, 1>(8) = es::simd<half, 8>(k[m * 4 + 3].template select<8, 1>(d));
+                }
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    auto a = es::slm_block_load<float, 16>(Q_SLM_OFF + (uint32_t)((d + i) * QSTRIDE * 4));
+#pragma unroll
+                    for (int m = 0; m < M; ++m) {
+                        es::simd<float, 16> b01 = kf01[m].template replicate_vs_w_hs<2, 8, 8, 0>(i);
+                        es::simd<float, 16> b23 = kf23[m].template replicate_vs_w_hs<2, 8, 8, 0>(i);
+                        acc01[m] = __builtin_elementwise_fma(a.data(), b01.data(), acc01[m].data());
+                        acc23[m] = __builtin_elementwise_fma(a.data(), b23.data(), acc23[m].data());
+                    }
+                }
+            }
+            for (int mi = 0; mi < M; ++mi) {
+                if (mi >= sp_cnt) break;
+                const int sp = sp0 + mi;
+                if (mi > 0) es::barrier();
+#pragma unroll
+                for (int u = 0; u < 4; ++u) {
+                    const int key = lane + u * SG;
+#pragma unroll
+                    for (int dc = 0; dc < 8; ++dc) {
+                        es::simd<half, 16> vc = v[u].template select<16, 1>(dc * 16);
+                        es::slm_block_store<half, 16>(V_SLM_OFF + (uint32_t)((dc * KB + key) * 16 * 2), vc);
+                    }
+                }
+                for (int qr = 0; qr < nq; ++qr) {
+                    es::simd<float, 4> lg4;
+                    lg4[0] = float(acc01[mi][qr]);
+                    lg4[1] = float(acc01[mi][8 + qr]);
+                    lg4[2] = float(acc23[mi][qr]);
+                    lg4[3] = float(acc23[mi][8 + qr]);
+                    es::simd<uint32_t, 4> loff(P_SLM_OFF + (uint32_t)((qr * KB + lane) * 4), SG * 4);
+                    es::slm_scatter<float, 4>(loff, lg4);
+                }
+                if (mi + 1 < sp_cnt) {
+                    const half* vs_n = values + (size_t(hk) * cap + size_t(sp + 1) * KB + lane) * D;
+#pragma unroll
+                    for (int u = 0; u < 4; ++u) v[u] = es::block_load<half, D>(vs_n + u * SG * D);
+                }
+                es::barrier();
+                if (lane < nq) {
+                    auto lg = es::slm_block_load<float, KB>(P_SLM_OFF + (uint32_t)(lane * KB * 4));
+                    const float m = es::hmax<float>(lg);
+                    es::simd<float, 16> p0 = exp16_exact(lg.template select<16, 1>(0) - m);
+                    es::simd<float, 16> p1 = exp16_exact(lg.template select<16, 1>(16) - m);
+                    es::simd<float, 16> p2 = exp16_exact(lg.template select<16, 1>(32) - m);
+                    es::simd<float, 16> p3 = exp16_exact(lg.template select<16, 1>(48) - m);
+                    es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 0) * 4), p0);
+                    es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 16) * 4), p1);
+                    es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 32) * 4), p2);
+                    es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 48) * 4), p3);
+                    es::simd<float, 16> sl = p0;
+                    sl += p1; sl += p2; sl += p3;
+                    const float sum = reduce16_exact(sl);
+                    const int64_t rh = (int64_t)(lane / G) * Hq + hk * G + (lane % G);
+                    float* ms = part + size_t(groups) * ns_stride * D + (size_t(rh) * ns_stride + sp) * 2;
+                    ms[0] = m; ms[1] = sum;
+                }
+                es::barrier();
+                const int dc = lane & 7, d0 = dc * 16, q0 = (lane >> 3) * QH;
+                es::simd<float, 16> vo[QH];
+#pragma unroll
+                for (int k_i = 0; k_i < QH; ++k_i) vo[k_i] = 0.0f;
+                for (int j0 = 0; j0 < KB; j0 += 16) {
+                    es::simd<float, 16> pv[QH];
+#pragma unroll
+                    for (int k_i = 0; k_i < QH; ++k_i) {
+                        const int qk = (q0 + k_i < QP) ? (q0 + k_i) : (QP - 1);
+                        pv[k_i] = es::slm_block_load<float, 16>(P_SLM_OFF + (uint32_t)((qk * KB + j0) * 4));
+                    }
+                    auto vh0 = es::slm_block_load<half, 128>(V_SLM_OFF + (uint32_t)((dc * KB + j0) * 16 * 2));
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        es::simd<float, 16> vf = vh0.template select<16, 1>(j * 16);
+#pragma unroll
+                        for (int k_i = 0; k_i < QH; ++k_i) {
+                            es::simd<float, 16> p = float(pv[k_i][j]);
+                            vo[k_i] = __builtin_elementwise_fma(p.data(), vf.data(), vo[k_i].data());
+                        }
+                    }
+                    auto vh1 = es::slm_block_load<half, 128>(V_SLM_OFF + (uint32_t)((dc * KB + j0 + 8) * 16 * 2));
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        es::simd<float, 16> vf = vh1.template select<16, 1>(j * 16);
+#pragma unroll
+                        for (int k_i = 0; k_i < QH; ++k_i) {
+                            es::simd<float, 16> p = float(pv[k_i][j + 8]);
+                            vo[k_i] = __builtin_elementwise_fma(p.data(), vf.data(), vo[k_i].data());
+                        }
+                    }
+                }
+                float* slice = part + (size_t(hk) * ns_stride + sp) * size_t(nq) * D;
+#pragma unroll
+                for (int k_i = 0; k_i < QH; ++k_i) {
+                    if (q0 + k_i < nq) es::block_store<float, 16>(slice + size_t(q0 + k_i) * D + d0, vo[k_i]);
+                }
+            }
+            return;
+        }
+
+        es::simd<half, D> k[4], v[4];
+        {
+            const half* ks0 = keys + (size_t(hk) * cap + size_t(sp0) * KB + lane) * D;
+            const half* vs0 = values + (size_t(hk) * cap + size_t(sp0) * KB + lane) * D;
+#pragma unroll
+            for (int u = 0; u < 4; ++u) k[u] = es::block_load<half, D>(ks0 + u * SG * D);
+#pragma unroll
+            for (int u = 0; u < 4; ++u) v[u] = es::block_load<half, D>(vs0 + u * SG * D);
+        }
+
+        for (int mi = 0; mi < M; ++mi) {
+            if (mi >= sp_cnt) break;
+            const int sp = sp0 + mi;
+
+            es::simd<float, 16> acc[4];
+#pragma unroll
+            for (int u = 0; u < 4; ++u) acc[u] = 0.0f;
+            for (int c = 0; c < SG; ++c) {
+                const int d = ((c + lane) & 15) * 8;
+                es::simd<float, 8> kf[4];
+#pragma unroll
+                for (int u = 0; u < 4; ++u) kf[u] = es::simd<half, 8>(k[u].template select<8, 1>(d));
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    auto a = es::slm_block_load<float, 16>(Q_SLM_OFF + (uint32_t)((d + i) * QSTRIDE * 4));
+#pragma unroll
+                    for (int u = 0; u < 4; ++u) {
+                        es::simd<float, 16> b = kf[u].template replicate_vs_w_hs<1, 0, 16, 0>(i);
+                        acc[u] = __builtin_elementwise_fma(a.data(), b.data(), acc[u].data());
+                    }
+                }
+            }
+
+            if (mi > 0) es::barrier();
+#pragma unroll
+            for (int u = 0; u < 4; ++u) {
+                const int key = lane + u * SG;
+#pragma unroll
+                for (int dc = 0; dc < 8; ++dc) {
+                    es::simd<half, 16> vc = v[u].template select<16, 1>(dc * 16);
+                    es::slm_block_store<half, 16>(V_SLM_OFF + (uint32_t)((dc * KB + key) * 16 * 2), vc);
+                }
+            }
+            for (int qr = 0; qr < nq; ++qr) {
+                es::simd<float, 4> lg4;
+#pragma unroll
+                for (int u = 0; u < 4; ++u) lg4[u] = float(acc[u][qr]);
+                es::simd<uint32_t, 4> loff(P_SLM_OFF + (uint32_t)((qr * KB + lane) * 4), SG * 4);
+                es::slm_scatter<float, 4>(loff, lg4);
+            }
+            if (mi + 1 < sp_cnt) {
+                const half* ks_n = keys + (size_t(hk) * cap + size_t(sp + 1) * KB + lane) * D;
+                const half* vs_n = values + (size_t(hk) * cap + size_t(sp + 1) * KB + lane) * D;
+#pragma unroll
+                for (int u = 0; u < 4; ++u) k[u] = es::block_load<half, D>(ks_n + u * SG * D);
+#pragma unroll
+                for (int u = 0; u < 4; ++u) v[u] = es::block_load<half, D>(vs_n + u * SG * D);
+            }
+            es::barrier();
+
+            if (lane < nq) {
+                auto lg = es::slm_block_load<float, KB>(P_SLM_OFF + (uint32_t)(lane * KB * 4));
+                const float m = es::hmax<float>(lg);
+                es::simd<float, 16> p0 = exp16_exact(lg.template select<16, 1>(0) - m);
+                es::simd<float, 16> p1 = exp16_exact(lg.template select<16, 1>(16) - m);
+                es::simd<float, 16> p2 = exp16_exact(lg.template select<16, 1>(32) - m);
+                es::simd<float, 16> p3 = exp16_exact(lg.template select<16, 1>(48) - m);
+                es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 0) * 4), p0);
+                es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 16) * 4), p1);
+                es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 32) * 4), p2);
+                es::slm_block_store<float, 16>(P_SLM_OFF + (uint32_t)((lane * KB + 48) * 4), p3);
+                es::simd<float, 16> sl = p0;
+                sl += p1;
+                sl += p2;
+                sl += p3;
+                const float sum = reduce16_exact(sl);
+                const int64_t rh = (int64_t)(lane / G) * Hq + hk * G + (lane % G);
+                float* ms = part + size_t(groups) * ns_stride * D + (size_t(rh) * ns_stride + sp) * 2;
+                ms[0] = m;
+                ms[1] = sum;
+            }
+            es::barrier();
+
+            // Branch-free P*V over exactly QH queries per thread with 256B V SLM bursts.
+            const int dc = lane & 7;
+            const int d0 = dc * 16;
+            const int q0 = (lane >> 3) * QH;
+            es::simd<float, 16> vo[QH];
+#pragma unroll
+            for (int k = 0; k < QH; ++k) vo[k] = 0.0f;
+            for (int j0 = 0; j0 < KB; j0 += 16) {
+                es::simd<float, 16> pv[QH];
+#pragma unroll
+                for (int k = 0; k < QH; ++k) {
+                    const int qk = (q0 + k < QP) ? (q0 + k) : (QP - 1);
+                    pv[k] = es::slm_block_load<float, 16>(P_SLM_OFF + (uint32_t)((qk * KB + j0) * 4));
+                }
+                auto vh0 = es::slm_block_load<half, 128>(V_SLM_OFF + (uint32_t)((dc * KB + j0) * 16 * 2));
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    es::simd<float, 16> vf = vh0.template select<16, 1>(j * 16);
+#pragma unroll
+                    for (int k = 0; k < QH; ++k) {
+                        es::simd<float, 16> p = float(pv[k][j]);
+                        vo[k] = __builtin_elementwise_fma(p.data(), vf.data(), vo[k].data());
+                    }
+                }
+                auto vh1 = es::slm_block_load<half, 128>(V_SLM_OFF + (uint32_t)((dc * KB + j0 + 8) * 16 * 2));
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    es::simd<float, 16> vf = vh1.template select<16, 1>(j * 16);
+#pragma unroll
+                    for (int k = 0; k < QH; ++k) {
+                        es::simd<float, 16> p = float(pv[k][j + 8]);
+                        vo[k] = __builtin_elementwise_fma(p.data(), vf.data(), vo[k].data());
+                    }
+                }
+            }
+            float* slice = part + (size_t(hk) * ns_stride + sp) * size_t(nq) * D;
+#pragma unroll
+            for (int k = 0; k < QH; ++k) {
+                if (q0 + k < nq) es::block_store<float, 16>(slice + size_t(q0 + k) * D + d0, vo[k]);
+            }
+        }
+    });
+}
+
+// 16-thread ESIMD FP32 fused dot + exact softmax + value for T=8 (nq=24).
+// Keeps Q[128][32] (16 KB) + P[QP][64] (<=6 KB) + V_half[8][32][16] (8 KB) <= 30 KB SLM
+// (<= 32 KB so 4 WGs/Xe-core stay resident at grf_size<256>), single 128B Q SLM load,
+// deferred v[2..3] loads hidden behind softmax + half-0 P*V, and 256B V SLM bursts.
+template <int M, int Q1, int QH, bool P0_DEV = false>
+inline void fused_esimd_24(sycl::queue& queue, const float* q, const half* keys, const half* values, float* part,
+                           int T, int Hq, int Hkv, int cap, int ns_stride, int prefix_arg, float scale,
+                           const int64_t* p0_dev = nullptr, int E_arg = 0) {
+    constexpr int Q0 = 16, QP = Q0 + Q1, QSTRIDE = 32;
+    static_assert(Q1 == 4 || Q1 == 8);
+    const int nq = T * G;
+    const int nq1 = nq - Q0;
+    const int ngrp = ((P0_DEV ? ns_stride : prefix_arg) + M - 1) / M;
+    const int64_t groups = (int64_t)T * Hq;
+    constexpr uint32_t Q_SLM_OFF = 0;
+    constexpr uint32_t P_SLM_OFF = D * QSTRIDE * sizeof(float);
+    constexpr uint32_t V_SLM_OFF = P_SLM_OFF + KB * QP * sizeof(float);
+    constexpr uint32_t SLM_BYTES = V_SLM_OFF + (KB / 2) * D * sizeof(half); // <= 30 KB
+    auto props = sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<256>};
+    queue.parallel_for(sycl::nd_range<1>(size_t(Hkv * ngrp) * SG, SG), props,
+                       [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<SLM_BYTES>();
+        const int gi = it.get_group_linear_id();
+        const int hk = gi / ngrp;
+        const int sp0 = (gi % ngrp) * M;
+        int prefix = prefix_arg;
+        if constexpr (P0_DEV) {
+            const int64_t p0 = *p0_dev;
+            const int64_t ext = (p0 + 1 < E_arg) ? (p0 + 1) : E_arg;
+            prefix = int((p0 + 1 - ext) / KB);
+            if (sp0 >= prefix) return;
+        }
+        const int sp_cnt = (sp0 + M <= prefix) ? M : (prefix - sp0);
+        const int lane = it.get_local_id(0);
+
+        {
+            es::simd<uint32_t, 8> qoff(Q_SLM_OFF + lane * 8 * QSTRIDE * 4, QSTRIDE * 4);
+            for (int qr = 0; qr < QP; ++qr) {
+                es::simd<float, 8> f(0.0f);
+                if (qr < nq) {
+                    const int head = (qr / G) * Hq + hk * G + (qr % G);
+                    f = es::block_load<float, 8>(q + size_t(head) * D + lane * 8) * scale;
+                }
+                es::slm_scatter<float, 8>(qoff + qr * 4, f);
+                if constexpr (Q1 == 4) {
+                    if (qr >= Q0) {
+                        es::slm_scatter<float, 8>(qoff + (qr + 4) * 4, f);
+                        es::slm_scatter<float, 8>(qoff + (qr + 8) * 4, f);
+                        es::slm_scatter<float, 8>(qoff + (qr + 12) * 4, f);
+                    }
+                } else {
+                    if (qr >= Q0) es::slm_scatter<float, 8>(qoff + (qr + 8) * 4, f);
+                }
+            }
+        }
+        es::barrier();
+
+        if (sp_cnt <= 0) return;
+        es::simd<half, D> k[4], v0, v1;
+        {
+            const half* ks0 = keys + (size_t(hk) * cap + size_t(sp0) * KB + lane) * D;
+            const half* vs0 = values + (size_t(hk) * cap + size_t(sp0) * KB + lane) * D;
+#pragma unroll
+            for (int u = 0; u < 4; ++u) k[u] = es::block_load<half, D>(ks0 + u * SG * D);
+            v0 = es::block_load<half, D>(vs0);
+            v1 = es::block_load<half, D>(vs0 + SG * D);
+        }
+
+        for (int mi = 0; mi < M; ++mi) {
+            if (mi >= sp_cnt) break;
+            const int sp = sp0 + mi;
+            const half* vs = values + (size_t(hk) * cap + size_t(sp) * KB + lane) * D;
+
+            es::simd<float, 16> acc0[4];
+            es::simd<float, 16> acc1_01(0.0f), acc1_23(0.0f);
+#pragma unroll
+            for (int u = 0; u < 4; ++u) acc0[u] = 0.0f;
+            for (int c = 0; c < SG; ++c) {
+                const int d = ((c + lane) & 15) * 8;
+                es::simd<float, 8> kf[4];
+#pragma unroll
+                for (int u = 0; u < 4; ++u) kf[u] = es::simd<half, 8>(k[u].template select<8, 1>(d));
+                es::simd<float, 32> kf0123;
+                es::simd<float, 16> kf01, kf23;
+                if constexpr (Q1 == 4) {
+                    kf0123.template select<8, 1>(0) = kf[0];
+                    kf0123.template select<8, 1>(8) = kf[1];
+                    kf0123.template select<8, 1>(16) = kf[2];
+                    kf0123.template select<8, 1>(24) = kf[3];
+                } else {
+                    kf01.template select<8, 1>(0) = kf[0];
+                    kf01.template select<8, 1>(8) = kf[1];
+                    kf23.template select<8, 1>(0) = kf[2];
+                    kf23.template select<8, 1>(8) = kf[3];
+                }
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
