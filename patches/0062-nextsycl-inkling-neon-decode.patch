+
+int ns_ink2s_moe_down_conv_res_union(ns_gpu* g, int type, const void* w, int64_t E, const float* scale, const int32_t* uni, const float* wts,
+                                     const void* act_q, float* part, float* state, const float* conv_w, float* snap, const float* base,
+                                     float* dst, float* out, int64_t T, int64_t K, int64_t F, int64_t n_out, float inv) {
+    NS_TRY
+    if (T < 1 || T > 16) return ns_fail("ns_ink2s_moe_down_conv_res_union: 1..16 rows");
+    int rc = moe_down_union_part(g, type, w, E, scale, uni, wts, act_q, part, T, K, F, n_out);
+    if (rc) return rc;
+    constexpr int CW = 128;
+    const size_t ngrp = (size_t)((n_out + CW - 1) / CW) * CW;
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>(ngrp), sycl::range<1>(CW)),
+                      [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+        const int64_t c = it.get_global_linear_id();
+        if (c >= n_out) return;
+        float h0 = state[c], h1 = state[n_out + c], h2 = state[2 * n_out + c];
+        const float w0 = conv_w[c * 4], w1 = conv_w[c * 4 + 1], w2 = conv_w[c * 4 + 2], w3 = conv_w[c * 4 + 3];
+        if (snap) {
+            snap[c] = h0;
+            snap[n_out + c] = h1;
+            snap[2 * n_out + c] = h2;
+        }
+        for (int64_t t = 0; t < T; ++t) {
+            float xc = 0.0f;
+            if (K == 8) {
+                float p[8];
+#pragma unroll
+                for (int k = 0; k < 8; ++k) p[k] = part[(t * 8 + k) * n_out + c];
+#pragma unroll
+                for (int k = 0; k < 8; ++k) xc += p[k];
+            } else {
+                for (int64_t k = 0; k < K; ++k) xc += part[(t * K + k) * n_out + c];
+            }
+            if (snap) snap[(3 + t) * n_out + c] = xc;
