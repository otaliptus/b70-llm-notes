+            dst[t * n_out + c] = base ? base[t * n_out + c] + o : o;
+            h0 = h1;
+            h1 = h2;
+            h2 = xc;
+        }
+        state[c] = h0;
+        state[n_out + c] = h1;
+        state[2 * n_out + c] = h2;
+    });
+    return 0;
+    NS_CATCH
+}
