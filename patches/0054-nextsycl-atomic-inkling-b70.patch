+// Full-vocabulary sampling at top_p=1. Each tile records its max and shifted sum. Draw a
+// tile by its probability mass, then draw inside it. Both counters depend on the token's
+// absolute position so verifying a block uses the same draws as verifying its rows singly.
+int ns_ink2_sample_full(ns_gpu* g, const float* logits, int32_t* out, float* workspace, int64_t rows, int64_t vocab,
