+#pragma unroll
+        for (int j = 0; j < TILE/W; ++j) {
+            const int64_t i = tile * TILE + lane + j * W;
+            values[j] = i < vocab ? x[i] : -INFINITY;
+            maximum = sycl::fmax(maximum, values[j]);
+        }
+        maximum = sycl::reduce_over_group(group, maximum, sycl::maximum<float>());
+        float sum = 0;
+        if (sycl::isfinite(maximum)) {
+#pragma unroll
+            for (int j = 0; j < TILE/W; ++j) sum += sycl::exp((values[j] - maximum) / temperature);
+        }
+        sum = sycl::reduce_over_group(group, sum, sycl::plus<float>());
+        if (lane == 0) {
+            workspace[2*index] = maximum;
+            workspace[2*index+1] = sum;
+        }
+    });
+    g->q.parallel_for(sycl::nd_range<1>(sycl::range<1>(rows * W), sycl::range<1>(W)), [=](sycl::nd_item<1> it) {
+        const auto group = it.get_group();
+        const int64_t row = it.get_group(0);
+        const int lane = it.get_local_id(0);
+        const float* parts = workspace + 2 * row * tiles;
+        auto uniform = [&](uint64_t draw) {
+            uint64_t z = seed + 0x9e3779b97f4a7c15ULL * (2 * (uint64_t)(pos0 + row) + draw + 1);
+            z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+            z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+            return (float)((z ^ (z >> 31)) >> 40) * 0x1p-24f;
+        };
+        float m = -INFINITY;
+        for (int64_t i = lane; i < tiles; i += W) m = sycl::fmax(m, parts[2*i]);
+        m = sycl::reduce_over_group(group, m, sycl::maximum<float>());
+        float mass = 0;
+        for (int64_t i = lane; i < tiles; i += W) mass += parts[2*i+1] * sycl::exp((parts[2*i] - m) / temperature);
+        auto choose_lane = [&](float s, float u) {
+            const float end = sycl::inclusive_scan_over_group(group, s, sycl::plus<float>());
+            const float total = sycl::group_broadcast(group, end, W-1);
+            const float cut = sycl::fmin(u * total, sycl::nextafter(total, 0.0f));
+            const int pick = sycl::reduce_over_group(group, s > 0 && end > cut ? lane : W, sycl::minimum<int>());
+            return sycl::min(pick, W-1);
+        };
+        const int owner = choose_lane(mass, uniform(0));
+        int tile = owner;
