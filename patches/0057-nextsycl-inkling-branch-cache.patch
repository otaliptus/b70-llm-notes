+/// Only resident checkpoints participate. Identifiers stay valid while at least one
+/// checkpoint owns the allocation; a disk entry has its own serialized bytes.
+#[derive(Default)]
+struct ResidentMemory {
+    bytes: usize,
+    references: std::collections::HashMap<usize, usize>,
+}
+
+impl ResidentMemory {
+    fn insert(&mut self, ck: &Checkpoint) {
+        let mut added = ck.bytes();
+        ck.visit_shared(&mut |id, bytes| {
+            let count = self.references.entry(id).or_default();
+            if *count > 0 {
+                added -= bytes;
+            }
+            *count += 1;
+        });
+        self.bytes += added;
+    }
+
+    fn remove(&mut self, ck: &Checkpoint) {
+        let mut removed = ck.bytes();
+        ck.visit_shared(&mut |id, bytes| {
+            let count = self.references.get_mut(&id).expect("resident checkpoint allocation");
+            *count -= 1;
+            if *count == 0 {
+                self.references.remove(&id);
+            } else {
+                removed -= bytes;
+            }
+        });
+        self.bytes -= removed;
+    }
+}
