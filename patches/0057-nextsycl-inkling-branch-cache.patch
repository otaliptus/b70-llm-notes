+int ns_ink2s_conv_keep_many(ns_gpu* g, int slots, const float* const* snapshots, float* const* states, const int64_t* widths, int keep, int max_rows) {
+    NS_TRY
+    constexpr int max_slots = 16;
+    if (slots < 1 || slots > max_slots || keep < 0 || keep > max_rows)
+        return ns_fail("ns_ink2s_conv_keep_many: invalid slot or row count");
+    struct Copies {
+        const float* snap[max_slots];
+        float* state[max_slots];
+        int64_t end[4], offset[4];
+    } cp{};
+    for (int s = 0; s < slots; ++s) {
+        cp.snap[s] = snapshots[s];
+        cp.state[s] = states[s];
+    }
+    int64_t channels = 0;
+    for (int j = 0; j < 4; ++j) {
+        cp.offset[j] = max_rows * channels + keep * widths[j];
+        channels += widths[j];
+        cp.end[j] = channels * 3;
+    }
+    g->q.parallel_for(sycl::range<2>(slots, channels * 3), [=](sycl::id<2> id) {
+        const int s = id[0];
+        const int64_t i = id[1];
+        const int j = i < cp.end[1] ? (i < cp.end[0] ? 0 : 1) : (i < cp.end[2] ? 2 : 3);
+        cp.state[s][i] = cp.snap[s][i + cp.offset[j]];
+    });
+    return 0;
+    NS_CATCH
+}
