+// K-quant (Q4_K / Q5_K) 12-byte scale block: load it as three sub-group-uniform dwords and extract this
+// lane's (scale, min) pairs for its two sub-blocks 2j and 2j+1 (j = lane's sub-block pair, 0..3) without
+// the data-dependent branch of the reference aux[] code. Same values as ggml's get_scale_min_k4.
+__dpct_inline__ static void ggml_sycl_k4_scale_min(const uint8_t * __restrict__ scs, const int j, float & sc0, float & sc1,
+                                                   float & m0, float & m1) {
+    const uint32_t * s32 = (const uint32_t *) scs;
+    const uint32_t s0 = s32[0], s1 = s32[1], s2 = s32[2];
+    const auto byte = [&](int b) -> uint32_t { return ((b < 4 ? s0 : b < 8 ? s1 : s2) >> (8 * (b & 3))) & 0xff; };
+    const auto scmin = [&](int is, float & sc, float & m) {
+        // is < 4:  sc = q[is] & 63,                               m = q[is+4] & 63
+        // is >= 4: sc = (q[is+4] & 0xF) | ((q[is-4] >> 6) << 4),  m = (q[is+4] >> 4) | ((q[is] >> 6) << 4)
+        const uint32_t lo_sc = byte(is) & 63;
+        const uint32_t lo_m  = byte(is + 4) & 63;
+        const uint32_t hi_sc = (byte(is + 4) & 0xF) | ((byte((is - 4) & 7) >> 6) << 4);
+        const uint32_t hi_m  = (byte(is + 4) >> 4) | ((byte(is) >> 6) << 4);
+        const bool lo = is < 4;
+        sc = (float) (lo ? lo_sc : hi_sc);
+        m  = (float) (lo ? lo_m : hi_m);
+    };
+    scmin(2 * j,     sc0, m0);
+    scmin(2 * j + 1, sc1, m1);
