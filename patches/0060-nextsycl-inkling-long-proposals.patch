@@ -0,0 +1,80 @@
+// Dense Q8_0 output heads on Xe2. Each eight-lane work-group computes sixteen vocabulary rows.
+// DPAS evaluates two 16-value dot products per activation block, using a zero half in each
+// operand row. Keeping those half-blocks separate preserves the accumulation tree of mv_t.
+#pragma once
+
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+namespace q8_head {
+namespace es = sycl::ext::intel::esimd;
+namespace xmx = es::xmx;
+
+template<int Batch>
+void submit(sycl::queue& queue, const void* weight, const void* input, float* output,
+            int tokens, int rows, int columns) {
+    constexpr int N = 16, workers = 8, halves = 2 * Batch;
+    const int blocks = columns / 32, token_tiles = (tokens + Batch - 1) / Batch;
+    const auto* quants = static_cast<const uint32_t*>(weight);
+    const auto* scales = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(weight) +
+                                                            ns_ink2s_scales_at(8, rows, columns));
+    const auto* acts = static_cast<const int*>(input);
+    const auto* act_scales = reinterpret_cast<const float*>(static_cast<const uint8_t*>(input) +
+                                                            ns_ink2s_xq_scales_at(tokens, columns));
+    auto properties = sycl::ext::oneapi::experimental::properties{
+        sycl::ext::intel::experimental::grf_size<256>};
+    const size_t groups = size_t(rows / N) * token_tiles;
+    queue.parallel_for(sycl::nd_range<1>(groups * workers, workers), properties,
+                       [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+        es::slm_init<workers * halves * N * sizeof(float)>();
+        const int group = it.get_group_linear_id(), tile = group / token_tiles;
+        const int first_token = (group % token_tiles) * Batch, lane = it.get_local_id(0);
+        es::simd<float, halves * N> accum(0.0f);
+        for (int block = lane; block < blocks; block += workers) {
+            es::simd<int, 8 * N> rhs = es::load_2d<uint32_t, 8, N, 1, true>(
+                quants + size_t(tile) * N * columns / 4, columns - 1, N - 1, columns - 1,
+                8 * block, 0);
+            es::simd<uint32_t, N> offsets(block * 2, blocks * 2);
+            auto bits = es::gather<uint16_t, N>(scales + size_t(tile) * N * blocks, offsets);
+            es::simd<float, N> w_scale = es::simd<sycl::half, N>(bits.template bit_cast_view<sycl::half>());
+            es::simd<int, halves * 8> lhs(0);
+            float x_scale[Batch];
+#pragma unroll
+            for (int j = 0; j < Batch; ++j) {
+                const int token = first_token + j < tokens ? first_token + j : tokens - 1;
+                const size_t index = size_t(token) * blocks + block;
+                auto bytes = es::block_load<int, 8>(acts + index * 8);
+                lhs.template select<4, 1>(j * 16) = bytes.template select<4, 1>(0);
+                lhs.template select<4, 1>(j * 16 + 12) = bytes.template select<4, 1>(4);
+                x_scale[j] = act_scales[index];
+            }
+            auto products = xmx::dpas<8, halves, int, int, int, int,
+                xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                    es::simd<int, halves * N>(0), rhs, lhs);
+#pragma unroll
+            for (int h = 0; h < halves; ++h) {
+                es::simd<float, N> dot = es::simd<int, N>(products.template select<N, 1>(h * N));
+                es::simd<float, N> scale = w_scale * x_scale[h / 2];
+                es::simd<float, N> old = accum.template select<N, 1>(h * N);
+                accum.template select<N, 1>(h * N) =
+                    es::simd<float, N>(__builtin_elementwise_fma(dot.data(), scale.data(), old.data()));
+            }
+        }
+        es::slm_block_store<float, halves * N>(lane * halves * N * sizeof(float), accum);
+        es::barrier();
+        if (lane < Batch && first_token + lane < tokens) {
+            es::simd<float, N> partial[16];
+#pragma unroll
+            for (int i = 0; i < 16; ++i)
+                partial[i] = es::slm_block_load<float, N>(
+                    ((i / 2 * halves + lane * 2 + i % 2) * N) * sizeof(float));
+#pragma unroll
+            for (int stride = 8; stride; stride >>= 1)
+#pragma unroll
+                for (int i = 0; i < stride; ++i) partial[i] += partial[i + stride];
+            es::block_store<float, N>(output + size_t(first_token + lane) * rows + tile * N, partial[0]);
+        }
+    });
+}
+
+} // namespace q8_head
