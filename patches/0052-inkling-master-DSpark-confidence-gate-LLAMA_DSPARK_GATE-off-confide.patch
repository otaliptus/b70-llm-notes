From 035629ff80a2b9c8c476c10769bf51476b191b3f Mon Sep 17 00:00:00 2001
From: b70-notes <b70-notes@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:02:55 +0000
Subject: [PATCH] DSpark confidence gate (LLAMA_DSPARK_GATE, off), confidence
 log (LLAMA_DSPARK_CONF_LOG), SYCL graph cache per shape

- Reduced-vocabulary chain: each drafted position also returns its top-1 probability (softcapped softmax over the
  subset, gathered at the argmax) in element rank+1 of its state row. LLAMA_DSPARK_GATE=p stops the draft at the first
  position below p (empty draft = plain decode step). Default 0 = off.
- LLAMA_DSPARK_CONF_LOG=<file> (full head, LLAMA_DSPARK_SUB=0): per step "n_drafted n_accepted p1..pn" for offline
  analysis. 1,899 steps at n-max 4, temp 1.0: p >= 0.9 accepted 89 %, 0.5-0.6 34 %; simulated gate 0.8 with a 4-chain
  78.6 tok/s vs fixed n-max 2 68.6 (a local confidence log, docs/14).
- Measured (temp 0, 3 prompts x 800 tokens): gate 0.8 / n-max 4 drafts 1.52 per step and yields 2.17 tokens per step
  (fixed n2: 1.99 / 2.20), but varying verify sizes cost graph rebuilds: 74.8 tok/s without SYCL graphs (fixed n2
  74.0), 53.9 with graphs (75.0 fixed), 61.2 with the per-shape graph key below. Left off until llama.cpp keeps one
  built graph per batch size.
- ggml-sycl: SYCL graph cache key = first-node pointer + node count + shapes of the first and last node
  (GGML_SYCL_GRAPH_KEY_SHAPE=0 = old key); llama.cpp rebuilds every shape in the same memory, so all shapes shared one
  entry. Fixed-shape default: same outputs (temp-0 hashes), 74.5 vs 75.0 tok/s (noise).

Co-Authored-By: otaliptus <56600661+otaliptus@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/speculative.cpp           | 51 +++++++++++++++++++++++++++++++-
 ggml/src/ggml-sycl/ggml-sycl.cpp | 17 ++++++++++-
 src/models/dspark.cpp            | 18 ++++++++---
 3 files changed, 80 insertions(+), 6 deletions(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index 3ef3a17..ca33c47 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -22,6 +22,22 @@
 #include <random>
 #include <cinttypes>
 
+
+// LLAMA_DSPARK_CONF_LOG=<file> (local analysis aid, full draft head only): per speculative step one line
+// "n_drafted n_accepted p_1 ... p_n" with the drafter's top-1 softmax probability at each drafted position, to test
+// whether a confidence threshold could stop drafts that the target will reject.
+static FILE * g_dspark_conf_log = nullptr;
+static bool   g_dspark_conf_init = false;
+static std::vector<float> g_dspark_conf;   // probabilities of the current draft (single sequence)
+static FILE * dspark_conf_log() {
+    if (!g_dspark_conf_init) {
+        g_dspark_conf_init = true;
+        const char * path = getenv("LLAMA_DSPARK_CONF_LOG");
+        g_dspark_conf_log = path ? fopen(path, "a") : nullptr;
+    }
+    return g_dspark_conf_log;
+}
+
 #define SPC_DBG(fmt, ...) LOG_DBG("spec %12.*s: " fmt, 12, __func__, __VA_ARGS__)
 #define SPC_TRC(fmt, ...) LOG_TRC("spec %12.*s: " fmt, 12, __func__, __VA_ARGS__)
 #define SPC_INF(fmt, ...) LOG_INF("spec %12.*s: " fmt, 12, __func__, __VA_ARGS__)
@@ -1560,8 +1576,15 @@ public:
                     LOG_ERR("%s: DSpark draft ids missing (no h_nextn rows)\n", __func__);
                     continue;
                 }
+                // LLAMA_DSPARK_GATE=p (default 0 = off): stop the draft at the first position whose top-1 probability
+                // (element markov_rank + 1 of its row) is below p; an empty draft makes the step a plain decode
+                static const float gate = [] { const char * e = getenv("LLAMA_DSPARK_GATE"); return e ? (float) atof(e) : 0.0f; }();
                 for (int32_t i = 1; i < std::min(n_block_tokens, 1 + params.n_max); ++i) {
-                    result.push_back((llama_token) std::lrintf(rows[(size_t) (beg + i) * n_embd_dec + markov_rank]));
+                    const float * row = rows + (size_t) (beg + i) * n_embd_dec;
+                    if (gate > 0.0f && row[markov_rank + 1] < gate) {
+                        break;
+                    }
+                    result.push_back((llama_token) std::lrintf(row[markov_rank]));
                 }
                 continue;
             }
@@ -1582,6 +1605,22 @@ public:
                     // Use the first maximum, as in the RNN conditioning graph.
                     common_sampler_accept(smpl, sampled, true);
                     result.push_back(sampled);
+                    if (dspark_conf_log()) {
+                        if (i == i_draft_beg) {
+                            g_dspark_conf.clear();
+                        }
+                        const float * lg = llama_get_logits_ith(ctx_dft, idx);
+                        const int32_t nv = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx_dft)));
+                        float mx = -INFINITY;
+                        for (int32_t k = 0; k < nv; ++k) {
+                            mx = std::max(mx, lg[k]);
+                        }
+                        double sum = 0.0;
+                        for (int32_t k = 0; k < nv; ++k) {
+                            sum += std::exp((double) (lg[k] - mx));
+                        }
+                        g_dspark_conf.push_back((float) (1.0 / sum));
+                    }
                     continue;
                 }
 
@@ -3718,6 +3757,16 @@ void common_speculative_accept(common_speculative * spec, llama_seq_id seq_id, u
         return;
     }
 
+    if (FILE * f = dspark_conf_log(); f && !g_dspark_conf.empty()) {
+        fprintf(f, "%zu %u", g_dspark_conf.size(), (unsigned) n_accepted);
+        for (float p : g_dspark_conf) {
+            fprintf(f, " %.4f", p);
+        }
+        fprintf(f, "\n");
+        fflush(f);
+        g_dspark_conf.clear();
+    }
+
     {
         common_time_meas tm(impl->t_accept_us, !impl->gen_perf);
 
diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index bfbfce1..48c2fee 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -7079,8 +7079,23 @@ static void ggml_backend_sycl_graph_compute_impl_inner(ggml_backend_sycl_context
 }
 
 #ifdef GGML_SYCL_GRAPH
+// One cached SYCL graph per graph SHAPE: llama.cpp rebuilds the cgraph in the same memory when the batch size changes
+// (e.g. a speculative verify of 2, 3 or 5 tokens), so the first-node pointer alone made every shape share one entry
+// and every change of shape re-recorded the graph. GGML_SYCL_GRAPH_KEY_SHAPE=0 = old key.
 static const void * ggml_sycl_graph_get_key(ggml_cgraph * cgraph) {
-    return cgraph->nodes[0];
+    static const bool by_shape = ggml_sycl_get_env("GGML_SYCL_GRAPH_KEY_SHAPE", 1) != 0;
+    if (!by_shape) {
+        return cgraph->nodes[0];
+    }
+    uint64_t h = (uint64_t) (uintptr_t) cgraph->nodes[0];
+    auto mix = [&h](uint64_t v) { h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2); };
+    mix((uint64_t) cgraph->n_nodes);
+    for (const ggml_tensor * t : { cgraph->nodes[0], cgraph->nodes[cgraph->n_nodes - 1] }) {
+        for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+            mix((uint64_t) t->ne[d]);
+        }
+    }
+    return (const void *) (uintptr_t) h;
 }
 
 static bool ggml_sycl_graph_update_required(ggml_sycl_graph * graph, ggml_cgraph * cgraph) {
diff --git a/src/models/dspark.cpp b/src/models/dspark.cpp
index 4fb8e65..a5b78b9 100644
--- a/src/models/dspark.cpp
+++ b/src/models/dspark.cpp
@@ -927,8 +927,8 @@ void llama_model_dflash::load_tensors_inkling2() {
         dspark_out_sub       = create_tensor(tn(LLM_TENSOR_DSPARK_OUT_SUB, "weight"), {n_embd, n_sub}, 0);
         dspark_markov_w1_sub = create_tensor(tn(LLM_TENSOR_DSPARK_MARKOV_W1_SUB, "weight"), {rank, n_sub}, 0);
         dspark_out_sub_ids   = create_tensor(tn(LLM_TENSOR_DSPARK_OUT_SUB_IDS, "weight"), {n_sub}, 0);
-        if (rank + 1 > n_embd) {
-            throw std::runtime_error("Inkling2 DSpark: no room for the draft id in the chain state row");
+        if (rank + 2 > n_embd) {
+            throw std::runtime_error("Inkling2 DSpark: no room for the draft id and confidence in the chain state row");
         }
         LLAMA_LOG_INFO("%s: DSpark reduced draft vocabulary: %lld tokens\n", __func__, (long long) n_sub);
     }
@@ -1121,11 +1121,21 @@ llama_model_dflash::graph_inkling2::graph_inkling2(const llm_graph_params & para
             auto * cand = ggml_tanh(ctx0, chunk(1));
             st = ggml_add(ctx0, cand, ggml_mul(ctx0, gate, ggml_sub(ctx0, st, cand)));
             auto * corr = ggml_add(ctx0, build_lora_mm(model.dspark_hidden_out, ggml_tanh(ctx0, chunk(2))), model.dspark_hidden_out_b);
-            auto * lg = build_lora_mm(model.dspark_out_sub, ggml_add(ctx0, hid, corr));   // softcap is monotone: skipped
+            auto * lg = build_lora_mm(model.dspark_out_sub, ggml_add(ctx0, hid, corr));
             ggml_prec_set_acc(lg, GGML_PREC_F32);
             prev = ggml_argmax(ctx0, lg);                                                  // subset index
             auto * idf = ggml_get_rows(ctx0, idtab, prev);                                 // [1, nb] full id as f32
-            auto * row = ggml_pad(ctx0, ggml_concat(ctx0, st, idf, 0), n_embd - rank - 1, 0, 0, 0);
+            // confidence of the draft: top-1 probability of the softcapped logits over the subset (element rank + 1
+            // of the row; the driver can stop the draft at the first position below LLAMA_DSPARK_GATE)
+            const float cap = hparams.f_final_logit_softcapping;
+            auto * sm = ggml_soft_max(ctx0, ggml_scale(ctx0, ggml_tanh(ctx0, ggml_scale(ctx0, lg, 1.0f/cap)), cap));
+            ggml_tensor * ptop = nullptr;
+            for (int64_t c = 0; c < nb; ++c) {  // gather sm[prev[c], c]: column c viewed as rows of one element
+                auto * col = ggml_reshape_2d(ctx0, ggml_cont(ctx0, ggml_view_1d(ctx0, sm, n_sub, c*sm->nb[1])), 1, n_sub);
+                auto * pc = ggml_get_rows(ctx0, col, ggml_view_1d(ctx0, prev, 1, c*prev->nb[0]));   // [1, 1]
+                ptop = ptop ? ggml_concat(ctx0, ptop, pc, 1) : pc;
+            }
+            auto * row = ggml_pad(ctx0, ggml_concat(ctx0, ggml_concat(ctx0, st, idf, 0), ptop, 0), n_embd - rank - 2, 0, 0, 0);
             rows = ggml_concat(ctx0, rows, row, 1);
         }
         for (int64_t i = n_chain + 1; i < block; ++i) {
