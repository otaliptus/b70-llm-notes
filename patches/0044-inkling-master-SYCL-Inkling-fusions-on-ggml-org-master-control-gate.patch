 #include "inkling-fuse.hpp"
 
@@ -25,7 +26,7 @@ namespace {
 constexpr int SG = 16;
 
 int ifuse_mask() {
-    static const int m = ggml_sycl_get_env("GGML_SYCL_IFUSE", 0x1ff);
+    static const int m = ggml_sycl_get_env("GGML_SYCL_IFUSE", 0x3ff);
