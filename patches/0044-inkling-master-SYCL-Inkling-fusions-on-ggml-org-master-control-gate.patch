@@ -981,6 +982,158 @@ int fuse_control(ggml_backend_sycl_context & ctx, const ggml_cgraph * cg, int i)
     return last - i;
 }
 
+// ---------------------------------------------------------------------------------------------------------------
+// 6b. control() as built by ggml-org master (inkling2_loop): CONCAT(rms(cur), rms(msg)) MUL_MAT(down) MUL_MAT(forget)
+//     TANH MUL(., cur) SUB(cur, .) MUL_MAT(gain) TANH MUL(., msg) ADD. The two RMS_NORMs run before the group and
+//     stay. Weights Q8_0 (AoS or the reordered planar layout), BF16 or F32. Two kernels: h = down * [rn_cur; rn_msg],
+//     then out = cur - tanh(forget h) cur + tanh(gain h) msg.
+
+// one weight element of a 2-D matrix: F32, BF16, or Q8_0 as blocks [d][qs] or planar [all qs][all d]
+struct wmat {
+    const void * p;
+    int          type;  // 0 f32, 1 bf16, 2 q8_0 AoS, 3 q8_0 planar
+    int64_t      nblk;  // q8_0 blocks in the whole tensor (planar: offset of the d section)
+};
+
+inline float wmat_at(const wmat & w, int64_t idx) {
+    switch (w.type) {
+        case 0:  return ((const float *) w.p)[idx];
+        case 1:  return bf16_to_f32(((const uint16_t *) w.p)[idx]);
+        case 2: {
+            const uint8_t * b = (const uint8_t *) w.p + (idx / QK8_0) * sizeof(block_q8_0);
+            const float d = (float) *(const sycl::half *) b;
+            return d * (float) (int8_t) b[sizeof(sycl::half) + idx % QK8_0];
+        }
+        default: {
+            const float d = (float) ((const sycl::half *) ((const uint8_t *) w.p + w.nblk * QK8_0))[idx / QK8_0];
+            return d * (float) ((const int8_t *) w.p)[idx];
+        }
+    }
+}
+
+bool wmat_of(const ggml_tensor * W, wmat & w) {
+    if (!ggml_is_contiguous(W) || W->ne[2] != 1 || W->ne[3] != 1) {
+        return false;
+    }
+    w.p = W->data;
+    w.nblk = 0;
+    if (W->type == GGML_TYPE_F32) {
+        w.type = 0;
+    } else if (W->type == GGML_TYPE_BF16) {
+        w.type = 1;
+    } else if (W->type == GGML_TYPE_Q8_0) {
+        const auto * extra = (const ggml_tensor_extra_gpu *) W->extra;
+        w.type = extra && extra->optimized_feature.reorder ? 3 : 2;
+        w.nblk = ggml_nelements(W) / QK8_0;
+    } else {
+        return false;
+    }
+    return true;
+}
+
+// four consecutive elements [idx, idx + 4) of a weight row, idx % 4 == 0
+inline sycl::float4 wmat_at4(const wmat & w, int64_t idx) {
+    switch (w.type) {
+        case 0: return *(const sycl::float4 *) ((const float *) w.p + idx);
+        case 1: {
+            const uint16_t * b = (const uint16_t *) w.p + idx;
+            return sycl::float4(bf16_to_f32(b[0]), bf16_to_f32(b[1]), bf16_to_f32(b[2]), bf16_to_f32(b[3]));
+        }
+        case 2: {
+            const uint8_t * b = (const uint8_t *) w.p + (idx / QK8_0) * sizeof(block_q8_0);
+            const float d = (float) *(const sycl::half *) b;
+            const uint16_t * q = (const uint16_t *) (b + sizeof(sycl::half) + idx % QK8_0);  // 2-byte aligned
+            const uint32_t v = (uint32_t) q[0] | ((uint32_t) q[1] << 16);
+            return sycl::float4((int8_t) (v), (int8_t) (v >> 8), (int8_t) (v >> 16), (int8_t) (v >> 24)) * d;
+        }
+        default: {
+            const float d = (float) ((const sycl::half *) ((const uint8_t *) w.p + w.nblk * QK8_0))[idx / QK8_0];
+            const uint32_t v = *(const uint32_t *) ((const int8_t *) w.p + idx);
+            return sycl::float4((int8_t) (v), (int8_t) (v >> 8), (int8_t) (v >> 16), (int8_t) (v >> 24)) * d;
+        }
+    }
+}
+
+// the gates of control(), from the forget mat-vec on: MUL_MAT(forget, h) TANH MUL(., cur) SUB(cur, .)
+// MUL_MAT(gain, h) TANH MUL(., msg) ADD, with h = MUL_MAT(down, CONCAT(rms(cur), rms(msg))) computed before
+// by the regular mat-vec. One sub-group per (token, output channel).
+int fuse_control2(ggml_backend_sycl_context & ctx, const ggml_cgraph * cg, int i) {
+    const ggml_tensor * mmf = cg->nodes[i];
+    if (mmf->op != GGML_OP_MUL_MAT || mmf->src[1]->op != GGML_OP_MUL_MAT || mmf->src[1]->src[1]->op != GGML_OP_CONCAT) {
+        return 0;
+    }
+    int idx[8];
+    const int last = collect(cg, i, 8, idx);
+    if (last < 0) {
+        return 0;
+    }
+    const ggml_tensor * t[8];
+    for (int k = 0; k < 8; ++k) {
+        t[k] = cg->nodes[idx[k]];
+    }
+    const ggml_tensor * thf = t[1], * mf = t[2], * sub = t[3], * mmg = t[4], * thg = t[5], * mg = t[6], * add = t[7];
+    if (thf->op != GGML_OP_UNARY || ggml_get_unary_op(thf) != GGML_UNARY_OP_TANH || mf->op != GGML_OP_MUL ||
+        sub->op != GGML_OP_SUB || mmg->op != GGML_OP_MUL_MAT || thg->op != GGML_OP_UNARY ||
+        ggml_get_unary_op(thg) != GGML_UNARY_OP_TANH || mg->op != GGML_OP_MUL || add->op != GGML_OP_ADD) {
+        return 0;
+    }
+    const ggml_tensor * h = mmf->src[1];
+    const ggml_tensor * cur = mf->src[1], * msg = mg->src[1];
+    if (thf->src[0] != mmf || mf->src[0] != thf || sub->src[0] != cur || sub->src[1] != mf || mmg->src[1] != h ||
+        thg->src[0] != mmg || mg->src[0] != thg || add->src[0] != sub || add->src[1] != mg) {
+        IFUSE_REJECT("control2 links", mmf);
+    }
+    const ggml_tensor * Wf = mmf->src[0], * Wg = mmg->src[0];
+    const int64_t n_embd = cur->ne[0], n_tok = ggml_nrows(cur), n_rank = h->ne[0];
+    if (n_tok > 8) {
+        return 0;  // prompt batches: the unfused GEMMs read each weight once, this kernel once per token
+    }
+    wmat wf, wg;
+    if (!wmat_of(Wf, wf) || !wmat_of(Wg, wg) || Wf->ne[0] != n_rank || Wf->ne[1] != n_embd || Wg->ne[0] != n_rank ||
+        Wg->ne[1] != n_embd || n_rank != 4 * SG || h->type != GGML_TYPE_F32 || !ggml_is_contiguous(h) ||
+        ggml_nrows(h) != n_tok || !ggml_is_contiguous(cur) || !ggml_is_contiguous(msg) || !f32_rows(cur) ||
+        !f32_rows(msg) || !ggml_are_same_shape(cur, msg) || !ggml_is_contiguous(add) || !ggml_are_same_shape(add, cur) ||
+        add->type != GGML_TYPE_F32) {
+        IFUSE_REJECT("control2 shape", mmf);
+    }
+    if (!same_or_disjoint(add, cur) || !same_or_disjoint(add, msg) || overlaps(add, h) || overlaps(add, Wf) ||
+        overlaps(add, Wg)) {
+        IFUSE_REJECT("control2 overlap", add);
+    }
+    const ggml_tensor * outs[] = { add };
+    if (!span_ok(cg, i, last, outs, 1)) {
+        IFUSE_REJECT("control2 span", add);
+    }
+    const float * hd = (const float *) h->data;
+    const float * cd = (const float *) cur->data;
+    const float * md = (const float *) msg->data;
+    float * od = (float *) add->data;
+    const int nE = (int) n_embd, nRk = (int) n_rank;
+    // WG of 8 sub-groups: 8 output channels per work-group
+    constexpr int NS = 8;
+    const int64_t n_grp = (n_tok * n_embd + NS - 1) / NS;
+    ctx.stream()->parallel_for(sycl::nd_range<1>(n_grp * NS * SG, NS * SG), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+        const int64_t g = it.get_group(0) * NS + it.get_local_id(0) / SG;
+        if (g >= n_tok * nE) {
+            return;
+        }
+        const int64_t tk = g / nE;
+        const int64_t e = g - tk * nE;
+        const int l = it.get_local_id(0) % SG;
+        const sycl::float4 hv = *(const sycl::float4 *) (hd + tk * nRk + 4 * l);
+        const sycl::float4 fv = wmat_at4(wf, e * nRk + 4 * l) * hv;
+        const sycl::float4 gv = wmat_at4(wg, e * nRk + 4 * l) * hv;
+        auto sg = it.get_sub_group();
+        const float f  = sycl::reduce_over_group(sg, fv.x() + fv.y() + fv.z() + fv.w(), sycl::plus<float>());
+        const float gg = sycl::reduce_over_group(sg, gv.x() + gv.y() + gv.z() + gv.w(), sycl::plus<float>());
+        if (l == 0) {
+            const float c = cd[tk * nE + e];
+            od[tk * nE + e] = (c - sycl::tanh(f) * c) + sycl::tanh(gg) * md[tk * nE + e];
+        }
+    });
+    return last - i;
+}
+
 // ---------------------------------------------------------------------------------------------------------------
 // 7. short-convolution tail: SSM_CONV(x, w) ADD(cur, out) SCALE(s): out[c, t] = (cur[c, t] + sum_j x[t+j, c] w[j, c]) * s
 int fuse_conv(ggml_backend_sycl_context & ctx, const ggml_cgraph * cg, int i) {
@@ -1075,8 +1228,9 @@ int fuse_relmask(ggml_backend_sycl_context & ctx, const ggml_cgraph * cg, int i)
     }
     const int64_t n_rel = bias->ne[0], n_ext1 = bias->ne[1], n_head = R->ne[1], n_tok = R->ne[2];
     const int64_t n_embd = Ws->ne[0], n_kv = add->ne[0];
+    wmat wsm;
     if (bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) || R->type != GGML_TYPE_F32 || !ggml_is_contiguous(R) ||
-        R->ne[0] != n_rel || n_rel > 64 || pad->ne[1] != n_ext1 + 1 || pad->ne[0] != n_rel || bias->ne[2] != 1 || (Ws->type != GGML_TYPE_BF16 && Ws->type != GGML_TYPE_F32) ||
+        R->ne[0] != n_rel || n_rel > 64 || pad->ne[1] != n_ext1 + 1 || pad->ne[0] != n_rel || bias->ne[2] != 1 || !wmat_of(Ws, wsm) ||
         !ggml_is_contiguous(Ws) || Ws->ne[1] != n_head || xs->type != GGML_TYPE_F32 || !ggml_is_contiguous(xs) ||
         xs->ne[0] != n_embd || ggml_nrows(xs) != n_tok || n_embd % SG != 0 || rp->type != GGML_TYPE_I32 ||
         !ggml_is_contiguous(rp) || ggml_nelements(rp) != n_kv * n_tok || mask->type != GGML_TYPE_F16 ||
@@ -1114,8 +1268,6 @@ int fuse_relmask(ggml_backend_sycl_context & ctx, const ggml_cgraph * cg, int i)
     float * rc = r_alloc.get();
     const float * Rsrc = (const float *) R->data;
     const int nRelc = (int) n_rel;
-    const void * wd = Ws->data;
-    const bool w_bf16 = Ws->type == GGML_TYPE_BF16;
     const float * xd = (const float *) xs->data;
     const int nE = (int) n_embd, nH = (int) n_head;
     constexpr int WGS = 256;
@@ -1127,7 +1279,7 @@ int fuse_relmask(ggml_backend_sycl_context & ctx, const ggml_cgraph * cg, int i)
             const int l = it.get_local_id(0);
             float acc = 0.0f;
             for (int e = l; e < nE; e += WGS) {
-                const float w = w_bf16 ? bf16_to_f32(((const uint16_t *) wd)[h * nE + e]) : ((const float *) wd)[h * nE + e];
+                const float w = wmat_at(wsm, h * nE + e);
                 acc += w * xd[tk * nE + e];
             }
             auto sg = it.get_sub_group();
@@ -1268,6 +1420,7 @@ int ggml_sycl_inkling_fuse(ggml_backend_sycl_context & ctx, const ggml_cgraph *
         case GGML_OP_MUL_MAT:
             IFUSE_TRY(128, "relmask", fuse_relmask(ctx, cg, i))
             IFUSE_TRY(2, "router", fuse_router_mm(ctx, cg, i))
+            IFUSE_TRY(512, "control2", fuse_control2(ctx, cg, i))
             break;
         case GGML_OP_CONCAT:
             IFUSE_TRY(256, "convstore", fuse_convstore(ctx, cg, i))
