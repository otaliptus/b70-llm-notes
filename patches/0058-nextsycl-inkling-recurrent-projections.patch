+// Each query is independent. This path writes an unnormalized mix directly and can
+// calculate the messages of a recurrent pass together, from its two fixed inputs.
+struct LayerQueries { const float* p[16]; };
+
+template <int S>
+void mix_plain(sycl::queue& queue, MixArgs a, LayerQueries qs, int layers) {
+    constexpr int W = 576, NV = 2 * S;
+    queue.submit([&](sycl::handler& h) {
+        sycl::local_accessor<float, 1> sums(sycl::range<1>(W / SG * NV + NV), h);
+        h.parallel_for(sycl::nd_range<1>(size_t(layers) * a.nq * a.T * W, W),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            const int group = it.get_group_linear_id(), tid = it.get_local_linear_id();
+            const int t = group % a.T, qi = group / a.T % a.nq, layer = group / (a.T * a.nq);
+            const auto* q = reinterpret_cast<const sycl::float4*>(qs.p[layer] + qi * a.C);
+            float part[NV] = {}, total[NV];
+            for (int i = tid; i < a.C / 4; i += W) {
+                const sycl::float4 w = q[i];
+#pragma unroll
+                for (int s = 0; s < S; ++s) {
+                    const sycl::float4 x = reinterpret_cast<const sycl::float4*>(a.st[s] + t * a.C)[i];
+                    part[s] += x.x()*x.x() + x.y()*x.y() + x.z()*x.z() + x.w()*x.w();
+                    part[S+s] += x.x()*w.x() + x.y()*w.y() + x.z()*w.z() + x.w()*w.w();
+                }
+            }
+            group_sums<NV>(it, part, sums.get_multi_ptr<sycl::access::decorated::no>().get(), total);
+            float inv[S], p[S], mx = -INFINITY, sum = 0.f;
+            const float sc = 1.f / sycl::sqrt(float(a.C));
+#pragma unroll
+            for (int s = 0; s < S; ++s) {
+                inv[s] = sycl::rsqrt(total[s] / float(a.C) + a.eps_mix);
+                p[s] = total[S+s] * inv[s] * sc;
+                mx = sycl::fmax(mx, p[s]);
+            }
+#pragma unroll
+            for (int s = 0; s < S; ++s) { p[s] = sycl::exp(p[s] - mx); sum += p[s]; }
+#pragma unroll
+            for (int s = 0; s < S; ++s) p[s] = p[s] / sum * inv[s];
+            auto* dst = reinterpret_cast<sycl::float4*>(a.out + size_t(group) * a.C);
+            for (int i = tid; i < a.C / 4; i += W) {
+                sycl::float4 y(0.f);
+#pragma unroll
+                for (int s = 0; s < S; ++s)
+                    y += p[s] * reinterpret_cast<const sycl::float4*>(a.st[s] + t * a.C)[i];
+                dst[i] = y;
+            }
+        });
+    });
+}
