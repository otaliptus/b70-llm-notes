+                sycl::free(dhead_, *cs_);
+                dhead_ = (uint8_t*) pd;
+                planar_gathered = true;
+            }
+        }
+        if (!planar_gathered) kernels::gather_rows((const uint8_t*) hw, row_bytes, dv, (int64_t) vocab.size(), dhead_, cs_);
         cs_->wait();
         sycl::free(dv, *cs_);
         vram_ += (uint64_t) ((int64_t) vocab.size() * row_bytes);
