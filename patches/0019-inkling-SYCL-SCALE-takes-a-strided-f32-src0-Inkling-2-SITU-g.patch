From: b70-notes <b70-notes@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:14:23 +0000
Subject: [PATCH 1/3] SYCL: SCALE takes a strided f32 src0 (Inkling 2 SITU
 gate/up views of the merged gate_up stayed on the CPU, 96 splits/token)

---
 ggml/src/ggml-sycl/ggml-sycl.cpp | 41 ++++++++++++++++++++++++++++++--
 1 file changed, 39 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index 9da436c..5e86c03 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -2529,6 +2529,23 @@ static void scale_f32(const float * x, float * dst, const float scale, const flo
     dst[i] = scale * x[i] + bias;
 }
 
+// strided source (e.g. the gate/up halves of a merged gate_up view); dst is contiguous.
+// nb0..nb3 are the source strides in floats.
+static void scale_f32_strided(const float * x, float * dst, const float scale, const float bias, const int64_t k,
+                              const int64_t ne0, const int64_t ne1, const int64_t ne2,
+                              const int64_t nb0, const int64_t nb1, const int64_t nb2, const int64_t nb3,
+                              const sycl::nd_item<3> & item_ct1) {
+    const int64_t i = (int64_t) item_ct1.get_local_range(2) * item_ct1.get_group(2) + item_ct1.get_local_id(2);
+    if (i >= k) {
+        return;
+    }
+    const int64_t i0 = i % ne0;
+    const int64_t i1 = (i / ne0) % ne1;
+    const int64_t i2 = (i / (ne0 * ne1)) % ne2;
+    const int64_t i3 = i / (ne0 * ne1 * ne2);
+    dst[i] = scale * x[i0 * nb0 + i1 * nb1 + i2 * nb2 + i3 * nb3] + bias;
+}
+
 
 static void ggml_mul_mat_p021_f16_f32_sycl(const void *vx, const float *y,
                                            float *dst, const int ncols_x,
@@ -3580,6 +3597,23 @@ inline void ggml_sycl_op_scale(ggml_backend_sycl_context & ctx, ggml_tensor * ds
     // the kernel indexes in 32-bit
     GGML_ASSERT(ggml_nelements(dst->src[0]) <= INT32_MAX);
 
+    const ggml_tensor * src0 = dst->src[0];
+    if (!ggml_is_contiguous(src0)) {
+        GGML_ASSERT(ggml_is_contiguous(dst));
+        const int64_t k = ggml_nelements(src0);
+        const int64_t ne0 = src0->ne[0], ne1 = src0->ne[1], ne2 = src0->ne[2];
+        const int64_t nb0 = src0->nb[0] / sizeof(float), nb1 = src0->nb[1] / sizeof(float);
+        const int64_t nb2 = src0->nb[2] / sizeof(float), nb3 = src0->nb[3] / sizeof(float);
+        const int64_t num_blocks = (k + SYCL_SCALE_BLOCK_SIZE - 1) / SYCL_SCALE_BLOCK_SIZE;
+        main_stream->parallel_for(
+            sycl::nd_range<3>(sycl::range<3>(1, 1, num_blocks) * sycl::range<3>(1, 1, SYCL_SCALE_BLOCK_SIZE),
+                              sycl::range<3>(1, 1, SYCL_SCALE_BLOCK_SIZE)),
+            [=](sycl::nd_item<3> item_ct1) {
+                scale_f32_strided(src0_dd, dst_dd, scale, bias, k, ne0, ne1, ne2, nb0, nb1, nb2, nb3, item_ct1);
+            });
+        return;
+    }
+
     scale_f32_sycl(src0_dd, dst_dd, scale, bias, ggml_nelements(dst->src[0]), main_stream);
     /*
     DPCT1010:87: SYCL uses exceptions to report errors and does not use the
@@ -7603,8 +7637,11 @@ static bool do_ggml_backend_sycl_device_supports_op(ggml_backend_dev_t dev, cons
         case GGML_OP_RMS_NORM_BACK:
             return ggml_is_contiguous(op->src[0]);
         case GGML_OP_SCALE:
-            // the scale kernel is f32 only, and reads src0 flat
-            return op->type == GGML_TYPE_F32 && op->src[0]->type == GGML_TYPE_F32 && ggml_is_contiguous(op->src[0]);
+            // the scale kernel is f32 only; a non-contiguous src0 (float-aligned strides) takes the strided path
+            return op->type == GGML_TYPE_F32 && op->src[0]->type == GGML_TYPE_F32 && ggml_is_contiguous(op) &&
+                   (ggml_is_contiguous(op->src[0]) ||
+                    (op->src[0]->nb[0] % sizeof(float) == 0 && op->src[0]->nb[1] % sizeof(float) == 0 &&
+                     op->src[0]->nb[2] % sizeof(float) == 0 && op->src[0]->nb[3] % sizeof(float) == 0));
         case GGML_OP_CONT:
             return true;
         case GGML_OP_TRI:
