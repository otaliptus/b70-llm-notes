+        tokens = inp->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);
+        ggml_set_input(tokens);
+        f_rnn = inp->h = build_inp_embd_state(inp.get(), n_embd);
