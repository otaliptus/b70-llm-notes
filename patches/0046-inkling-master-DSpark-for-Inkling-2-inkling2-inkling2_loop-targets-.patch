+        }
+        if (!zero_col) {
+            zero_col = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_lg, nb), 0.0f);
+        }
+        return zero_col;
+    };
+    auto * logits = filler(0);
+    auto * context = column(f_rnn, 0);
+    // LLAMA_DSPARK_NCHAIN (set by the speculative driver to --spec-draft-n-max): run the recurrent head only for
+    // the positions that are drafted; the rest get filler logits and a zero state (never read).
+    const char * n_chain_str = getenv("LLAMA_DSPARK_NCHAIN"); // read per build: the driver sets it after the reserve
+    const int64_t n_chain_env = n_chain_str ? (int64_t) atoi(n_chain_str) : 0;
+    const int64_t n_chain = n_chain_env > 0 ? std::min<int64_t>(n_chain_env, block - 1) : block - 1;
+    // LLAMA_DSPARK_ARGMAX=0: the old first-maximum construction (pool_1d over the vocabulary in one work-item on SYCL)
+    static const bool plain_argmax = [] { const char * e = getenv("LLAMA_DSPARK_ARGMAX"); return !e || atoi(e) != 0; }();
+    ggml_tensor * tie_rank = nullptr;
+    if (!plain_argmax) {
+        tie_rank = ggml_scale_bias(ctx0, ggml_arange(ctx0, 0, hparams.n_vocab_unpadded, 1), -1.0f, hparams.n_vocab_unpadded);
+    }
+    auto * prev = ids;
+    for (int64_t i = 1; i <= n_chain; ++i) {
+        auto * col = fold
+            ? build_inkling2_head(*this, model, *target, prev, state, column(cur, i), nullptr, context, column(cur, i), n_lg)
+            : build_inkling2_head(*this, model, *target, prev, state, column(cur, i), column(base, i), context);
+        states = ggml_concat(ctx0, states, ggml_pad(ctx0, state, n_embd - rank, 0, 0, 0), 1);
+        logits = ggml_concat(ctx0, logits, col, 1);
+        if (i == n_chain) {
+            break;
+        }
+        auto * valid = ggml_cont(ctx0, ggml_view_2d(ctx0, col, hparams.n_vocab_unpadded, nb, col->nb[1], 0));
+        if (plain_argmax) {
+            // the SYCL argmax returns the first maximum (patched reduction), as the CPU one does
+            prev = ggml_argmax(ctx0, valid);
+            continue;
+        }
+        // Select the first maximum, independent of backend argmax tie order.
+        auto * maximum = ggml_pool_1d(ctx0, valid, GGML_OP_POOL_MAX, valid->ne[0], 1, 0);
+        auto * is_max = ggml_scale_bias(ctx0, ggml_step(ctx0, ggml_sub(ctx0, ggml_repeat(ctx0, maximum, valid), valid)), -1.0f, 1.0f);
+        prev = ggml_argmax(ctx0, ggml_mul(ctx0, is_max, tie_rank));
+    }
+    if (n_chain + 1 < block) {
+        auto * zstate = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, nb), 0.0f);
+        for (int64_t i = n_chain + 1; i < block; ++i) {
+            states = ggml_concat(ctx0, states, zstate, 1);
+            logits = ggml_concat(ctx0, logits, filler(i), 1);
+        }
+    }
+    const auto block_order = [&](ggml_tensor * t) {
+        t = ggml_reshape_3d(ctx0, t, t->ne[0], nb, block);
+        return ggml_reshape_2d(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, t, 0, 2, 1, 3)), t->ne[0], n_tokens);
+    };
+    res->t_h_nextn = block_order(states);
+    cb(res->t_h_nextn, "dspark_chain_state", -1);
+    ggml_build_forward_expand(gf, res->t_h_nextn);
+    logits = block_order(logits);
+    res->t_logits = ggml_cont(ctx0, ggml_view_2d(ctx0, logits, hparams.n_vocab_unpadded, n_tokens, logits->nb[1], 0));
+}
