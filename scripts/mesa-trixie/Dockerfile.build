# Build image matching the host (Debian 13 trixie, glibc 2.41): binaries built here run directly on the host with its Mesa.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends libvulkan-dev glslc glslang-tools glslang-dev spirv-headers spirv-tools cmake ninja-build g++ git ca-certificates libgomp1 libcurl4-openssl-dev python3 && rm -rf /var/lib/apt/lists/* && glslc --version | head -2 && cmake --version | head -1
